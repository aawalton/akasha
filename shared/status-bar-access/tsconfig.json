{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declarationDir": "dist",
    "lib": [
      "esnext"
    ],
    "types": [
      "@types/bun"
    ],
    "rootDir": "../..",
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/**/*.ts",
    "../../readouts/**/*.ts",
    "../../page/**/*.ts",
    "../../repo/**/*.ts",
    "../../day/**/*.ts",
    "../../agent/**/*.ts",
    "../../cache/**/*.ts",
    "../../checks-system/**/*.ts",
    "../../patches/**/*.ts",
    "../../during-call/**/*.ts",
