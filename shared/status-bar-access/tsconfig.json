  ],
  "references": [
    {
      "path": "../../alanwalton/personas-core"
    },
    {
      "path": "../pages-access"
    },
    {
      "path": "../supabase-auth"
    },
    {
      "path": "../../alanwalton/health-samples-access"
    },
    {
      "path": "../recurrence"
    },
    {
      "path": "../pages-query"
    }
