      "transparent": true,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "topk(15, max_over_time( sum by (namespace,workload)( sum by(namespace,pod)(rate(container_cpu_usage_seconds_total{container!=\"\",namespace=~\"$namespace\",kubernetes_io_hostname=~\"$node\"}[5m])) * on(namespace,pod) group_left(workload) group by (namespace,pod,workload)(label_replace(kube_pod_owner{owner_kind=\"ReplicaSet\"},\"workload\",\"$1\",\"owner_name\",\"(.+)-[a-z0-9]+$\") or label_replace(kube_pod_owner{owner_kind=\"Job\"},\"workload\",\"$1\",\"owner_name\",\"(.+)-[0-9]+$\") or label_replace(kube_pod_owner{owner_kind=~\"DaemonSet|StatefulSet|ReplicationController\"},\"workload\",\"$1\",\"owner_name\",\"(.+)\") or label_replace(kube_pod_owner{owner_kind=\"\"},\"workload\",\"$1\",\"pod\",\"(.+)\")) ) [7d:10m] ))",
          "refId": "A",
          "legendFormat": "peak \u00b7 {{workload}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (namespace,workload)( sum by(namespace,pod)(kube_pod_container_resource_requests{resource=\"cpu\",namespace=~\"$namespace\",node=~\"$node\"}) * on(namespace,pod) group_left(workload) group by (namespace,pod,workload)(label_replace(kube_pod_owner{owner_kind=\"ReplicaSet\"},\"workload\",\"$1\",\"owner_name\",\"(.+)-[a-z0-9]+$\") or label_replace(kube_pod_owner{owner_kind=\"Job\"},\"workload\",\"$1\",\"owner_name\",\"(.+)-[0-9]+$\") or label_replace(kube_pod_owner{owner_kind=~\"DaemonSet|StatefulSet|ReplicationController\"},\"workload\",\"$1\",\"owner_name\",\"(.+)\") or label_replace(kube_pod_owner{owner_kind=\"\"},\"workload\",\"$1\",\"pod\",\"(.+)\")) )",
          "refId": "B",
          "legendFormat": "request \u00b7 {{workload}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (namespace,workload)( sum by(namespace,pod)(kube_pod_container_resource_limits{resource=\"cpu\",namespace=~\"$namespace\",node=~\"$node\"}) * on(namespace,pod) group_left(workload) group by (namespace,pod,workload)(label_replace(kube_pod_owner{owner_kind=\"ReplicaSet\"},\"workload\",\"$1\",\"owner_name\",\"(.+)-[a-z0-9]+$\") or label_replace(kube_pod_owner{owner_kind=\"Job\"},\"workload\",\"$1\",\"owner_name\",\"(.+)-[0-9]+$\") or label_replace(kube_pod_owner{owner_kind=~\"DaemonSet|StatefulSet|ReplicationController\"},\"workload\",\"$1\",\"owner_name\",\"(.+)\") or label_replace(kube_pod_owner{owner_kind=\"\"},\"workload\",\"$1\",\"pod\",\"(.+)\")) )",
          "refId": "C",
          "legendFormat": "limit \u00b7 {{workload}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 8,
            "showPoints": "never",
            "lineWidth": 1
