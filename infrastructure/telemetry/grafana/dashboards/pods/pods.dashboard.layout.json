    {
      "id": 8,
      "type": "table",
      "title": "Problem pods",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "transparent": true,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(((kube_pod_status_ready{condition=\"true\",namespace=~\"$namespace\"}==0) and on(namespace,pod)(kube_pod_status_phase{phase=\"Running\"}==1) and on(namespace,pod)(time()-kube_pod_start_time>300)) or ((kube_pod_status_phase{phase=\"Pending\",namespace=~\"$namespace\"}==1) and on(namespace,pod)(time()-kube_pod_start_time>300)) or (kube_pod_status_phase{phase=~\"Failed|Unknown\",namespace=~\"$namespace\"}==1) or (kube_pod_container_status_waiting_reason{reason!~\"ContainerCreating|PodInitializing\",namespace=~\"$namespace\"}==1)) * on(namespace,pod) group_left(node) kube_pod_info{node=~\"$node\"}",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "uid": true,
              "endpoint": true,
              "service": true,
              "container": true,
              "condition": true
            },
            "indexByName": {
              "namespace": 0,
              "pod": 1,
              "node": 2,
              "phase": 3,
              "reason": 4
            }
          }
        }
      ]
    },
    {
      "id": 9,
      "type": "row",
      "title": "Consumption (live, per workload)",
