        "h": 1,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "panels": []
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "CPU by workload (top 15)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "transparent": true,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "topk(15, sum by (namespace,workload)( sum by(namespace,pod)(rate(container_cpu_usage_seconds_total{container!=\"\",namespace=~\"$namespace\",kubernetes_io_hostname=~\"$node\"}[5m])) * on(namespace,pod) group_left(workload) group by (namespace,pod,workload)(label_replace(kube_pod_owner{owner_kind=\"ReplicaSet\"},\"workload\",\"$1\",\"owner_name\",\"(.+)-[a-z0-9]+$\") or label_replace(kube_pod_owner{owner_kind=\"Job\"},\"workload\",\"$1\",\"owner_name\",\"(.+)-[0-9]+$\") or label_replace(kube_pod_owner{owner_kind=~\"DaemonSet|StatefulSet|ReplicationController\"},\"workload\",\"$1\",\"owner_name\",\"(.+)\") or label_replace(kube_pod_owner{owner_kind=\"\"},\"workload\",\"$1\",\"pod\",\"(.+)\")) ))",
          "refId": "A",
          "legendFormat": "{{workload}} \u00b7 {{namespace}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 8,
            "showPoints": "never",
            "lineWidth": 1
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
