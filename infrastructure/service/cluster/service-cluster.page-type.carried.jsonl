{"decisions":[{"decisionKind":"decision-kind/departure","statement":"A cluster service is one resource with a pod template."},{"decisionKind":"decision-kind/absence","statement":"The resource the cluster calls a Service is no cluster service."},{"decisionKind":"decision-kind/departure","statement":"A cluster service runs one copy unless the cluster service is spread across nodes on purpose."},{"decisionKind":"decision-kind/departure","statement":"A cluster service sits under the domain the cluster service serves."},{"decisionKind":"decision-kind/departure","statement":"A cluster service's page states the shape of the workload that cluster service is."},{"decisionKind":"decision-kind/departure","statement":"A cluster service states replicas only where its kind has replicas."},{"decisionKind":"decision-kind/departure","statement":"A cluster service states a container port only where its kind has a container port."},{"decisionKind":"decision-kind/departure","statement":"A cluster service the cluster starts on a schedule states that schedule."},{"decisionKind":"decision-kind/gap","statement":"The manifests a cluster service is applied as are emitted from its own page."},{"decisionKind":"decision-kind/departure","statement":"A cluster service names the manifest page emitting its resources."},{"decisionKind":"decision-kind/upkeep","statement":"Every cluster service runs as its page describes."}]}
