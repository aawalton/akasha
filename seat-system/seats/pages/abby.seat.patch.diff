+import type { AllAboutAlanTopic } from "../all-about-alan-topic.page-type.ts"
+
+export const theHarnessAroundMySafety = {
+  id: "01a0780b-3f5f-7ebc-9aa0-1fc4bc403b06",
+  pageTypeSlug: "all-about-alan-topic",
+  slug: "the-harness-around-my-safety",
+  title: "The Harness Around My Safety",
+  definition: "the interventions I built to raise my safety, and what each one reads",
+  parentSlugs: ["how-safety-climbs"],
+  relatedSlugs: ["how-i-get-anything-done"],
+  settled:
+    "I am building my harness out around safety as well, and the harness takes a different set of interventions from the ones executive function took.\n\nFour are visible to me so far. Changes flowing smoothly through akasha, read off whether my list of work is getting longer or shorter. My marriage being good, and more so getting better. The flow through my life going well, read off more green and blue stoplights. Banking surplus over time.\n\nAll four could be measured, and not all four are measured yet.\n\nSurplus is my stoplight, sleep hours less capacity hours spent. Above zero my baseline safety rises over time, and below zero my baseline safety falls.\n\nSocial lands on the spending side of that subtraction, so my lever is not spending.\n\nI hold a hypothesis that positive affordable social raises safety in its own right, perhaps as a reach of the marriage dimension, and perhaps even when the social is unaffordable, where the two forces pull opposite ways.",
+} as const satisfies AllAboutAlanTopic
