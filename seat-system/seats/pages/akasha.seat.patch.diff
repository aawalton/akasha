+++ b/domains/findings/pages/addon-git-ignore-duplicates-git-ignore.finding.ts
@@ -8,5 +8,5 @@ export const addonGitIgnoreDuplicatesGitIgnore = {
   claim:
     "Two `named-file-property` pages, `addon-git-ignore` and `git-ignore`, carry the same `propertySlug`, the same `definition` and the same `fileName`. Nothing tells the pages apart but their own slugs and their folders. `eso-addon` reaches for the first and `ios-app` for the second, and both resolve to a `.gitignore` beside the page. The duplicate wants deleting, and the surviving property wants a home outside `ios-app`, where any page type can reach it.",
   evidence:
-    '`akasha/code-system/eso-addon/properties/addon-git-ignore.named-file-property.ts` is 12 lines: `slug: "addon-git-ignore"`, `propertySlug: "git-ignore"`, `definition: "what a build leaves behind that git does not keep"`, `fileName: ".gitignore"`, id `01a06036-9b79-7b11-972f-655af36acfd5`.\n\n`akasha/code-system/ios-app/properties/git-ignore.named-file-property.ts` is the same 12 lines with `slug: "git-ignore"` and id `01a0591d-e23c-76ca-8764-552fd305e707`. Every other field matches character for character, exported type included, both being `"gitignore"`.\n\n`akasha/code-system/eso-addon/eso-addon.page-type.ts` names `named-file-property/addon-git-ignore` in `partSlugs` and `{ pagePropertySlug: "addon-git-ignore", required: false, many: false }` in `properties`. Nothing else in akasha imports either page.\n\nNothing breaks today. `filePropertiesAt` in `akasha/pages-system/indexes/index-entries/index-entries.module.code.ts` line 140 keys the file-property map by `propertySlug`, so both pages write `git-ignore` to `.gitignore` and the second write is the same as the first. The cost is the second page alone, plus a page type reaching for a slug that reads as its own property and is not.\n\nThe mend is two moves. Delete `addon-git-ignore` and point `eso-addon` at `named-file-property/git-ignore`. Then move `git-ignore` off `ios-app`, which owns it only because `ios-app` needed it first; `rust-crate` wants the same property and holds none, which `a-rust-crate-page-holds-no-git-ignore` already records.\n\nFound beside a defect that is already mended: those same two functions once keyed the map by the property\'s own slug while `pathsOf` looked it up by `propertySlug`, so a `.d.ts` answered that no page owned the file. Commit `2515f73823` fixed that, and no finding is filed for it.',
+    '`akasha/code-system/eso-addon/properties/addon-git-ignore.named-file-property.ts` is 12 lines: `slug: "addon-git-ignore"`, `propertySlug: "git-ignore"`, `definition: "what a build leaves behind that git does not keep"`, `fileName: ".gitignore"`, id `01a06036-9b79-7b11-972f-655af36acfd5`.\n\n`akasha/code-system/ios-app/properties/git-ignore.named-file-property.ts` is the same 12 lines with `slug: "git-ignore"` and id `01a0591d-e23c-76ca-8764-552fd305e707`. Every other field matches character for character, exported type included, both being `"gitignore"`.\n\n`akasha/code-system/eso-addon/eso-addon.page-type.ts` names `named-file-property/addon-git-ignore` in `partSlugs` and `{ pagePropertySlug: "named-file-property/addon-git-ignore", required: false, many: false }` in `properties`. Nothing else in akasha imports either page.\n\nNothing breaks today. `filePropertiesAt` in `akasha/pages-system/indexes/index-entries/index-entries.module.code.ts` line 140 keys the file-property map by `propertySlug`, so both pages write `git-ignore` to `.gitignore` and the second write is the same as the first. The cost is the second page alone, plus a page type reaching for a slug that reads as its own property and is not.\n\nThe mend is two moves. Delete `addon-git-ignore` and point `eso-addon` at `named-file-property/git-ignore`. Then move `git-ignore` off `ios-app`, which owns it only because `ios-app` needed it first; `rust-crate` wants the same property and holds none, which `a-rust-crate-page-holds-no-git-ignore` already records.\n\nFound beside a defect that is already mended: those same two functions once keyed the map by the property\'s own slug while `pathsOf` looked it up by `propertySlug`, so a `.d.ts` answered that no page owned the file. Commit `2515f73823` fixed that, and no finding is filed for it.',
 } as const satisfies Finding
