diff --git a/domains/findings/pages/addon-git-ignore-duplicates-git-ignore.finding.ts b/domains/findings/pages/addon-git-ignore-duplicates-git-ignore.finding.ts
index 4172e0142001846b123106b7c6ded6f9add8c260..2fef7d1d789ef098d8fda2e50fb7385097769bbb 100644
