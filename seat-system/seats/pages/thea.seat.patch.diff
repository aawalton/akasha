+      const held = new Set<string>(index.filesIn(folder))
+      for (const one of added.get(folder) ?? []) held.add(one)
+      for (const one of gone.get(folder) ?? []) held.delete(one)
+      const made = [...held].sort()
+      files.set(folder, made)
