-    if (kind === null) {
-      const named = typesAsked()
-      if ("unread" in named) {
-        refusals.push(named.unread)
-        continue
-      }
-      kind = kindOf(from, named.types)
-    }
-    if (kind !== "own") continue
-    for (const held of beside) {
-      if (seen.has(held)) continue
-      seen.add(held)
-      const name = basename(held)
