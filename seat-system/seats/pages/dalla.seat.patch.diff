-    try {
-      was = readFileSync(path, "utf8")
-    } catch (cause) {
-      unwritten.push({ path, why: whyOf(cause) })
-      continue
-    }
-    const text = resettledText(was, spelt, moved)
-    if (text === was) {
-      unchanged.push(path)
-      continue
-    }
-    if (!writing) {
-      rewritten.push(path)
-      continue
-    }
-    try {
-      writeFileSync(path, text)
-    } catch (cause) {
-      unwritten.push({ path, why: whyOf(cause) })
