-  const folder = dirname(given.at)
-  if (!ownsIn(root, held, given.at, beside)) return join(folder, name)
-  return join(
-    dirname(folder),
-    folderFor(pluralIn(root, held, textOf), held.pageTypeSlug, given.to),
-    name
-  )
-}
