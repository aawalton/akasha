+import type { Finding } from "../finding.page-type.ts"
+
+export const aFreshIndexRebuildDropsTheEdgesItCannotYetResolve = {
+  id: "01a07381-d370-7f4d-a1bc-02b2414d06fa",
+  pageTypeSlug: "finding",
+  slug: "a-fresh-index-rebuild-drops-the-edges-it-cannot-yet-resolve",
+  domainSlug: "workspace-package/index",
+  claim:
+    "A rebuild from the pages files fewer relation edges than the incremental write it is meant to agree with. `rebuiltFrom` reconciles `relation/` before `value/`, and resolving a qualified address needs the page-type values that `value/` holds, so on an index carrying no `value/` yet every qualified address is refused and its edge is dropped. Running the rebuild a second time files them, which is what makes the fault look intermittent rather than ordered.",
+  evidence:
+    '`pages/indexes/indexing/indexing.module.code.ts` reconciles in this order: `identity`, `path`, `schema`, then `const known = knownIn(readingAt(root), ...)` followed by `relation`, then `import`, and `value` last. `knownIn` at `pages/indexes/reaching/reaching.module.code.ts:63` builds its map from `schemaAt(reading)`, which is filed by that point, but the type descent it needs to resolve a qualified address is read from the page-type values, which are not.\n\n`akasha test --file-path pages/indexes/indexing --named "a rebuild from the pages agrees with the index a write left"` fails at `indexing.module.test.ts:283`, expecting 4 lines and receiving 0. The line it does not file is `/relation/page/id/01a04a4a-0000-7000-8000-00000000000b/part-slugs/01a04a4a-0000-7000-8000-00000000000a.jsonl` — a `part-slugs` edge, which is exactly a qualified address. I ran that test and read that diff.\n\nIt surfaced while building `rename-slug`, whose fixture had to call `rebuiltWhole` twice before any relation edge appeared; the second call reported the edge as freshly added to a repo the first had left with no `relation/` folder at all. The failure is older than that work: the agent that found it attributed it by revert-test rather than by plausibility, and the same named test fails at `f5127d6071`.\n\nThis matters beyond one test. Every atomic change built for the refactor commands asks the index what a subject reaches and refuses rather than narrowing, on the strength of Trust The Index. An index that files an edge only on a second rebuild answers a smaller reach without refusing, which is the one failure those changes are built to make impossible.',
+} as const satisfies Finding
