-    if (ts.isPropertyAssignment(node)) {
-      const key = keyOf(node)
-      if (key !== null && slugs.has(slugFor(key))) {
-        found.push(...valuedIn(source, node.initializer, one))
-      }
-    }
-    ts.forEachChild(node, walk)
-  }
-  ts.forEachChild(source, walk)
-  return found
-}
