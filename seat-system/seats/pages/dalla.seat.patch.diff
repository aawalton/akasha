+import type { ChangeMechanical } from "../../mechanical/change-mechanical.page-type.ts"
+
+export const changeFile = {
+  id: "01a07810-fb33-7e75-8e1e-ce1e302d5668",
+  pageTypeSlug: "change-mechanical",
+  slug: "change-file",
