-  if (was === now) return { refused: `\`${was}\` is the name it already carries` }
-  let atWas: string | null = null
-  let atNow: string | null = null
-  for (const [path, name] of named) {
-    if (name === was) atWas = path
-    if (name === now) atNow = path
