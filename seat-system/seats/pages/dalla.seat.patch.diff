-})
-
-function worldIn(root: string): World {
-  return worldAt(root, textIn(root))
-}
-
-function keptRepo(): string {
-  return indexedRepo({
-    ...SPARE,
-    [`akasha/${NOTES[0]}`]: bodyOf(NOTES[1]),
-    [KEPT_TYPE]: bodyOf({
-      id: idOf("e"),
-      pageTypeSlug: "page-type",
-      slug: "kept",
-      extendsSlug: ["page-type/page"],
-      properties: [
