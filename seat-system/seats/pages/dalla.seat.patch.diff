-+    run,
-+    acceptsAbsent,
-+    parse(value) {
-+      const outcome = run(value, [])
-+      if (outcome.ok) return outcome.value
-+      throw new ShapeError(outcome.issues)
-+    },
-+    safeParse(value) {
-+      const outcome = run(value, [])
-+      return outcome.ok
-+        ? { success: true, data: outcome.value }
-+        : { success: false, error: new ShapeError(outcome.issues) }
-+    },
-+    optional() {
