-+      )
-+    }
-+    byTag.set(marker.value, member)
-+  }
-+  const expected = [...byTag.keys()].map((tag) => `'${tag}'`).join(" | ")
-+
-+  return Shape((value, path) => {
-+    if (!isObjectLike(value)) {
-+      return refused(
-+        path,
-+        "invalid_type",
-+        `Invalid input: expected object, received ${received(value)}`
-+      )
-+    }
