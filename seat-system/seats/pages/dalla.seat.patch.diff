-  const type = filed[0]
-  if (type === undefined) return { refused: `no page type carries the slug \`${now}\`` }
-  if (filed.length > 1) return { refused: `${filed.length} page types carry the slug \`${now}\`` }
-  const value = pageOf(one.path)
-  if (value === null) {
