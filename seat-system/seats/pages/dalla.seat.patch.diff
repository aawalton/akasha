-+export const held = <T>(value: T): Outcome<T> => ({ ok: true, value })
-+
-+export const refused = (path: ShapePath, code: string, message: string): Outcome<never> => ({
-+  ok: false,
-+  issues: [{ code, path, message }],
-+})
