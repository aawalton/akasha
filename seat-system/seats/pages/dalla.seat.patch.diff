-const OLD_FILE = "--old-file"
-
-const NEW_FILE = "--new-file"
-
-const VALUED = [FILE_PATH, OLD_FILE, NEW_FILE, REMOVE, MESSAGE, MESSAGE_FILE, BREAK_GLASS]
-
-const BARE: readonly string[] = [RESTATED]
-
-type Stated = {
-  readonly old: string
-  readonly put: string
