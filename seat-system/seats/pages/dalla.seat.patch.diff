-        refusals.push(`${there} already stands, and the sidecar ${held} goes with what you named`)
-        continue
-      }
-      taken.add(there)
-      sides.push({
-        from: held,
-        to: there,
-        named: false,
-        committed: !uncommittedHeld(held),
-        renaming,
-      })
-    }
-  }
-  if (refusals.length > 0) return { refusals }
-  return { sides }
-}
