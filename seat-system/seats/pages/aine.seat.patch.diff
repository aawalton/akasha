-    return { namers: world.index.namersOf(id), slugs: world.index.slugsOfType(pageTypeSlug) }
-  } catch (cause) {
-    const why = cause instanceof Error ? cause.message : String(cause)
-    return { unread: `${why}, so no slug was restated` }
