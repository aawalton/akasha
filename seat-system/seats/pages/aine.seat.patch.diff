+        reached = at
+        return Promise.resolve(NOTHING_OVER)
+      },
+    },
+    { at: "changes/one.module.ts" }
+  )
+
+  expect(reached).toBe("change-mechanical-file/remove-file-page")
+  expect(said.refused).toBeNull()
+})
