+
+  const said = await changePagePropertyRelation(world, { ...ASKED, to: "initiative/nope" })
+
+  expect(said.edits).toEqual([])
+  expect(said.refused ?? "").toBe(
+    "`assignmentSlug` names a relation, and no `initiative` carries the slug `nope`"
+  )
+})
