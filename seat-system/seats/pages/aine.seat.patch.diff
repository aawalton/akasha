-import type { Finding } from "../finding.page-type.ts"
-
-export const theMarkdownUncommittedStoreRefusesAnAkashaPageForAFalseReason = {
-  id: "01a060be-c946-7000-bd83-c2b0e1427c09",
-  pageTypeSlug: "finding",
-  slug: "the-markdown-uncommitted-store-refuses-an-akasha-page-for-a-false-reason",
-  domainSlug: "domain/akasha",
-  claim:
-    "`uncommittedPathFor` in akasha/markdown-pages/markdown-uncommitted/markdown-uncommitted.module.code.ts:18-23 refuses a `.ts` path saying it is not a page. The refusal is right and the reason is false: it is a page, and this is the markdown store alone. Copying the repair `ecd965656f` made to the identical shape in akasha/markdown-pages/markdown-attachment-file/markdown-attachment-file.module.code.ts would answer `.uncommitted.yaml` for a day that has moved, and write a file akasha does not read beside all 133 of them.",
-  evidence:
-    'Measured 2026-09-02 by running. `uncommittedPathFor` answers a `.uncommitted.yaml` path for a markdown page and throws for `akasha/alan/wake-day/daily-trackings/day-2026-03-05.wake-day.ts` and for every other akasha page. It is character-for-character the gate repaired in akasha/markdown-pages/markdown-attachment-file/markdown-attachment-file.module.code.ts, so it reads as the next one to repair the same way.\n\nIt is not. `uncommittedAt` in akasha/pages-system/page/page-file-name/page-file-name.module.code.ts:99-101 is `besideAt(path, "uncommitted", "ts")`, so an akasha page\'s uncommitted values are named `.uncommitted.ts`. A whole second store already reads and writes them: `uncommittedIn`, `keepUncommitted`, `mergeUncommitted`, `dropUncommitted` and `removeUncommitted` in page-uncommitted.module.code.ts. 69 `.uncommitted.ts` files are on disk under akasha/ today.\n\nSo there are two stores for two file kinds, both correct, and the markdown one is right to refuse what is not its own. Only the wording misleads the next reader into a repair that would put a yaml file beside every day which nothing reads and nothing removes.\n\nThe call taken: left unchanged, wording and all. The file is in the import closure tools/service-wrapper.ts follows for seven daemons, one of them surplus-fall-notifier, and saving it restarts them. A restart of that daemon sent a real push to three devices earlier in this same session. Correcting a message is not worth that, and it is not urgent: the throw already keeps a day safe. Worth doing in a lane that can take the daemons down first.',
-} as const satisfies Finding
