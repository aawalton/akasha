+  expect(said.edits.find((one) => one.path === NAMER_CODE)?.body).toBe(
+    `import { ${CARRIED} } from "../one/held.module.code.ts"\n\nexport const named = ${CARRIED} + 1\n`
+  )
+})
+
+test("each body is answered beside the body it was worked out from", () => {
