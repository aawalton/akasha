-function namedOf(node: ts.Node): ts.Node | null {
-  if (ts.isFunctionDeclaration(node)) return node.name ?? null
-  if (ts.isTypeAliasDeclaration(node) || ts.isInterfaceDeclaration(node)) return node.name
