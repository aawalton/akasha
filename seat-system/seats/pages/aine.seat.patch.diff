diff --git a/alan/books/my-projects/sections/second-passport/other/residency/other-residency-liechtenstein.book-section.chapter-text.md b/alan/books/my-projects/sections/second-passport/other/residency/other-residency-liechtenstein.book-section.chapter-text.md
