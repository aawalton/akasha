+
+const PAGE = { id: ID, pageTypeSlug: "seat", slug: "held" } as Value
+
+function carrying(key: string, pageTypeSlug: string): Carried {
+  return {
+    pagePropertySlug: key,
+    pageTypeSlug,
+    propertySlug: key,
+    key,
+    unique: null,
+    declaredBy: "seat",
+    required: false,
+    many: false,
+    maxCount: null,
+    maxLength: null,
+    uncommitted: false,
+    secret: false,
