+                spec: {
+                  restartPolicy: "Never",
+                  runtimeClassName: "nvidia",
+                  nodeSelector: gpuVramUsableMinSelector("8gi"),
+                  securityContext: { seccompProfile: { type: "RuntimeDefault" } },
+                  containers: [
+                    {
+                      name: "bench",
