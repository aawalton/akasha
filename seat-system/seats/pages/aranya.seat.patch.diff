+      accessModes: ["ReadWriteOnce"],
+      storageClassName: "",
+      volumeName: "prometheus-data",
+      resources: { requests: { storage: "200Gi" } },
+    },
+  })
+}
+
+export function prometheusServiceYaml(): string {
+  return synthOne(NAMESPACE, "prometheus-service", {
+    apiVersion: "v1",
+    kind: "Service",
+    metadata: {
+      name: "prometheus",
+      namespace: NAMESPACE,
+      labels: PROMETHEUS_LABELS,
