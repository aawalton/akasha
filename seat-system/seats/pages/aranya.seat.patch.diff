+  ALERTMANAGER_IMAGE,
+  BUSYBOX_IMAGE,
+  NAMESPACE,
+  PROMETHEUS_IMAGE,
+  PROMETHEUS_LABELS,
+  PROMETHEUS_SELECTOR_LABELS,
