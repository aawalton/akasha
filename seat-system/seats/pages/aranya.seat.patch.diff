+import { synthMulti } from "@akasha/k8s-types/cdk8s-synth"
+import { workloadClassMemberSelector } from "@akasha/k8s-types/hostnames"
+import {
+  APP_NAME,
+  INSTANCE_NAME,
+  MANAGED_BY,
+  NAMESPACE,
+  PART_OF,
