diff --git a/infrastructure/cluster/k8s-types/k8s-manifest-scanner/k8s-manifest-scanner.module.code.ts b/infrastructure/cluster/k8s-types/k8s-manifest-scanner/k8s-manifest-scanner.module.code.ts
