+        },
+        data: {
+          compression: "gzip",
+          immediateCheckpoint: true,
+          jobs: 1,
+          additionalCommandArgs: ["--min-chunk-size=5MB", "--max-archive-size=5GB"],
+        },
+        wal: { compression: "gzip" },
+      },
+      retentionPolicy: "7d",
+    },
+  })
+}
