-export function findRepoRoot(start: string): string {
-  let dir = start
-  for (;;) {
-    if (existsSync(join(dir, "bun.lock"))) return dir
-    const parent = join(dir, "..")
-    if (parent === dir) throw new Error(`could not find repo root (no bun.lock) above ${start}`)
-    dir = parent
-  }
-}
