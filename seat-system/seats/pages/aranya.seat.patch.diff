 TUNNEL_CONFIG="${AKASHA_ROOT}/service-system/cluster-services/pages/cloudflared/config-header.yaml"
 
 if ! command -v cloudflared &>/dev/null; then
@@ -45,8 +46,8 @@ if [[ ! -f "${CLOUDFLARED_DIR}/cert.pem" ]]; then
   die "No cert.pem found at ${CLOUDFLARED_DIR}/cert.pem — run: cloudflared tunnel login"
 fi
 
