+const GC_FULL_LABELS = {
+  "app.kubernetes.io/name": APP_NAME,
+  "app.kubernetes.io/instance": INSTANCE_NAME,
+  "app.kubernetes.io/component": "gc",
+  "app.kubernetes.io/part-of": PART_OF,
