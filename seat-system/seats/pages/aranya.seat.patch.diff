-OUT_HOST="$OUT_DIR/$OUT_NAME"
-rm -f "$OUT_HOST"
-echo "==> SeedVR2 v2.5: $IN_NAME -> $OUT_NAME (short-side ${RESOLUTION}px, seed ${SEED}, bts=${BLOCKS_TO_SWAP})"
-T0=$(date +%s.%N)
