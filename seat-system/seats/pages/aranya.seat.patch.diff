+    expect(seen.has(at)).toBe(false)
+    seen.add(at)
+  }
+})
+
+test("finding no profile source refuses rather than reading nothing granted", async () => {
+  expect(profileSources("/nonexistent-checkout-root")).rejects.toThrow(/no RBAC profile source/)
+})
