-PY
-
-export HF_HUB_DISABLE_XET=1
-python - "$MODEL_DIR" "$DIT_MODEL" "$VAE_MODEL" <<'PY' || { echo "FATAL: HF weight provision failed"; exit 1; }
-import os, sys, shutil
