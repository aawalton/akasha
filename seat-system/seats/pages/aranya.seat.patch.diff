 } from "./subagent-presence.module.code.ts"
 import {
@@ -385,3 +390,75 @@ test("a write that landed leaves no reason in the log", async () => {
     world.sweep()
   }
 }, 40000)
+
+const GOING: Went = { went: true }
+
+const LOCKED: Went = {
+  why: "another landing has held `.git/akasha-landing.lock` for longer than 120s",
+}
+
+const REFUSED: Went = { why: "no assignment is stated for the akasha seat" }
+
+test("a refusal naming a held lock is worth asking again and every other refusal is not", () => {
+  expect(worthAnotherTry("why" in LOCKED ? LOCKED.why : "")).toBe(true)
+  expect(worthAnotherTry("why" in REFUSED ? REFUSED.why : "")).toBe(false)
+})
+
+test("a landing refused for a held lock is asked for again until that landing goes", async () => {
+  let asked = 0
+  const waits: number[] = []
+  const went = await landingAgain(
+    () => {
+      asked += 1
+      return Promise.resolve(asked < 3 ? LOCKED : GOING)
+    },
+    (ms) => {
+      waits.push(ms)
+      return Promise.resolve()
+    }
+  )
+  expect(went).toEqual(GOING)
+  expect(asked).toBe(3)
+  expect(waits).toEqual([WAIT_MS, WAIT_MS])
+})
+
+test("a landing refused for a held lock every time is asked for five times and no more", async () => {
+  let asked = 0
+  const went = await landingAgain(
+    () => {
+      asked += 1
+      return Promise.resolve(LOCKED)
+    },
+    () => Promise.resolve()
+  )
+  expect(asked).toBe(TRIES)
+  expect(went).toEqual(LOCKED)
+})
+
+test("a refusal naming no held lock is answered at once and waits for nothing", async () => {
+  let asked = 0
+  let waited = 0
+  const went = await landingAgain(
+    () => {
+      asked += 1
+      return Promise.resolve(REFUSED)
+    },
+    () => {
+      waited += 1
+      return Promise.resolve()
+    }
+  )
+  expect(asked).toBe(1)
+  expect(waited).toBe(0)
+  expect(went).toEqual(REFUSED)
+})
+
+test("a landing that goes at once is asked for once", async () => {
+  let asked = 0
+  const went = await landingAgain(() => {
+    asked += 1
+    return Promise.resolve(GOING)
+  })
+  expect(asked).toBe(1)
+  expect(went).toEqual(GOING)
+})
