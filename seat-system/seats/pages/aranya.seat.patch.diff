-  if (mapping === undefined) return null
-  const inlineName = rest.join("/")
-  const resourceName = inlineName !== "" ? inlineName : plainToken(nameToken)
-  if (resourceName === undefined) return { ...mapping }
-  return { ...mapping, resourceName }
-}
