+                      imagePullPolicy: "Always",
+                      command: ["bash", "/runner/bench-runner.sh"],
+                      env: [
+                        { name: "HOME", value: "/tmp" },
+                        { name: "SEAWEEDFS_S3_ENDPOINT", value: S3_ENDPOINT },
+                        {
