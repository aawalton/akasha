-    DISTILLED
-  ),
-  "juggernaut-z-v1": zImage("juggernaut-z-v1", "juggernaut-z-v1_fp8.safetensors", DISTILLED),
-
-  "redzdpo-v5-veris": zImage("redzdpo-v5-veris", "redzdpo-v5-veris_fp8.safetensors", DISTILLED),
-
-  "twinflow-z-image-turbo": zImage(
