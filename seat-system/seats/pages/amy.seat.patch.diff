+function rowFor(slug: string | null): Parameters<typeof withDefinitions>[0][number] {
+  return {
+    id: slug ?? "none",
+    page_type_id: "one",
+    seq: null,
+    title: null,
+    icon: null,
+    attributes: { pluralSlug: "to-dos" },
+    page_type_slug: "page-type",
+    unique_key: null,
