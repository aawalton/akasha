-export function taken(argv: readonly string[]): Reading {
-  const held = new Map<string, string>()
-  const bare = new Set<string>()
-  let at = 0
-  while (at < argv.length) {
-    const one = argv[at] as string
-    at += 1
-    if (BARE.includes(one)) {
-      bare.add(one)
-      continue
-    }
-    if (!one.startsWith("-")) {
-      return {
