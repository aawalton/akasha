+// A COMPARISON TAKING ONE VALUE IS GIVEN THE FIRST OF THEM. A narrow always carries a list, and
+// `in` and `not-in` weigh the whole list where every other comparison weighs one value, so handing
+// the list to those would test a page against an array it can never equal.
+const OVER_THE_WHOLE_LIST: ReadonlySet<string> = new Set(["in", "not-in"])
+
+function filtersFromNarrows(raw: unknown): readonly ViewFilter[] | undefined {
+  if (!Array.isArray(raw)) return undefined
+  const out: ViewFilter[] = []
+  for (const one of raw) {
+    if (!isRecord(one)) continue
+    const key = textOf(one.key)
+    const comparison = textOf(one.comparison)
+    if (key === undefined || comparison === undefined) continue
+    const values = Array.isArray(one.values) ? one.values : [one.values]
+    out.push(
+      ...filtersForKey(key, {
+        [comparison]: OVER_THE_WHOLE_LIST.has(comparison) ? values : values[0],
+      })
+    )
+  }
+  return out.length > 0 ? out : undefined
+}
+
+function sortsFromViewSorts(raw: unknown): readonly ViewSort[] | undefined {
+  if (!Array.isArray(raw)) return undefined
+  const out: ViewSort[] = []
+  for (const one of raw) {
+    if (!isRecord(one)) continue
+    const key = textOf(one.key)
+    if (key === undefined) continue
+    out.push({
+      field: camelizeKey(key),
+      direction: asBoolean(one.descending) === true ? "desc" : "asc",
+    })
+  }
+  return out.length > 0 ? out : undefined
+}
