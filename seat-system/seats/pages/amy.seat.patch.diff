 import { answerPageWrite } from "../.server/alan-answer-page-write/alan-answer-page-write.module.code.ts"
+import {
+  capacitorCorsHeaders,
+  corsAnswered,
+  corsPreflight,
+} from "../capacitor-cors/capacitor-cors.module.code.ts"
 import type { Route } from "./+types/api.page-write"
 
-// `action` is this module's only export on purpose. React Router strips just
-// `loader`, `action`, `middleware` and `headers`; anything else exported here
-// would hold `answer-page-write.server` — and the server client it reaches —
-// into the client bundle.
+const WRITE_METHODS = "POST, OPTIONS"
+
+export function loader({ request }: Route.LoaderArgs): Response {
+  if (request.method !== "OPTIONS") return new Response(null, { status: 405 })
+  return corsPreflight(capacitorCorsHeaders(request, WRITE_METHODS))
+}
