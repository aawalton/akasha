+const DECLARED_BY = "-property"
+
+// A DEFINITION'S TYPE IS HOW A VALUE IS RENDERED RATHER THAN THE PAGE TYPE DECLARING IT. A property
+// page's own page type is `select-property`, and every reader of a definition — the badge on a card,
+// the table coercing a stored value, the filter weighing a date — spells that kind `select`, so
+// carrying the declaring slug through leaves every one of them matching nothing.
+export function renderedType(pageTypeSlug: string): string {
+  if (!pageTypeSlug.endsWith(DECLARED_BY)) return pageTypeSlug
+  return pageTypeSlug.slice(0, -DECLARED_BY.length)
+}
