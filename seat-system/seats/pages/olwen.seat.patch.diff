-      const value = argv[at + 1]
-      at += 1
-      if (value === undefined || value.startsWith("-")) {
-        refusals.push(`\`${one}\` names a value, and none followed it`)
-        continue
-      }
-      said.set(one === TAIL ? LIMIT : one, value)
-      continue
-    }
-    if (one === ALL) {
-      all = true
-      continue
-    }
-    if (one.startsWith("-")) {
-      refusals.push(
