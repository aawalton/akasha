-      continue
-    }
-    if (!VALUED.includes(token)) {
-      return {
-        refused: `\`${token}\` is not a flag this takes — a move names its sides as \`${FROM} <path> ${TO} <path>\``,
-      }
-    }
-    const value = argv[at + 1]
