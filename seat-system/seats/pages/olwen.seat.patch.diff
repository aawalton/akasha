-  try {
-    const colors = "states" in read ? colorsOfStates(read.states) : colorsOf(read.agents)
-    return { report: [colorsSaid(colors)], refusals: [], code: 0 }
-  } catch (thrown) {
-    return { report: [], refusals: [whyOf(thrown)], code: 3 }
-  }
-}
