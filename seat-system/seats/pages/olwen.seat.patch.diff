+  gitSaid(root, ["init", "-q", "-b", "main", "."])
+  await writing(root, ONE, WAS)
+  gitSaid(root, ["add", "--", ONE])
+  gitSaid(root, [...WHO, "commit", "-q", "-m", "base", "--", ONE])
