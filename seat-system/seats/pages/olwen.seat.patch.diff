-  if (lines.length === 0) return [SAID_NOTHING]
-  const kept: string[] = []
-  let bytes = 0
-  for (let at = 0; at < lines.length; at += 1) {
-    const line = lines[at] ?? ""
-    const size = new TextEncoder().encode(line).length + 1
-    if (kept.length >= DETAIL_LINES || bytes + size > DETAIL_BYTES) break
-    kept.push(line)
-    bytes += size
-  }
-  if (kept.length === 0) return [SAID_NOTHING]
-  return ["what the runner said:", ...kept.map((one) => `  ${one}`)]
-}
-
-function reportOf(
-  verdict: Verdict,
-  said: Summary,
-  output: string,
-  named: boolean
