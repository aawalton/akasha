+function thingPage(slug: string, said: string, names: string | null): string {
+  const held = names === null ? "" : `\n  names: [${names}],`
+  return `export const ${slug} = {\n  id: "${said}",\n  pageTypeSlug: "thing",\n  slug: "${slug}",${held}\n}\n`
+}
