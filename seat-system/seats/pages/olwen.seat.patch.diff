-  const found: Carry[] = [{ from: one.path, to: join(dir, `${now}${TS}`) }]
-  for (const path of besideOf(root, one.path)) {
-    const name = basename(path)
-    found.push({ from: path, to: join(dir, `${now}${name.slice(was.length)}`) })
-  }
-  return found
-}
