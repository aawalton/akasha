-  let contextBytes: Uint8Array
-  try {
-    contextBytes = await readFile(contextPath)
-  } catch (thrown) {
-    return refused(
-      `\`--context\` names \`${contextPath}\`, which would not be read — ${whyOf(thrown)}`,
-      2
-    )
-  }
-
