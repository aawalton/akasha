-  const glass = glassIn(argv, flags)
-  if ("refusals" in glass) return answering([], glass.refusals, 1)
-  const asked = messageIn(argv, flags)
-  if ("refusals" in asked) return answering([], asked.refusals, 1)
-  const base = baseOf(root)
