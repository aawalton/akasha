-      Bun.sleepSync(ASKED_AGAIN_IN)
-      continue
-    }
-    if (read === 0) return { bytes: wholeOf(held) }
-    held.push(buffer.slice(0, read))
-    quietBy = Date.now() + QUIET_FOR
-  }
-}
