+  )
+  expect(said.code).toBe(0)
+  expect(bodyOf(root, "akasha/one.ts")).toBe("held\nabc\n")
+})
+
+test("one path named more than once by a call is refused", async () => {
+  const root = repoWith({ "akasha/one.ts": "alpha\n" })
