diff --git a/domains/findings/pages/a-drafted-removal-of-an-untracked-path-reports-success-and-takes-nothing-away.finding.ts b/domains/findings/pages/a-drafted-removal-of-an-untracked-path-reports-success-and-takes-nothing-away.finding.ts
