+
+function givenIn(): Given {
+  return { root: ROOT, calledAs: "akasha page-tree", from: ROOT, writer: null, agentId: null }
+}
+
+const TYPES: readonly Valued[] = [
+  {
+    path: "one/thing.page-type.ts",
+    value: {
+      slug: "thing",
