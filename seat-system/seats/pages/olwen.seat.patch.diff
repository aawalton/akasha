-  const landing = await landedMechanically(
-    root,
-    given.calledAs,
-    editsFor(said, [...said.keys()].sort()),
-    `rename the package \`${one.was}\` to \`${one.now}\` and alias the old name`,
-    [],
-    given.agentId
-  )
