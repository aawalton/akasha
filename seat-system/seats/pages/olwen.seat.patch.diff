-
-const FILE_PATH = "--file-path"
-
-const NAMED = "--named"
-
-const WHOLE = "."
-
-export const ANSWER_CEILING = 28000
-
-type Meant = {
-  readonly paths: readonly string[]
-  readonly name: string | null
-  readonly refusal: string | null
-}
-
-type Aimed = {
-  readonly named: readonly string[]
