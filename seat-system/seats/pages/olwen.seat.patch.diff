-
-const PROPERTY_ROOT = "page-property"
-
-const PAGE_TYPE = "page-type"
-
-const ON_TYPE = "page-type"
-
-const ON_PROPERTY_TYPE = "page-property-type"
-
-const NO_PARENT = null
