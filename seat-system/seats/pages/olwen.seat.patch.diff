-    pod,
-    namespace,
-    since,
-    limit,
-    cursor: said.get(CURSOR) ?? null,
-    all,
-    commitSha,
-    inputsHash,
-  }
-}
-
-async function boundingLine(
-  read: Exclude<Read, { refused: readonly string[] }>,
-  lines: readonly LogEntry[],
-  isDone: boolean,
-  cursor: string | null
