-  const one = passages.passages[0]
-  if (passages.passages.length !== 1 || one === undefined) {
-    return {
-      refusals: [
-        `${PIPED} carries ${counted(passages.passages.length, "marker block")}, and ${ONE_PASSAGE}`,
-      ],
-    }
-  }
-  return { passage: one }
