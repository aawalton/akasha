-    return {
-      refused:
-        `\`${named}\` names no page type — one slug is carried under many page types, so a ` +
-        "retype takes the page type and the slug parted by `/`",
-    }
-  }
-  const was = address.pageTypeSlug
-  const slug = address.slug
