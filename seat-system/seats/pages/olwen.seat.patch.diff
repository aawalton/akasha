-export function inheritedOut(ppid: number): Opening | null {
-  try {
-    return statSync(`/proc/${ppid}/fd/1`)
-  } catch {
-    return null
-  }
-}
-
-export function discarded(): Discard | null {
-  try {
-    return discardedBy(fstatSync(1), inheritedOut(process.ppid), statSync("/dev/null"))
-  } catch {
-    return null
-  }
-}
