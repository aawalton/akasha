-export function columnsOf(rows: readonly (readonly string[])[]): readonly string[] {
-  const widths = widthsOf(rows)
-  return rows.map((one) =>
-    one
-      .map((said, at) => (at === 0 ? said.padEnd(widths[at] ?? 0) : said.padStart(widths[at] ?? 0)))
-      .join(GAP)
-      .trimEnd()
-  )
-}
