+    [ALPHA]: thingPage("alpha", idOf("11"), names),
+    [BETA]: thingPage("beta", idOf("12"), '"held"'),
+    [GAMMA]: thingPage("gamma", idOf("13"), '"thing/alpha"'),
+  })
+  rebuilt(root)
+  for (const slug of ["relation-resolves", "page-named-as-stated"]) judging(root, slug)
+  admitting(root)
+  return root
