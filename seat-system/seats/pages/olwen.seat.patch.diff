-  const { pod, namespace, since, limit, commitSha, inputsHash } = read
-  const older = isDone
-    ? await hasLinesBeforeWindow({ pod, namespace, since, commitSha, inputsHash })
-    : null
-  const elsewhere =
-    lines.length === 0
-      ? (await findPodNamespaces({ pod, since })).filter((one) => one !== namespace)
