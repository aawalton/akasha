-  [EXTEND]: new Map<string, Shape>([
-    ["--context", "token"],
-    ["--direction", "token"],
-    ["--prompt", "prose"],
-    ["--negative-prompt", "prose"],
-    ["--context-frames", "token"],
-    ["--new-frames", "token"],
-    ["--seed", "token"],
-    ["--steps", "token"],
-    ["--lightning", "switch"],
-    ["--size", "token"],
