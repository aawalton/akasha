-    const run = await runComfyGraph({
-      baseUrl,
-      buildGraph: () =>
-        buildExtendGraph({
-          contextVideoName: resolveComfyInputName(contextName),
-          direction,
-          skipFirstFrames: skip,
-          contextFrames,
-          length,
-          prompt,
-          negativePrompt: negative,
-          width,
-          height,
-          seed,
-          steps,
-          lightning,
-          filenamePrefix: "extend",
-        }),
-      pollDeadlineMs: waiting,
-      onProgress: (one: string) => {
-        report.push(one)
