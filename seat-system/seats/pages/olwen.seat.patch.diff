+import { readingIn, recordRead } from "../../reading/reading.module.code.ts"
+import { namedIn, remove } from "./remove.command.code.ts"
+import {
+  AGENT,
+  BESIDE,
+  BODY,
+  DANGLING,
+  DEEP,
+  deepWorld,
+  emptyIn,
+  GLASSED,
+  GONE,
+  git,
+  givenIn,
+  HELD,
+  head,
