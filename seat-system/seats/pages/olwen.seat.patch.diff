-export function removingIn(
-  given: Given,
-  removals: readonly string[],
-  seen: Set<string>,
-  both: (path: string) => string
-): Removing {
-  const base = removals.length === 0 ? null : baseOf(given.root)
-  const changes: FileEdit[] = []
-  const taken: string[] = []
-  const mistaken: string[] = []
-  const wrong: string[] = []
