-  const endPath = endSaid === undefined ? undefined : at(given, endSaid)
-  const prompt = said.get("--prompt") ?? ""
-  const negative = said.get("--negative-prompt") ?? WAN_DEFAULT_NEGATIVE_PROMPT
-  const lightning = read.on.has("--lightning")
