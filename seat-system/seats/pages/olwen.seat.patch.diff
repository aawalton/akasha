-export async function generating(
-  read: Taken,
-  given: Given,
-  argv: readonly string[],
-  report: string[]
-): Promise<Answer> {
-  const said = read.said
-  const startSaid = said.get("--start-image")
-  const endSaid = said.get("--end-image")
-  if (startSaid === undefined && endSaid === undefined) {
