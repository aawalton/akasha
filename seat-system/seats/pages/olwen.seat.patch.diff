-  if (path === null) return { why: offRepo(said) }
-  const barred = barredIn(root, path)
-  if (barred !== null) return { why: barred }
-  if (seen.has(path)) return { why: `${path} is named more than once by one call` }
-  seen.add(path)
-  return path
