-  const held: Target[] = []
-  for (const at of warrantedIn(root, [...said.keys()])) {
-    const absolute = join(root, at)
-    if (absolute !== root && !absolute.startsWith(`${root}/`)) continue
-    held.push({ named: said.get(at) ?? at, absolute })
-  }
-  return held
-}
