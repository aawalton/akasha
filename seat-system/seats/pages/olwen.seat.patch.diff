-  if ("refused" in read) return { report: [], refusals: read.refused, code: 1 }
-  try {
-    return said(resolve(given.root), read.shown)
-  } catch (thrown) {
-    return { report: [], refusals: [whyOf(thrown)], code: 3 }
-  }
-}
