-    root: stated === undefined || stated === "" ? rootOf(import.meta.path) : resolve(stated),
-    calledAs: "akasha domain-tree",
-    from: process.cwd(),
-    writer: said === undefined || said === "" ? AUTHOR : said,
-    agentId: writerIn(process.env),
