-
-const NEEDED: { readonly [A in Act]: readonly string[] } = {
-  [GENERATE]: ["--prompt"],
-  [EXTEND]: ["--context", "--direction", "--prompt"],
-  [FRAMES]: ["--video"],
-  [SCORE]: ["--frames-dir", "--reference"],
