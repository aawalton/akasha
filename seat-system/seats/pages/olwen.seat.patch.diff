-      wrong.push(`${REMOVE} ${path} is not there, so the removal would take nothing away`)
-      continue
-    }
-    taken.push(path)
-    changes.push({ path, body: null })
-  }
-  return { changes, taken, base, mistaken, wrong }
-}
