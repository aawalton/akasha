-  if (refusals.length > 0) return { report: [], refusals, code: 1 }
-  try {
-    return { report: [JSON.stringify(pageAnswers(resolve(given.root)))], refusals: [], code: 0 }
-  } catch (thrown) {
-    return { report: [], refusals: [whyOf(thrown)], code: 3 }
-  }
-}
