-  const many = Number.parseInt(said.out.split(/\r?\n/)[0]?.trim() ?? "", 10)
-  if (!Number.isInteger(many) || many <= 0) {
-    return { why: `ffprobe answered \`${said.out}\` for the frames in \`${path}\`` }
-  }
-  return { many }
-}
