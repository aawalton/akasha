+  expect(bodyOf(root, "akasha/one.ts")).toBe("$& $' $` $1\n$& $' $` $1\n")
+})
+
+test("a passage is matched as bytes rather than as a pattern", async () => {
+  const root = repoWith({ "akasha/one.ts": "a.c\nabc\n" })
