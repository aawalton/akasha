+import type { Finding } from "../finding.page-type.ts"
+
+export const aStaleFixtureWasRepairedToTheWrongSuccessorAndNothingRefusedIt = {
+  id: "01a0769d-6a4e-74b4-ba80-15c571cf537b",
+  pageTypeSlug: "finding",
+  slug: "a-stale-fixture-was-repaired-to-the-wrong-successor-and-nothing-refused-it",
+  domainSlug: "workspace-package/pages-query",
+  claim:
+    "A test that asserts only that something names a domain cannot tell a right subject from a wrong one, so it keeps agreeing when the fixture is repaired to the wrong page. `store-page-asking`'s live naming test named `workspace-package/pages-system`, a slug already gone when the test was written. Repairing it by name similarity pointed it at `workspace-package/pages-system-service`, a different package defined as `the pages reached over HTTP`, and the test went green. The slug's real successor is `workspace-package/page`, the same page under a new name.",
+  evidence:
+    'The fixture was written by 8ead74590c at 2026-09-04T16:26:59-06:00. The slug it named had been renamed by fd1a3767f2 at 2026-09-04T11:16:37-06:00, five hours and ten minutes earlier: that commit renames one file, `pages-system.workspace-package.ts` to `pages.workspace-package.ts`, and the slug on it from `pages-system` to `pages`, with the definition `how we keep track of things` unchanged on both sides. So it is the same page under a new name, and its successor is today `workspace-package/page`, renamed once more. Searching every `*.workspace-package.ts` in the tree at 8ead74590c for `slug: "pages-system"` answers nothing, so no page held that slug when the fixture was written. `workspace-package/pages-system-service` is a different page: it has held its slug since f8ba7054d2 at 2026-08-31T17:49:46-06:00 and is defined as `the pages reached over HTTP`. I repaired the fixture to it in 2b9973e9c1 at 2026-09-06T05:30:37-06:00. Asking the running store what names each, through the same `askNaming` the test calls: `workspace-package/pages-system` answers 0 namings and 0 findings, which is the failure that drew me; `workspace-package/pages-system-service` answers 1 naming and 5 findings, which is why the wrong repair went green; `workspace-package/page` answers 1 naming and 27 findings. The assertion is `naming.length === 1` and `rows.length > 0`, which every live domain satisfies, so it reports whether the store answers rather than which domain was asked about. Akasha\'s census, sent from her own session, is what sent me back to check; her five hours was right and it was my repair that was not.',
+} as const satisfies Finding
