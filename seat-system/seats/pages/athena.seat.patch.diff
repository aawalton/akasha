-  for (let at = 0; at < argv.length; at += 1) {
-    const one = argv[at] ?? ""
-    if (one === EMAIL || one === ALIAS) {
-      const said = argv[at + 1]
-      at += 1
-      if (said === undefined) {
-        refusals.push(`\`${one}\` was said with nothing after it`)
