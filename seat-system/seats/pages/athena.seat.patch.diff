-          refusals.push(`\`${said}\` is no alias slot, which is a whole number from one up`)
-        } else alias = many
-      }
-      continue
-    }
-    if (one.startsWith("-")) {
-      refusals.push(`\`${one}\` is no word this takes`)
-      continue
-    }
-    if (account !== null) {
-      refusals.push("this files one account and no more")
