-    ...overPascal((at) => reaching(shardConst("PASCAL_TO_KEBAB", at), shardSlug(PASCAL_STEM, at))),
-    "",
-    "export const ICON_SEARCH_INDEX = [",
-    ...overIndex((at) => `  ...${shardConst("ICON_SEARCH_INDEX", at)},`),
