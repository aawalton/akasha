+
+const FILED_DAY = `${DAYS}/2026-08-21/eso-day-2026-08-21.eso-day`
+
+const NEW_DAY = `${DAYS}/2026-09-02/eso-day-2026-09-02.eso-day`
+
+const FILED_PLAY_KEY = "4epeNxtHy14CVAP1rePJCs@2026-08-21T12:31:13.556Z"
