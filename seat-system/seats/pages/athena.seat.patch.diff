-  const holders = new Map<string, string[]>()
-  for (const one of domains.values()) {
-    for (const part of one.parts) {
-      const already = holders.get(part)
-      if (already === undefined) holders.set(part, [one.slug])
-      else already.push(one.slug)
-    }
-  }
-  return holders
-}
