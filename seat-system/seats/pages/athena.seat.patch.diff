diff --git a/alan/harness/code-editor/code-editor-data-interfaces/page-tree-assemble/page-tree-assemble.module.code.ts b/alan/harness/code-editor/code-editor-data-interfaces/page-tree-assemble/page-tree-assemble.module.code.ts
