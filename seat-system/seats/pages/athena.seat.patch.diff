+  expect(said.code).toBe(0)
+  expect(titlesIn(root)).toEqual(["Slept", "Held"])
+  expect(baseOf(root)).not.toBe(was)
+  expect(git(root, ["log", "-1", "--pretty=%s"]).trim()).toBe(`Log Held on ${DAY}`)
+})
