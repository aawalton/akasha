-  }
-  const from =
-    wanted.rooted.length > 0
-      ? wanted.rooted
-      : [...domains.values()]
-          .filter((one) => (holders.get(one.slug) ?? []).length === 0)
-          .map((one) => one.slug)
-          .sort((one, two) => one.localeCompare(two))
-  return treeLines(from, domains, wanted.paths)
-}
