-  if (!BUN_REACH.test(reach.global)) return true
-  return !reach.guarded
-}
-
-export function saidAs(reach: Reach): string {
-  const where = reach.atImport ? ", at import" : ""
-  return `${reach.global} in ${reach.file}${where}`
