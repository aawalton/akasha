-  const y = neededIn(said, Y)
-  if (typeof y !== "number") return y
-  const toX = neededIn(said, TO_X)
-  if (typeof toX !== "number") return toX
-  const toY = neededIn(said, TO_Y)
-  if (typeof toY !== "number") return toY
