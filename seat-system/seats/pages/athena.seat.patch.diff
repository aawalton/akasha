-    const one = argv[at] as string
-    at += 1
-    let value: string | undefined
-    if (one === REF) {
-      value = argv[at]
-      at += 1
-    } else if (one.startsWith(`${REF}=`)) {
-      value = one.slice(REF.length + 1)
