+      invariantKind: "absence",
+      statement: "Nothing here writes the bundle unencrypted where that bundle is kept.",
+    },
+    {
+      invariantKind: "absence",
+      statement: "Nothing here undoes a rotation.",
+    },
+  ],
+} as const satisfies Command
