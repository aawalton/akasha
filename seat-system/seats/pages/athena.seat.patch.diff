-      signInPath: said.named[SIGN_IN_PATH],
-      at: said.named[AT],
-    })
-    return { report: [...report], refusals: [], code: 0 }
-  } catch (thrown) {
-    return refusedBy([thrown instanceof Error ? thrown.message : String(thrown)])
-  }
-}
