-      refusals.push(`\`${one}\` is not an argument this takes`)
-      continue
-    }
-    const value = argv[at + 1]
-    if (value === undefined) {
-      refusals.push(`\`${one}\` names a path, and nothing followed it`)
-      continue
-    }
-    named[one] = value
-    at += 1
-  }
-  return refusals.length > 0 ? { refused: refusals } : { named }
-}
