-  const nothing = { refused: [], carried: [], threw: null, reached: new Set<string>() }
-  try {
-    const built = await Bun.build({
-      entrypoints: [join(root, entry)],
-      target: "node",
-      external: ["vscode"],
-      outdir: out,
-    })
-    if (!built.success) {
-      const why = built.logs.map((one) => String(one)).join("; ")
