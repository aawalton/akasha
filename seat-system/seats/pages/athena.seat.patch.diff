-  let act: string | null = null
-  let file: string | null = null
-  let threshold: number | null = null
-  let top: number | null = null
-  let asJson = false
-  for (let at = 0; at < argv.length; at += 1) {
-    const one = argv[at]
-    if (one === undefined) continue
-    if (one === AS_JSON) {
-      asJson = true
-      continue
-    }
-    if (VALUED.includes(one)) {
-      const value = argv[at + 1]
-      at += 1
-      if (one === FILE) {
-        if (value === undefined) refusals.push(`${FILE} names a path and nothing followed it`)
-        else file = value
-        continue
-      }
-      const many = wholeOf(one, value)
-      if (typeof many === "string") refusals.push(many)
-      else if (one === THRESHOLD) threshold = many
-      else top = many
-      continue
-    }
-    if (one.startsWith("-")) {
-      refusals.push(`\`${one}\` is no flag this takes — it takes ${quoted(FLAGS)}`)
