-const PROSE = [...ARTIST_PROSE, ...SONG_PROSE]
-
-const FLAGGED = PROSE.map((one) => `--${one}`)
-
-const VALUED = [TARGET, SLUG, RATING, ...FLAGGED, ...FLAGGED.map((one) => `${one}${FROM_FILE}`)]
