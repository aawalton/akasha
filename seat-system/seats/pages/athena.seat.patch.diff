+})
+
+test("a replacement carrying dollar patterns lands as the bytes it is", async () => {
+  const root = repoWith({ "akasha/one.ts": "alpha\nalpha\n" })
+  const said = await replace(
+    ["--file-path", "akasha/one.ts", ...stating(root, "a", "alpha", "$& $' $` $1")],
