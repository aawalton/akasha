-  let depth = 1
-  while (frontier.length > 0) {
-    const next: string[] = []
-    for (const one of [...frontier].sort((a, b) => a.localeCompare(b))) {
-      if (seen.has(one)) continue
-      seen.add(one)
-      lines.push(`${"  ".repeat(depth)}${label(one, domains, paths)}`)
-      next.push(...(holders.get(one) ?? []))
-    }
-    frontier = next
-    depth += 1
-  }
-  return lines
-}
