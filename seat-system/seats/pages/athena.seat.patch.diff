+import { expect, test } from "bun:test"
+import type { Shaped } from "@akasha/indexes/reaching"
+import type { Value } from "@akasha/pages/page-value"
+import {
+  NOTHING_OVER,
+  type World,
+} from "../../../modules/change-shadow/change-shadow.module.code.ts"
+import { addPropertyValue, runChange } from "./add-property-value.change-checked.code.ts"
+
+const AT = "held/held.domain.ts"
+
+const ID = "01a072c8-f35d-7ffc-afc3-75b72460b059"
+
+const BODY = `import type { Domain } from "../domains/domain.page-type.ts"
+
+export const held = {
+  id: "${ID}",
+  pageTypeSlug: "domain",
+  slug: "held",
+  definition: "a domain the tests hold",
+  partSlugs: ["command/one"],
+} as const satisfies Domain
+`
+
+const PAGE = { id: ID, pageTypeSlug: "domain", slug: "held" } as Value
+
+type Told = {
+  readonly slug: string | null
+  readonly target: string | null
+  readonly found: readonly { readonly path: string; readonly id: string }[]
+  readonly page?: Value | null
+}
+
+function worldTold(told: Told): World {
+  const known = {
+    slugOfKeyIn: () => told.slug,
+    targetOf: () => told.target,
+    admitting: (one: string) => [one],
+    at: () => told.found,
+    byId: () => null,
+    mortal: () => false,
+  } as unknown as Shaped
+  return {
+    root: "/nowhere",
+    index: { knownIn: () => known, pageAt: () => ("page" in told ? told.page : PAGE) } as never,
+    textOf: () => BODY,
+    over: NOTHING_OVER,
+  }
+}
+
+const ASKED = { at: AT, key: "partSlugs", value: "command/two" }
+
+test("a value naming no page is refused where the key names a relation", () => {
+  const said = addPropertyValue(
+    worldTold({ slug: "part-slugs", target: "command", found: [] }),
+    ASKED
+  )
+
+  expect(said.edits).toEqual([])
+  expect(said.refused ?? "").toBe(
+    "`partSlugs` names a relation, and no `command` carries the slug `two`"
+  )
+})
+
+test("a value reaching a page is put in after the values already there", () => {
+  const world = worldTold({
+    slug: "part-slugs",
+    target: "command",
+    found: [{ path: "two.command.ts", id: ID }],
+  })
+
+  const said = addPropertyValue(world, ASKED)
+
+  expect(said.refused).toBeNull()
+  expect(said.edits[0]?.body ?? "").toContain(`["command/one", "command/two"]`)
+})
+
+test("a key naming no relation takes its value unresolved", () => {
+  const said = addPropertyValue(worldTold({ slug: null, target: null, found: [] }), ASKED)
+
+  expect(said.refused).toBeNull()
+  expect(said.edits[0]?.body ?? "").toContain(`["command/one", "command/two"]`)
+})
+
+test("a path the world names no page at is refused", () => {
+  const world = worldTold({ slug: "part-slugs", target: "command", found: [], page: null })
+
+  const said = addPropertyValue(world, ASKED)
+
+  expect(said.edits).toEqual([])
+  expect(said.refused ?? "").toMatch(/names no page/)
+})
+
+test("an argument this change was handed no value for is refused by the key", () => {
+  const said = runChange(worldTold({ slug: null, target: null, found: [] }), { at: AT })
+
+  expect(said.edits).toEqual([])
+  expect(said.refused ?? "").toMatch(/`key` names what this change is handed/)
+})
