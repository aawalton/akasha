-async function applying(read: Named, given: Given): Promise<Answer> {
-  let node: NodeIntent
-  let cluster: ClusterIntent
-  let name: string
-  try {
-    node = getNode(read.node)
-    name = read.cluster ?? node.cluster
-    cluster = getCluster(name)
