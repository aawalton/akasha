-      code: INPUT,
-    }
-  }
-  const controlPlanes = read.controlPlanes.join(",")
-  await runTalosctl({
-    args: [
-      "--talosconfig",
-      talosconfig,
-      "health",
-      "--nodes",
-      read.ip,
-      "--endpoints",
-      controlPlanes,
-      "--control-plane-nodes",
