-    }
-    const files = globSync("**/*.js", { cwd: out })
-    if (files.length === 0) {
-      return {
-        entry,
-        ...nothing,
-        built: false,
-        why: "the bundle wrote no file, so nothing was judged",
-      }
-    }
-    const refused = new Set<string>()
-    const carried = new Set<string>()
-    const reached = new Set<string>()
-    for (const one of files) {
