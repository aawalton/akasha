-      }
-    }
-    const value = argv[at + 1]
-    if (value === undefined) {
-      return { paths: [], refusal: `${FILE_PATH} names a path, and nothing followed it` }
-    }
-    paths.push(value)
-    at += 1
-  }
-  return { paths, refusal: null }
-}
