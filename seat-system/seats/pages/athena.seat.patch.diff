+      invariantKind: "departure",
+      statement: "The node is left in maintenance mode rather than in its cluster.",
+    },
+    {
+      invariantKind: "absence",
+      statement: "Nothing here undoes a disk wipe.",
+    },
+  ],
+} as const satisfies Command
