-
-const INPUT = 1
-
-const DATA = 2
-
-const EQUIPMENT_ITEM = "equipment-item"
-
-const TITLE = "--title"
-
-const CATEGORY = "--category"
-
-const CONFIGURATION = "--configuration"
-
-const LOADS = "--loads"
