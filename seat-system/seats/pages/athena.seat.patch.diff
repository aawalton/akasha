-const PROMPT = "--prompt"
-
-const START_MODE = "--start-mode"
-
-const TARGET = "--agent-id"
-
-const ACTED_ON = `\`${SUPERVISOR}\`, \`${RESUME}\`, \`${RESET}\` and \`${START}\``
-
-const ASK = "reExecAsk"
-
-const ASKED = "asked"
-
-const SIGNAL = "SIGTERM"
-
-const ID = "id"
