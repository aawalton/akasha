-const INPUT = 1
-
-const DATA = 2
-
-const EXERCISE = "exercise"
-
-const ALANS_OWN = "aelwyn-custom"
-
-const TITLE = "--title"
-
-const SLUG = "--slug"
-
-const CATEGORY = "--category"
-
-const EQUIPMENT = "--equipment"
-
-const FORCE = "--force"
