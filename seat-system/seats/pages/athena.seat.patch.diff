-function staged(
-  stage: string,
-  root: string,
-  pages: readonly Staged[],
-  gone: readonly string[]
-): string {
-  const calls: string[] = []
-  for (const page of pages) {
-    for (const [at, body] of [
-      [page.codeAt, page.code],
-      [page.pageAt, pageBody(root, page.slug, page.definition)],
