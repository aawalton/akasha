-    `APP=${appPath}`,
-    'CODESIGN_OUT=$(codesign -dv "$APP" 2>&1)',
-    'echo "$CODESIGN_OUT"',
-    `echo "$CODESIGN_OUT" | grep -q "Identifier=${read.app.bundleId}"`,
-    `echo "$CODESIGN_OUT" | grep -q "TeamIdentifier=${read.app.developmentTeam}"`,
