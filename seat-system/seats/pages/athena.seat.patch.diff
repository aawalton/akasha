-    Array.from({ length: indexShards }, (_unused, at) => f(at))
-  const overPascal = <T>(f: (at: number) => T): T[] =>
-    Array.from({ length: pascalShards }, (_unused, at) => f(at))
-  const reaching = (named: string, slug: string): string =>
