-      return {
-        report: [],
-        refusals: [`a page already exists for \`${read.account}\`, and this writes over none`],
-        code: 1,
-      }
-    }
-    const slot = slotFrom(held, read.alias)
-    if (typeof slot === "string") return { report: [], refusals: [slot], code: 1 }
