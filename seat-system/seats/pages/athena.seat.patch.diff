diff --git a/infrastructure/alerts/pages/macbook-inference-probe-stale.alert.description.txt b/infrastructure/alerts/pages/macbook-inference-probe-stale.alert.description.txt
index 3fcf509346018529b10aef20215f0e0a4f63959d..f84bdbee0c833f905489475da8ef57c83241c7bd 100644
