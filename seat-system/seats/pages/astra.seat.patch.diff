diff --git a/domains/findings/pages/an-assertion-restating-the-query-the-code-composes-certifies-a-query-nothing-can-answer.finding.ts b/domains/findings/pages/an-assertion-restating-the-query-the-code-composes-certifies-a-query-nothing-can-answer.finding.ts
