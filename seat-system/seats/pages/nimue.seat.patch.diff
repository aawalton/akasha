@@ -0,0 +1,142 @@
+import { afterAll, expect, test } from "bun:test"
+import { bodyOf, indexedRepo, pageOf, scratch, textIn } from "@akasha/indexes/indexing/testing"
+import { runChange as renameImports } from "../../../mechanical/pages/rename-imports/rename-imports.change-mechanical-code.code.ts"
+import { runChange as renamePageSlug } from "../../../mechanical/pages/rename-page-slug/rename-page-slug.change-mechanical-data.code.ts"
+import { refusing } from "../../../modules/change-answer/change-answer.module.code.ts"
+import { type World, worldAt } from "../../../modules/change-shadow/change-shadow.module.code.ts"
+import { landsAt, moveFolderPackage } from "./move-folder-package.change-checked.code.ts"
+
+afterAll(scratch.sweep)
+
+const FROM = "akasha/one"
+
+const INTO = "akasha/two"
+
+const PACKAGE_PAGE = "akasha/one/one.workspace-package.ts"
+
+const INNER_PAGE = "akasha/one/held/held.module.ts"
+
+const INNER_CODE = "akasha/one/held/held.module.code.ts"
+
+const OUTER_CODE = "akasha/outside/namer.module.code.ts"
+
+const LANDED_PAGE = "akasha/two/two.workspace-package.ts"
+
+const LANDED_CODE = "akasha/two/held/held.module.code.ts"
+
+const idAt = (one: string): string => `01a07c55-0004-7000-8000-00000000000${one}`
+
+const SPELLED: Readonly<Record<string, string>> = {
+  "akasha/workspace-package.page-type.ts": bodyOf({
+    id: idAt("0"),
+    pageTypeSlug: "page-type",
+    slug: "workspace-package",
+    extendsSlug: ["page-type/domain"],
+  }),
+  [PACKAGE_PAGE]: pageOf({
+    id: idAt("1"),
+    pageTypeSlug: "workspace-package",
+    slug: "one",
+  }),
+  [INNER_PAGE]: pageOf({
+    id: idAt("2"),
+    pageTypeSlug: "module",
+    slug: "held",
+    code: "ts",
+  }),
+  [INNER_CODE]: "export const held = 1\n",
+  "akasha/outside/namer.module.ts": pageOf({
+    id: idAt("3"),
+    pageTypeSlug: "module",
+    slug: "namer",
+    code: "ts",
+  }),
+  [OUTER_CODE]: `import { held } from "../one/held/held.module.code.ts"\n\nexport const namer = held\n`,
+}
+
+function worldIn(root: string): World {
+  return worldAt(root, textIn(root), (world, at, given) => {
+    if (at === "change-mechanical-code/rename-imports") {
+      return Promise.resolve(renameImports(world, given as Parameters<typeof renameImports>[1]))
+    }
+    if (at === "change-mechanical-data/rename-page-slug") {
+      return Promise.resolve(renamePageSlug(world, given as Parameters<typeof renamePageSlug>[1]))
+    }
+    return Promise.resolve(refusing(`\`${at}\` is reached by nothing here`))
+  })
+}
+
+function packaged(): World {
+  return worldIn(indexedRepo(SPELLED))
+}
+
+test("a file beneath the folder lands beneath the folder the package moves to", () => {
+  expect(
+    landsAt("held/held.module.code.ts", INTO, "one.workspace-package.", "two.workspace-package.")
+  ).toBe(LANDED_CODE)
+})
+
+test("a file named for the package is renamed for the slug the package takes", () => {
+  expect(
+    landsAt("one.workspace-package.ts", INTO, "one.workspace-package.", "two.workspace-package.")
+  ).toBe(LANDED_PAGE)
+})
+
+test("every file the index names under the folder is carried", async () => {
+  const said = await moveFolderPackage(packaged(), { at: PACKAGE_PAGE, to: INTO })
+  const paths = said.edits.map((one) => one.path)
+
+  expect(said.refused).toBeNull()
+  expect(paths).toContain(LANDED_PAGE)
+  expect(paths).toContain(LANDED_CODE)
+  expect(paths).toContain("akasha/two/held/held.module.ts")
+})
+
+test("every path that moved says the path the move came from", async () => {
+  const said = await moveFolderPackage(packaged(), { at: PACKAGE_PAGE, to: INTO })
+  const came = said.edits.map((one) => one.from).filter((one) => one !== undefined)
+
+  expect([...came].sort()).toEqual([INNER_CODE, INNER_PAGE, PACKAGE_PAGE])
+})
+
+test("a body reaching the folder by a relative address is repointed here", async () => {
+  const said = await moveFolderPackage(packaged(), { at: PACKAGE_PAGE, to: INTO })
+  const one = said.edits.find((edit) => edit.path === OUTER_CODE)
+
+  expect(one?.body ?? "").toContain("../two/held/held.module.code.ts")
+})
+
+test("the package takes the slug the folder it lands in is named by", async () => {
+  const said = await moveFolderPackage(packaged(), { at: PACKAGE_PAGE, to: INTO })
+  const one = said.edits.find((edit) => edit.path === LANDED_PAGE)
+
+  expect(one?.body ?? "").toContain(`slug: "two"`)
+})
+
+test("the folder a package sits in is refused rather than carried", async () => {
+  const said = await moveFolderPackage(packaged(), { at: PACKAGE_PAGE, to: FROM })
+
+  expect(said.edits).toEqual([])
+  expect(said.refused ?? "").toMatch(/is the folder this package sits in/)
+})
+
+test("a page that is no workspace package is refused", async () => {
+  const said = await moveFolderPackage(packaged(), { at: INNER_PAGE, to: INTO })
+
+  expect(said.edits).toEqual([])
+  expect(said.refused ?? "").toMatch(/is no `workspace-package`/)
+})
+
+test("a path naming no page is refused", async () => {
+  const said = await moveFolderPackage(packaged(), { at: INNER_CODE, to: INTO })
+
+  expect(said.edits).toEqual([])
+  expect(said.refused ?? "").toMatch(/names no page/)
+})
+
+test("a call stating no folder is refused by that key", async () => {
+  const said = await moveFolderPackage(packaged(), { at: PACKAGE_PAGE, to: "akasha/outside" })
+
+  expect(said.edits).toEqual([])
+  expect(said.refused ?? "").toMatch(/is a body already/)
+})
