+export function statedIn(kept: Kept, edit: Edit): boolean {
+  const before = kept.stated.get(edit.path)
+  if (before === undefined) return false
+  return before.some(
+    (one) => one.was === edit.was && one.body === edit.body && one.from === edit.from
+  )
+}
