+import { basename, dirname, join, relative } from "node:path"
+import { partedIn } from "@akasha/pages/page-file-name"
+import { importingOf } from "../../../../pages/indexes/path-naming/path-naming.module.code.ts"
+import {
+  answered,
+  missing,
+  refusing,
+} from "../../../modules/change-answer/change-answer.module.code.ts"
+import type { Answer, Edit } from "../../../modules/change-answer/change-answer.module.types.ts"
+import { reach, type World } from "../../../modules/change-shadow/change-shadow.module.code.ts"
+import { pageIn } from "../../../modules/page-knowing/page-knowing.module.code.ts"
+
+const RENAME_IMPORTS = "change-mechanical-code/rename-imports"
+
+const RENAME_PAGE_SLUG = "change-mechanical-data/rename-page-slug"
+
+const PACKAGE = "workspace-package"
+
+const UNCARRIED = "so no folder is carried"
+
+const AT = "at"
+
+const TO = "to"
+
+const UNDER = "/"
+
+export type MoveFolderPackageAsked = {
+  readonly at: string
+  readonly to: string
+}
+
+type Carried = { readonly moved: ReadonlyMap<string, string> } | { readonly refused: string }
+
+export function landsAt(tail: string, to: string, opening: string, said: string): string {
+  const base = basename(tail)
+  if (!base.startsWith(opening)) return join(to, tail)
+  return join(to, dirname(tail), `${said}${base.slice(opening.length - 1)}`)
+}
+
+function carriedInto(
+  world: World,
+  from: string,
+  to: string,
+  said: string,
+  held: { readonly slug: string; readonly pageType: string }
+): Carried {
+  const opening = `${held.slug}.${held.pageType}.`
+  const moved = new Map<string, string>()
+  for (const one of world.index.everyPath()) {
+    if (!one.startsWith(`${from}${UNDER}`)) continue
+    const next = landsAt(relative(from, one), to, opening, `${said}.${held.pageType}.`)
+    if (world.textOf(next) !== null)
+      return { refused: `\`${next}\` is a body already, ${UNCARRIED}` }
+    moved.set(one, next)
+  }
+  return { moved }
+}
+
+export async function moveFolderPackage(
+  world: World,
+  given: MoveFolderPackageAsked
+): Promise<Answer> {
+  const parted = partedIn(given.at)
+  if (parted === null || pageIn(world, given.at) === null) {
+    return refusing(`\`${given.at}\` names no page, ${UNCARRIED}`)
+  }
+  if (parted.pageType !== PACKAGE) {
+    return refusing(`\`${given.at}\` is no \`${PACKAGE}\`, ${UNCARRIED}`)
+  }
+  const from = dirname(given.at)
+  if (from === given.to) {
+    return refusing(`\`${given.to}\` is the folder this package sits in, ${UNCARRIED}`)
+  }
+  const said = basename(given.to)
+  const carried = carriedInto(world, from, given.to, said, parted)
+  if ("refused" in carried) return refusing(carried.refused)
+  const moved = carried.moved
+  if (moved.size === 0) return refusing(`\`${from}\` holds no file, ${UNCARRIED}`)
+  if (!moved.has(given.at))
+    return refusing(`\`${given.at}\` is no file of \`${from}\`, ${UNCARRIED}`)
+  const reading = importingOf(world.index, moved)
+  if ("unread" in reading) return refusing(reading.unread)
+  const held = Object.fromEntries(moved)
+  const edits: Edit[] = []
+  let seen = world
+  for (const [one, next] of moved) {
+    if (seen.textOf(one) === null) return refusing(`\`${one}\` could not be read`)
+    const answer = await reach(seen, RENAME_IMPORTS, { was: one, now: next, moved: held })
+    if (answer.said.refused !== null) return answer.said
+    edits.push(...answer.said.edits)
+    seen = answer.world
+  }
+  for (const path of reading.importers) {
+    if (moved.has(path)) continue
+    const body = seen.textOf(path)
+    if (body === null) return refusing(`\`${path}\` names a path that moved and could not be read`)
+    const answer = await reach(seen, RENAME_IMPORTS, { was: path, now: path, moved: held })
+    if (answer.said.refused !== null) return answer.said
+    for (const one of answer.said.edits) {
+      if (one.body !== body) edits.push(one)
+    }
+    seen = answer.world
+  }
+  if (said === parted.slug) return answered(edits)
+  const landed = moved.get(given.at)
+  if (landed === undefined) return refusing(`\`${given.at}\` was not carried, ${UNCARRIED}`)
+  const answer = await reach(seen, RENAME_PAGE_SLUG, { at: landed, to: said })
+  if (answer.said.refused !== null) return answer.said
+  edits.push(...answer.said.edits)
+  return answered(edits)
+}
+
+export type Asked = Readonly<Record<string, string>>
+
+export async function runChange(world: World, given: Asked): Promise<Answer> {
+  const at = given[AT]
+  if (at === undefined) return refusing(missing(AT))
+  const to = given[TO]
+  if (to === undefined) return refusing(missing(TO))
+  return await moveFolderPackage(world, { at, to })
+}
diff --git a/changes/checked/pages/move-folder-package/move-folder-package.change-checked.test.ts b/changes/checked/pages/move-folder-package/move-folder-package.change-checked.test.ts
