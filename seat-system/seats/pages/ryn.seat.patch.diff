index 0000000000000000000000000000000000000000..f6fdc4b0ad8d9d5d5804585de715e49a5f32ffaf
--- /dev/null
+++ b/domains/sentence-shapes/closing-count/closing-count.sentence-shape.code.ts
@@ -0,0 +1,25 @@
+import type { DepSentence, DepToken } from "@akasha/plain-language/dependency-graph"
+import type { Match, ShapePredicate } from "@akasha/plain-language/shape-predicate"
+import { isSummingCount } from "@akasha/plain-language/shape-predicate"
+
+function closesSentence(sentence: DepSentence, token: DepToken): boolean {
+  return sentence.tokens.every((one) => one.id <= token.id || one.upos === "PUNCT")
+}
+
+function listedBefore(sentence: DepSentence, token: DepToken): DepToken[] {
+  return sentence.tokens.filter(
+    (one) => one.id < token.id && (one.deprel === "conj" || one.deprel.startsWith("conj:"))
+  )
+}
+
+export const closingCount: ShapePredicate = (sentence) => {
+  const found: Match[] = []
+  for (const token of sentence.tokens) {
+    if (!isSummingCount(token)) continue
+    if (!closesSentence(sentence, token)) continue
+    const listed = listedBefore(sentence, token)
+    if (listed.length === 0) continue
+    found.push({ at: [...listed.map((one) => one.id), token.id] })
+  }
+  return found
+}
diff --git a/domains/sentence-shapes/closing-count/closing-count.sentence-shape.test.ts b/domains/sentence-shapes/closing-count/closing-count.sentence-shape.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..56f1a53abd05795156dc8621780e62f2c605bd39
--- /dev/null
+++ b/domains/sentence-shapes/closing-count/closing-count.sentence-shape.test.ts
@@ -0,0 +1,70 @@
+import { expect, test } from "bun:test"
+import type { DepSentence } from "@akasha/plain-language/dependency-graph"
+import { makeSentence } from "@akasha/plain-language/dependency-graph"
+import { closingCount } from "./closing-count.sentence-shape.code.ts"
+
+type Row = readonly [string, string, number, string]
+
+function sentenceOf(rows: readonly Row[]): DepSentence {
+  let at = 0
+  const tokens = rows.map(([form, upos, head, deprel], index) => {
+    const start = at
+    at += form.length + 1
+    return { id: index + 1, form, upos, head, deprel, start, end: start + form.length }
+  })
+  return makeSentence({
+    text: rows.map((row) => row[0]).join(" "),
+    start: 0,
+    end: at,
+    tokens,
+  })
+}
+
+test("a count closing a sentence over the list it gave is found", () => {
+  const said = sentenceOf([
+    ["A", "DET", 2, "det"],
+    ["kind", "NOUN", 4, "nsubj"],
+    ["is", "AUX", 4, "cop"],
+    ["authored", "VERB", 0, "root"],
+    ["or", "CCONJ", 6, "cc"],
+    ["serialized", "VERB", 4, "conj"],
+    ["and", "CCONJ", 9, "cc"],
+    ["never", "ADV", 9, "advmod"],
+    ["both", "PRON", 4, "conj"],
+    [".", "PUNCT", 4, "punct"],
+  ])
+  expect(closingCount(said)).toEqual([{ at: [6, 9] }])
+})
+
+test("a count anywhere but the close is passed over", () => {
+  const said = sentenceOf([
+    ["Both", "PRON", 3, "nsubj"],
+    ["are", "AUX", 3, "cop"],
+    ["refused", "ADJ", 0, "root"],
+  ])
+  expect(closingCount(said)).toEqual([])
+})
+
+test("a count closing a sentence that gave no list is passed over", () => {
+  const said = sentenceOf([
+    ["A", "DET", 2, "det"],
+    ["pass", "NOUN", 3, "nsubj"],
+    ["writes", "VERB", 0, "root"],
+    ["both", "PRON", 3, "obj"],
+    [".", "PUNCT", 3, "punct"],
+  ])
+  expect(closingCount(said)).toEqual([])
+})
+
+test("a word that sums nothing is passed over though a list comes before it", () => {
+  const said = sentenceOf([
+    ["A", "DET", 2, "det"],
+    ["rule", "NOUN", 3, "nsubj"],
+    ["reads", "VERB", 0, "root"],
+    ["markup", "NOUN", 3, "obj"],
+    ["and", "CCONJ", 6, "cc"],
+    ["lua", "NOUN", 4, "conj"],
+    [".", "PUNCT", 3, "punct"],
+  ])
+  expect(closingCount(said)).toEqual([])
+})
