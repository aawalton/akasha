diff --git a/domains/sentence-shapes/shape-fixture/shape-fixture.module.code.ts b/domains/sentence-shapes/shape-fixture/shape-fixture.module.code.ts
new file mode 100644
index 0000000000000000000000000000000000000000..aa6f7e040c7e3b633dbe7f1319c8c49c83f93ece
--- /dev/null
+++ b/domains/sentence-shapes/shape-fixture/shape-fixture.module.code.ts
@@ -0,0 +1,28 @@
+import type { DepSentence } from "@akasha/plain-language/dependency-graph"
+import { makeSentence } from "@akasha/plain-language/dependency-graph"
+
+export type Row = readonly [string, string, number, string]
+
+export function sentenceOf(rows: readonly Row[]): DepSentence {
+  let at = 0
+  const tokens = rows.map(([form, upos, head, deprel], index) => {
+    const start = at
+    at += form.length + 1
+    return {
+      id: index + 1,
+      form,
+      upos,
+      head,
+      deprel,
+      start,
+      end: start + form.length,
+      confidence: { upos: 1, head: 1, deprel: 1 },
+    }
+  })
+  return makeSentence({
+    text: rows.map((row) => row[0]).join(" "),
+    start: 0,
+    end: at,
+    tokens,
+  })
+}
