+    console.log("OK: removed " + cls + " from packageClassList of " + p + " (widget-refresh disabled)");
+  } else {
+    console.log("OK: " + cls + (enabled ? " already in" : " absent from") + " packageClassList of " + p);
+  }
+' "$CONFIG" "$WIDGET_REFRESH_ENABLED"
+
+node -e '
