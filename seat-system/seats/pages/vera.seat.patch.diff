+      path: "akasha/one.ts",
+      line: 28,
+      column: 3,
+      rule: RULE,
+      said: "This parameter is unused.",
+    },
+  ])
+})
+
+check("output holding no run that can be read answers nothing, never an empty run", () => {
+  expect(foundIn("")).toBeNull()
