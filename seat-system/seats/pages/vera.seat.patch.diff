diff --git a/code/ios-apps/pages/smilingjenny/scripts/ios-add/smilingjenny-ios-add.shell-script.shell.sh b/code/ios-apps/pages/smilingjenny/scripts/ios-add/smilingjenny-ios-add.shell-script.shell.sh
