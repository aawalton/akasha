-    patches.push({ start: span.start, end: span.end, text, was })
-  }
-
-  for (const match of tokens.masked.matchAll(NEW_URL)) {
-    const open = (match.index ?? 0) + match[0].length - 1
-    const args = argumentsOf(tokens.masked, open)
-    const first = args?.[0]
-    const second = args?.[1]
