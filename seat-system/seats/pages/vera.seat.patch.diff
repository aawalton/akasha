-func scanSources(dir: String) throws -> SourceScan {
-    let fm = FileManager.default
-    let files = try fm.contentsOfDirectory(atPath: dir).filter { $0.hasSuffix(".swift") }.sorted()
-
-    var bundleWidgets: [String] = []
