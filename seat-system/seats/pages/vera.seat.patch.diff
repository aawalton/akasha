-enum RingCredential {
-    static let header = "X-Ring-Credential"
-
-    static let baked = "__RING_CREDENTIAL_NOT_SUBSTITUTED__"
-
-    static func toPresent(_ value: String = baked) -> String? {
-        if value.isEmpty || value.hasPrefix(placeholderPrefix) { return nil }
-        return value
-    }
