diff --git a/code/ios-components/pages/smilingjenny-widget-feed/smilingjenny-widget-feed.ios-component.swift.swift b/code/ios-components/pages/smilingjenny-widget-feed/smilingjenny-widget-feed.ios-component.swift.swift
