+import type { Module } from "../modules/module.page-type.ts"
+
+export const codeTyping = {
+  id: "01a058ec-4a71-7000-9c3e-6b1f0a2d4e55",
+  pageTypeSlug: "module",
+  slug: "code-typing",
+  definition: "a program built over the pages, and what the checker says a spelling means",
