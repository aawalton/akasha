+    program,
+    checker: program.getTypeChecker(),
+    sourceAt: (path) => program.getSourceFile(join(root, path)) ?? null,
+  }
+}
+
+function keyOf(name: ts.Node): string | null {
+  return ts.isIdentifier(name) || ts.isStringLiteral(name) ? name.text : null
+}
