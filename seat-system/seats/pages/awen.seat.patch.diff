-  "gateDimensions": [
-    {
-      "id": "perceivable-bound",
-      "title": "Perceivable-bound narration — narrate only what the POV character can perceive or fallibly infer; another mind's interiority or future intention needs a perception or earned-intimacy anchor (a POV narrator may be confidently wrong)."
-    },
-    {
-      "id": "invisible-turns:boundary-seam",
-      "title": "Invisible turns — boundary seam: no recap-to-start or wind-down-to-end scaffolding at the turn's edges; the turn opens and closes mid-fiction."
-    },
-    {
-      "id": "invisible-turns:invitation-close",
-      "title": "Invisible turns — invitation/handoff close: the turn does not end on a narrator-voice solicitation of the next input ('what do you do?', 'the floor is yours')."
-    },
-    {
-      "id": "invisible-turns:mechanical-echo",
-      "title": "Invisible turns — mechanical echo / channel bleed: prose does not re-tell a System beat or surface mechanical vocabulary (stat tokens, sheet-register); narrate the effect, never name the mechanic."
-    },
-    {
-      "id": "invisible-turns:meta-leak",
-      "title": "Invisible turns — meta-leak: prose does not name turns, rolls, the action bar, or retries as apparatus (a genuinely diegetic in-fiction frame decoupled from turn cadence is not a leak)."
-    },
-    {
-      "id": "invisible-turns:cadence-tell",
-      "title": "Invisible turns — cadence tell: turns do not all share one shape; the prose does not pulse at turn length."
-    },
-    {
-      "id": "emergent-story-dm-register",
-      "title": "Emergent-story / DM-register: no laundered agency (narrating a choice the player did not state, or dictating the world's response as if the player authored it) and no success-by-phrasing (outcome bent by wording rather than mechanics); genuine genre lulls are not a finding."
-    },
-    {
-      "id": "earned-peak",
-      "title": "Earned peak / register restraint: emotional pitch tracks the moment — no constant superlatives within a character's own register (preserve each character's distinct intensity distribution; never flatten voice)."
-    },
-    {
-      "id": "window-pane-prose",
-      "title": "Window-pane prose / aphorism close: the reader looks through the prose, not at it — no habitual ornamental button-cadence (one earned flourish at a genuine peak is fine; judge the cadence, not single lines)."
-    },
-    {
-      "id": "register-as-distribution",
-      "title": "Register as distribution / single-feature over-focus: a character's signature trait (metaphor family, verbal tic) is a sampling distribution, not a constant — no saturation routing every perception through one frame (preserve the trait and each character's distinct frequency)."
-    },
-    {
-      "id": "turn-boundaries",
-      "title": "Turn boundaries — turn-head re-establishment + poised-close uniformity: classify this draft's head and close and tally the last K published turns; a K>=3 uniform poised-close or ambient-reestablish run (this draft included) is a finding even though each instance is individually legal — REPORT THE TALLY in evidence."
-    },
-    {
-      "id": "setting-coherence",
-      "title": "Setting coherence / canon consistency: the narrative does not contradict landed canon; no stat-readout narration (system-coherent but prose-dead)."
