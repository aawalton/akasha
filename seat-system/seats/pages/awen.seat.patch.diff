+  const give = (): undefined => {
     if (markIn(file) === mine) rmSync(lock, { recursive: true, force: true })
   }
+  let held: T
+  try {
+    held = act()
+  } catch (failed) {
+    give()
+    throw failed
+  }
+  // An act that settles later returns the moment it first waits, and giving the turn up there
