diff --git a/alan/web/tsconfig.json b/alan/web/tsconfig.json
new file mode 100644
index 0000000000000000000000000000000000000000..ab8455e15d79ba046c81d6abe474550ea8830d65
--- /dev/null
+++ b/alan/web/tsconfig.json
@@ -0,0 +1,36 @@
+{
+  "extends": "../../tsconfig.base.json",
+  "compilerOptions": {
+    "jsx": "react-jsx",
+    "lib": ["dom", "dom.iterable", "esnext"],
+    "types": ["@types/bun", "node", "vite/client"],
+    "rootDirs": [".", "./.react-router/types"],
+    "paths": {
+      "@/*": ["./*"]
+    },
+    "composite": true,
+    "noEmit": false,
+    "emitDeclarationOnly": true,
+    "declarationDir": "dist",
+    "rootDir": "../.."
+  },
+  "include": [
+    "*.ts",
+    "*.tsx",
+    "routes/**/*.ts",
+    "routes/**/*.tsx",
+    "*/*.module.ts",
+    "*/*.module.code.ts",
+    "*/*.module.code.tsx",
+    "*/*.stylesheet.ts",
+    ".react-router/types/**/*.ts",
+    ".react-router/types/**/*.tsx",
+    ".react-router/types/**/+types/*.ts",
+    "server.ts",
+    "vite.config.ts",
+    "react-router.config.ts",
+    "*.cluster-service.code.attachment.ts",
+    "tunnel-routes.ts"
+  ],
+  "exclude": ["node_modules", "dist", "build"]
+}
