reward":"THE LINK — first activation","status":"complete","objective":"give yourself to her fully"},{"id":"floor-1-door","title":"The Shut Door","status":"complete","objective":"open the door at the dark end of the hall"},{"id":"floor-2-door","title":"The Far Door","status":"active","objective":"reach the shut door at the dark end of the second floor"}],"chapters":[],"revealed":{"kind":"player","name":"Alan","bonds":[{"name":"Aria","note":"+1 PRESENCE from her — grows as hers grows.","value":1}],"class":"None","level":2,"skills":[],"titles":[],"equipment":{"weapon":{"name":"Letter-Knife"}},"inventory":[],"affinities":[],"attributes":{"LUCK":11,"WILL":18,"MIGHT":12,"FINESSE":15,"PRESENCE":16,"VITALITY":10,"INTELLECT":18,"PERCEPTION":12}}},"progress":481,"completed-at":"2026-07-14T10:03:02.509Z","lore-ingested-at":"2026-07-14T10:11:09.378Z","id":"4f5c12a3-652f-559b-b7a0-012dfe705e51"}
