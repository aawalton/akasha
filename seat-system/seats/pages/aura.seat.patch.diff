@@ -0,0 +1,26 @@
+import { getEsoDayStr } from "@akasha/day/eso-day"
+import { levelOf } from "../../harness/attributes/levelling/attributes-levelling.module.code.ts"
+import {
+  charismaOf,
+  trackedDay,
+} from "../../harness/attributes/reading/attributes-reading.module.code.ts"
+import {
+  charismaOf as charismaOverDay,
+  totalOverDays,
+} from "../../harness/attributes/totalling/attributes-totalling.module.code.ts"
+
+// THE STRETCHES ARE REACHED TWO WAYS. Today's stretches are asked for under the day's own id, and a
+// day already read carries its stretches, so the total reads what the day holds rather than asking
+// again for every day Alan has tracked.
+export async function pointsToday(now: Date = new Date()): Promise<number | null> {
+  const values = await trackedDay(getEsoDayStr(now))
+  return values === null ? null : charismaOf(values)
+}
+
+export async function pointsTotal(root: string): Promise<number | null> {
+  return totalOverDays(root, charismaOverDay)
+}
+
+export async function level(root: string): Promise<number> {
+  return levelOf((await pointsTotal(root)) ?? 0)
+}
