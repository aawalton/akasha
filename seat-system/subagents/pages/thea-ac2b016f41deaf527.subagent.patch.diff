diff --git a/dotfiles/bin/akasha b/dotfiles/bin/akasha
old mode 100755
new mode 100644
index fec3f68d7ddc8244121f476ee6db206bd23f4695..05008a286afaac9f8ea39dcbf7e3f2b76430c1d0
