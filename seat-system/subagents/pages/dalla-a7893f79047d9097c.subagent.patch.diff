diff --git a/changes/pages/rename-code-token/rename-code-token.change.code.ts b/changes/pages/rename-code-token/rename-code-token.change.code.ts
index de7ed33916fa5d879ad16ccd24df5cf096e9593e..fe3ffc2be606e37c74e545b516b55ea8954bab50 100644
--- a/changes/pages/rename-code-token/rename-code-token.change.code.ts
