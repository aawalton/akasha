+export function linkIn(root: string, path: string, to: string): undefined {
+  const at = join(root, path)
+  mkdirSync(join(at, ".."), { recursive: true })
+  symlinkSync(to, at)
+  git(root, ["add", "-A"])
+  git(root, ["commit", "--quiet", "-m", "a link is there"])
+}
