+      pageTypeSlug: "spark",
+      slug: "one",
+      partSlugs: ["module/lone"],
+    }),
+    [LONE_PAGE]: pageOf({
+      id: idOf("f"),
+      pageTypeSlug: "module",
+      slug: "lone",
