+test("breaking the glass replaces what the checks refuse, and only breaking it does", async () => {
+  const root = repoWith({ "akasha/one.ts": "alpha\n" })
+  refusing(root)
+  const passage = stating(root, "a", "alpha", "delta")
+  const gated = await replace(["--file-path", "akasha/one.ts", ...passage], checkedIn(root))
+  expect(gated.code).toBe(3)
+  expect(gated.refusals.join(" ")).toContain("refused for the test")
+  expect(bodyOf(root, "akasha/one.ts")).toBe("alpha\n")
+
+  const said = await replace(
+    [
+      "--file-path",
+      "akasha/one.ts",
+      ...passage,
+      "--message",
+      "one goes",
+      "--break-the-glass",
+      "the check is wrong",
+    ],
+    checkedIn(root)
+  )
+  expect(said.refusals).toEqual([])
+  expect(said.code).toBe(0)
+  expect(said.report.join("\n")).toContain(
+    "no check ran — the glass was broken for: the check is wrong"
+  )
+  expect(bodyOf(root, "akasha/one.ts")).toBe("delta\n")
+  expect(git(root, ["log", "-1", "--pretty=%B"]).trim()).toBe(
+    "one goes\n\nChecks-bypassed: the check is wrong"
+  )
+})
+
+test("breaking the glass twice, or with no reason, is refused", async () => {
+  const root = repoWith({ "akasha/one.ts": "alpha\n" })
+  const said = ["--file-path", "akasha/one.ts", ...stating(root, "a", "alpha", "delta")]
+  const twice = await replace(
+    [...said, "--break-the-glass", "one", "--break-the-glass", "two"],
+    givenIn(root)
+  )
+  expect(twice.code).toBe(1)
+  expect(twice.refusals[0]).toBe("--break-the-glass is given 2 times, and one call bypasses once")
+  const ends = await replace([...said, "--break-the-glass"], givenIn(root))
+  expect(ends.code).toBe(1)
+  expect(ends.refusals[0]).toBe(
+    "--break-the-glass takes the reason no check is to run, and this one is empty"
+  )
+  const empty = await replace([...said, "--break-the-glass", "  "], givenIn(root))
+  expect(empty.refusals[0]).toBe(
+    "--break-the-glass takes the reason no check is to run, and this one is empty"
+  )
+  expect(bodyOf(root, "akasha/one.ts")).toBe("alpha\n")
+})
