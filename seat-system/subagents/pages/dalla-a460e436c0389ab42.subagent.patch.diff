+  renamed(root, ONE, MOVED, TEN)
+  const said = resolved(root, PAGE, MOVED, swapped(TEN, "b", "R"))
+  if ("why" in said) throw new Error(said.why)
+  expect(draftedBody(root, MOVED)).toBe(swapped(TEN, "b", "R"))
+})
