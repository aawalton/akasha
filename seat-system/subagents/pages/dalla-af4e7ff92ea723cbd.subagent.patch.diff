+    namer
+      .replace(`"note": "${HELD_SLUG}"`, `"note": "${CARRIED}"`)
+      .replace(`"module/${HELD_SLUG}"`, `"module/${CARRIED}"`)
+  )
+  expect(bodyIn(said, CARRIED_CODE)).toBe(heldCode)
+  expect(bodyIn(said, NAMER_CODE)).toBe(
