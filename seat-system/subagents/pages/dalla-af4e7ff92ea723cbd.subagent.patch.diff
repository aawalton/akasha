+
+afterAll(scratch.sweep)
+
+const CARRIED = "carried"
+
+const CARRIED_PAGE = "akasha/carried/carried.module.ts"
+
+const CARRIED_CODE = "akasha/carried/carried.module.code.ts"
+
+const OTHER_PAGE = "akasha/three/other-one.module.ts"
+
