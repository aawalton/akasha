+  const said = bodyOf(repointed(HOLDER, HOLDER, CODE, moved))
+  expect(said).toContain('from "../four/other.module.code.ts"')
+  expect(said).toContain('import ts from "typescript"')
+})
+
+test("a body naming nothing that moved comes back as it is", () => {
+  expect(bodyOf(repointed(HOLDER, HOLDER, CODE, new Map()))).toBe(CODE)
+})
+
+test("a body that does not move is answered as a write rather than as a move", () => {
+  const said = repointed(HOLDER, HOLDER, CODE, new Map())
+  expect(said.edits[0]?.path).toBe(HOLDER)
+  expect(said.edits[0]?.was).toBe(CODE)
+  expect(said.edits[0]?.from).toBe(undefined)
