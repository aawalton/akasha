--- /dev/null
+++ b/alan/atlas-web/tsconfig.json
@@ -0,0 +1,38 @@
+{
+  "extends": "../../tsconfig.base.json",
+  "compilerOptions": {
+    "jsx": "react-jsx",
+    "lib": ["dom", "dom.iterable", "esnext"],
+    "types": ["@types/bun", "node", "vite/client"],
+    "rootDirs": [".", "./.react-router/types"],
+    "paths": {
+      "@/*": ["./*"]
+    },
+    "composite": true,
+    "noEmit": false,
+    "emitDeclarationOnly": true,
+    "declarationDir": "dist",
+    "rootDir": "../.."
+  },
+  "include": [
+    "*.ts",
+    "*.tsx",
+    "routes/**/*.ts",
+    "routes/**/*.tsx",
+    "*/*.module.ts",
+    "*/*.module.code.ts",
+    "*/*.module.code.tsx",
+    "*/*.stylesheet.ts",
+    ".server/*/*.module.ts",
+    ".server/*/*.module.code.ts",
+    ".react-router/types/**/*.ts",
+    ".react-router/types/**/*.tsx",
+    ".react-router/types/**/+types/*.ts",
+    "server.ts",
+    "vite.config.ts",
+    "react-router.config.ts",
+    "*.cluster-service.code.attachment.ts",
+    "tunnel-routes.ts"
+  ],
+  "exclude": ["node_modules", "dist", "build"]
+}
