-    if (record.kind === "assistant" && said !== "" && i !== j)
-      trail.push(`said: ${clip(said, TRAIL_TEXT_CHARS)}`)
-    for (const use of record.toolUses)
-      trail.push(
-        `called ${use.name}(${clip(use.input, TRAIL_TOOL_CHARS)}) → ${resultFor(use.id, results)}`
-      )
-  }
