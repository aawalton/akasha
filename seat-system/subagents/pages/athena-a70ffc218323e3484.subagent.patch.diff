diff --git a/commands/modules/name-ordering/name-ordering.module.code.ts b/commands/modules/name-ordering/name-ordering.module.code.ts
new file mode 100644
index 0000000000000000000000000000000000000000..70c199bce7c9d00255504b513cf0baf5c02d55d0
--- /dev/null
+++ b/commands/modules/name-ordering/name-ordering.module.code.ts
@@ -0,0 +1,3 @@
+export function inNameOrder(names: readonly string[]): readonly string[] {
+  return [...names].sort((a, b) => a.localeCompare(b))
+}
diff --git a/commands/modules/name-ordering/name-ordering.module.test.ts b/commands/modules/name-ordering/name-ordering.module.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..027d8b82de697673d36e46e85ac98e93509df827
--- /dev/null
+++ b/commands/modules/name-ordering/name-ordering.module.test.ts
@@ -0,0 +1,16 @@
+import { expect, test } from "bun:test"
+import { inNameOrder } from "./name-ordering.module.code.ts"
+
+test("names are answered in the order the locale sorts them by", () => {
+  expect(inNameOrder(["B", "a", "c"])).toEqual(["a", "B", "c"])
+})
+
+test("the names handed in are left in the order handed in", () => {
+  const said = ["b", "a"]
+  inNameOrder(said)
+  expect(said).toEqual(["b", "a"])
+})
+
+test("a name said twice is answered twice", () => {
+  expect(inNameOrder(["a", "a"])).toEqual(["a", "a"])
+})
