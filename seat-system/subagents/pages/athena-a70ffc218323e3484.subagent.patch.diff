+const NESTED = "TemperNested"
+const NESTED_LEAF = "temper-nested-addon"
+const NESTED_DIR = `akasha/temper/${NESTED_LEAF}`
+
+function fixtureFor(): string {
+  const root = scratch.rootFor("temper-resolve-root-")
