-        INPUT
-      )
-    }
-    toIndex = to
-  } else {
-    const before = held.get(BEFORE)
-    const flag = before !== undefined ? BEFORE : AFTER
-    const anchorId = before ?? held.get(AFTER) ?? ""
-    if (anchorId === id) {
-      return refusing(
