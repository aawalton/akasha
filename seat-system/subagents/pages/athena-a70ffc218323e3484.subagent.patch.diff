+
+const JSON_FLAG = "--json"
+
+const SPACES = 2
+
+const HEADING = "key"
+
+export function temperCatalogList(argv: readonly string[] = []): Answer {
+  const domains = [...CATALOG_DOMAIN_KEYS]
+
+  if (argv.includes(JSON_FLAG)) {
