+  expect(said.code).not.toBe(0)
+  expect(said.refusals.join("\n")).toContain("NotAnAddonHere")
+  expect(said.refusals.join("\n")).toContain("reaches no addon")
+})
+
+test("naming no addon at all is refused", () => {
