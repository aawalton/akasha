+})
+
+test("a domain no root reaches is named in unreached", () => {
+  const circle: readonly DomainRow[] = [
+    { slug: "one", relPath: "one.ts", persona: null, parent: "two", sequence: [] },
+    { slug: "two", relPath: "two.ts", persona: null, parent: "one", sequence: [] },
