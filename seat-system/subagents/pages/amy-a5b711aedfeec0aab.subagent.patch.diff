index 0000000000000000000000000000000000000000..26ba72f25ede4cf16ab6651a4df53ab0bf825340
--- /dev/null
+++ b/readout-system/widget-tap-counting/widget-tap-counting.module.code.ts
@@ -0,0 +1,46 @@
+import { listedAt } from "@akasha/pages/index-reading"
+import { mergeUncommitted, uncommittedIn } from "@akasha/pages/page-uncommitted"
+
+const PAGE_TYPE = "readout-widget"
+
+const TAPS = "taps"
+
+const LAST_TAPPED_AT = "lastTappedAt"
+
+export type Tapped = {
+  readonly taps: number
+  readonly at: string
+}
+
+export function widgetPage(root: string, slug: string): string | null {
+  const listed = listedAt(root, PAGE_TYPE, slug)[0]
+  return listed === undefined ? null : listed.path
+}
+
+export function tapsKept(root: string, page: string): number {
+  const held = uncommittedIn(root, page)
+  if (held === null) return 0
+  const taps = held[TAPS]
+  if (taps === undefined) return 0
+  if (typeof taps !== "number") {
+    throw new Error(
+      `'${page}' sits beside a tap count that is no number, so how often it was tapped is ` +
+        "unknown rather than never"
+    )
+  }
+  return taps
+}
+
+/**
+ * One more tap on the widget at `page`.
+ *
+ * THE COUNT IS READ AND WRITTEN BACK RATHER THAN ADDED TO IN PLACE. Two taps arriving together read
+ * the same count and write the same count back, so one of the two is lost. Alan reads this number to
+ * tell a widget he uses from one he leaves alone, and that reading survives a tap going missing.
+ */
+export function countTap(root: string, page: string, at: Date): Tapped {
+  const taps = tapsKept(root, page) + 1
+  const moment = at.toISOString()
+  mergeUncommitted(root, page, { [TAPS]: taps, [LAST_TAPPED_AT]: moment })
+  return { taps, at: moment }
+}
diff --git a/readout-system/widget-tap-counting/widget-tap-counting.module.test.ts b/readout-system/widget-tap-counting/widget-tap-counting.module.test.ts
