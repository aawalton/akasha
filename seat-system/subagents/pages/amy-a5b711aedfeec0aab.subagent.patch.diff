+++ b/readout-system/widget-tap-counting/widget-tap-counting.module.test.ts
@@ -0,0 +1,49 @@
+import { afterAll, expect, test } from "bun:test"
+import { scratchWorld } from "@akasha/command-system/scratching"
+import { akashaRoot } from "@akasha/pages/checkout-roots"
+import { mergeUncommitted } from "@akasha/pages/page-uncommitted"
+import { countTap, tapsKept, widgetPage } from "./widget-tap-counting.module.code.ts"
+
+const PAGE = "akasha/readout-system/readout-widgets/pages/alanwalton-surplus.readout-widget.ts"
+
+const TAPPED = "2026-09-06T12:00:00.000Z"
+
+const scratch = scratchWorld()
+
+afterAll(() => scratch.sweep())
+
+test("a widget with nothing beside it has taken no tap", () => {
+  expect(tapsKept(scratch.rootFor("widget-tap-counting-"), PAGE)).toBe(0)
+})
+
+test("a tap counted is the tap read back", () => {
+  const root = scratch.rootFor("widget-tap-counting-")
+  expect(countTap(root, PAGE, new Date(TAPPED))).toEqual({ taps: 1, at: TAPPED })
+  expect(tapsKept(root, PAGE)).toBe(1)
+})
+
+test("a tap adds to the taps counted before it", () => {
+  const root = scratch.rootFor("widget-tap-counting-")
+  countTap(root, PAGE, new Date(TAPPED))
+  countTap(root, PAGE, new Date(TAPPED))
+  expect(countTap(root, PAGE, new Date("2026-09-06T12:05:00.000Z"))).toEqual({
+    taps: 3,
+    at: "2026-09-06T12:05:00.000Z",
+  })
+})
+
+test("a count that is no number is refused rather than read as no tap", () => {
+  const root = scratch.rootFor("widget-tap-counting-")
+  mergeUncommitted(root, PAGE, { taps: "many" })
+  expect(() => tapsKept(root, PAGE)).toThrow()
+})
+
+test("a widget slug answers the page carrying that slug", () => {
+  expect(widgetPage(akashaRoot(), "alanwalton-surplus")).toBe(
+    "readout-system/readout-widgets/pages/alanwalton-surplus.readout-widget.ts"
+  )
+})
+
+test("a slug no widget page carries answers with no path", () => {
+  expect(widgetPage(akashaRoot(), "no-such-widget")).toBeNull()
+})
diff --git a/readout-system/widget-tap-link/widget-tap-link.module.code.ts b/readout-system/widget-tap-link/widget-tap-link.module.code.ts
