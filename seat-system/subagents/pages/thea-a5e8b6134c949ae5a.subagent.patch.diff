+
+test("a file no page claims is carried to a new name and no slug is renamed", async () => {
+  const root = plainWorld()
+  const said = await move(["--from", PLAIN, "--to", PLAIN_AT], givenIn(root))
+  expect(said.refusals).toEqual([])
+  expect(said.code).toBe(0)
+  expect(there(root, PLAIN)).toBe(false)
+  expect(bodyIn(root, PLAIN_AT)).toBe(PLAIN_BODY)
+  expect(told(said)).toContain(`${PLAIN} moved to ${PLAIN_AT}`)
+  expect(told(said)).not.toContain("renamed from the slug")
+})
+
+test("a file a page claims beside it is refused a new name", async () => {
+  const root = sidecarWorld()
+  const said = await move(["--from", HOLDER, "--to", CLAIMED_AT], givenIn(root))
+  expect(said.code).toBe(1)
+  expect(why(said)).toContain(`${HOLDER} is a file \`${HELD}\` claims beside it`)
+  expect(there(root, HOLDER)).toBe(true)
+  expect(there(root, CLAIMED_AT)).toBe(false)
+})
+
+test("a file no page claims carries no sibling that merely shares its stem", async () => {
+  const root = stemWorld()
+  const said = await move(["--from", STEM, "--to", STEM_AT], givenIn(root))
+  expect(said.refusals).toEqual([])
+  expect(there(root, STEM_AT)).toBe(true)
+  expect(there(root, STEM_SIBLING)).toBe(true)
+  expect(there(root, STEM_SIBLING_AT)).toBe(false)
+  expect(told(said)).not.toContain("beside what you named")
+})
