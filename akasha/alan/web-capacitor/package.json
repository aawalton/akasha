{
  "name": "@akasha/alanwalton-web-capacitor",
  "description": "A second react-router app over the same site as @akasha/alanwalton-web, built ssr:false so the whole route tree runs from the native shell's www root with no server. react-router resolves an app root to the nearest ancestor package.json, so a separate manifest is what keeps this build from taking the SSR route tree of the package beside it.",
  "functionalType": "service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "typecheck": "react-router typegen && bunx @typescript/native-preview -b",
    "check": "react-router typegen && bunx @typescript/native-preview -b",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "dependencies": {
    "@akasha/alanwalton-web": "workspace:*",
    "@akasha/chess-core": "workspace:*",
    "@akasha/design-layout": "workspace:*",
    "@akasha/design-patterns": "workspace:*",
    "@akasha/design-primitives": "workspace:*",
    "@akasha/design-system": "workspace:*",
    "@akasha/errors-client": "workspace:*",
    "@akasha/pages-core": "workspace:*",
    "@akasha/pages-ui": "workspace:*",
    "@akasha/pages-ui-components": "workspace:*",
    "@akasha/pages-ui-store": "workspace:*",
    "@akasha/pages-url": "workspace:*",
    "@akasha/supabase-rr": "workspace:*",
    "@akasha/utils-narrow": "workspace:*",
    "@akasha/web-build-version": "workspace:*",
    "@fontsource-variable/literata": "^5.2.5",
    "lucide-react": "^0.576.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router": "7.15.1",
    "tailwindcss": "^4.1.9"
  },
  "devDependencies": {
    "@react-router/dev": "7.15.1",
    "@tailwindcss/vite": "^4.1.9",
    "@types/bun": "^1.3.9",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5.8.3",
    "vite": "^8.0.3"
  },
  "sideEffects": [
    "*.css"
  ]
}
