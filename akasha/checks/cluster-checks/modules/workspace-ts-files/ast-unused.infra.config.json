{
  "workspaces": {
    "infra/git-cli": {
      "entry": [
        "**/*.test.{ts,tsx}"
      ],
      "project": [
        "**/*.ts"
      ]
    },
    "infra/git-porcelain": {
      "entry": [
        "**/*.test.{ts,tsx}"
      ],
      "project": [
        "**/*.ts"
      ]
    },
    "infra/git-transport": {
      "entry": [
        "**/*.test.{ts,tsx}",
        "src/server.ts"
      ],
      "project": [
        "**/*.ts"
      ]
    },
    "infra/k8s-synth": {
      "entry": [
        "**/*.test.{ts,tsx}",
        "src/manifests.ts"
      ],
      "project": [
        "**/*.ts"
      ]
    },
    "infra/scripts": {
      "entry": [
        "**/*.test.{ts,tsx}",
        "migrations/**/*.ts",
        "src/clean-stale-folders.ts",
        "src/docs-validator/export.ts",
        "src/install.ts",
        "src/verify-workspace-bins.ts"
      ],
      "project": [
        "**/*.ts"
      ]
    }
  }
}
