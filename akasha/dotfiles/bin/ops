#!/usr/bin/env bash
#
# The `ops` name on PATH, resolving into the repository the dispatcher stands in.
#
# The dispatcher stands at `akasha/command-system/ops-calling/ops-calling.module.code.ts`, inside
# the akasha folder itself, so a change to what `ops` says or refuses is live on the commit that
# makes it, with no build and no deploy in between. This file is the only part of the name that
# lives outside that folder, and it does nothing but name it: an akasha file imports nothing from
# out here.
#
# It named `tools/ops/cli.ts` until 2026-09-03. That dispatcher read its commands off two lists —
# the `ops-command` pages and a scan of the `tools/commands` folder — and the one inside akasha
# reads the pages alone. The two lists agreed exactly, 15 files against 15 pages, when the scan
# was retired, so no command's words and no command's routing changed with the name.

set -euo pipefail

dispatcher="${AKASHA_ROOT:-$HOME/repos/akasha}/akasha/command-system/ops-calling/ops-calling.module.code.ts"

if [[ ! -f $dispatcher ]]; then
  echo "ops: no dispatcher at $dispatcher — set AKASHA_ROOT to an akasha checkout" >&2
  exit 70
fi

exec bun "$dispatcher" "$@"
