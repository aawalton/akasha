{"id":"01a0657e-133e-7c6a-a9d8-ea2e85cd70d5","chapterSlug":"rwInterlude - Numbtongue (Pt-1)","paragraph":27,"wording":"[Blackguard]","event":"named","holderSlug":"blackguard","holderQuote":"[Blackguard]."}
