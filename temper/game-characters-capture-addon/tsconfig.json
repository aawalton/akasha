{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": [
      "ESNext"
    ],
    "types": [],
    "jsx": "react",
    "noEmit": true,
    "rewriteRelativeImportExtensions": true,
    "isolatedModules": true,
    "rootDir": "../..",
    "target": "ESNext",
    "strict": true
  },
  "include": [
    "src/**/*.ts",
    "../../akasha/temper/temper-eso-types/**/*.d.ts"
  ],
  "tstl": {
    "luaTarget": "5.1",
    "luaLibImport": "require-minimal",
    "noResolvePaths": [],
    "noImplicitSelf": true
  }
}
