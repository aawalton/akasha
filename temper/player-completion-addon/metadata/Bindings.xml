<Bindings>
  <Layer name="SI_KEYBINDINGS_LAYER_GENERAL">
    <Category name="SI_KEYBINDINGS_CATEGORY_TEMPER">
      <Action name="TEMPER_TOGGLE_WINDOW">
        <Down>TemperCharacters.ToggleWindow()</Down>
      </Action>
    </Category>
    <!-- Folded-in Skill Points window (#15141): the category LABEL is rebranded from
         USPF, but the USPF_TOGGLE action + byte-identical USPF:ToggleWindow() dispatch
         are kept as their own category so the XML/Bindings-hardwired keybind identity
         is preserved (internal USPF_* symbols are published contracts, not renamed). -->
    <Category name="Temper Completion — Skill Points">
      <Action name="USPF_TOGGLE">
        <Up>USPF:ToggleWindow()</Up>
      </Action>
    </Category>
  </Layer>
</Bindings>
