    { "abilityId": 197652, "kind": "vision", "name": "Hearty Vitality", "description": "You feel full of life!\n\nMax Health increased by |cffffff6|r% per stack.\n\nCurrent Bonus: |cffffff12|r%", "stacks": 2 },
    { "abilityId": 199990, "kind": "vision", "name": "Ferocious Fortification", "description": "Your skin toughens as you prepare for battle!\n\nPhysical and Bleed Damage taken decreased by |cffffff10|r%.\n\n|cFFFFFFPART OF THE FEROCIOUS SET (|r|cffffff2|r|cFFFFFF/3 VISIONS)|r\nWhen you acquire |cFFFFFF3|r Ferocious Visions you gain access to the Werewolf Behemoth Offensive Verse.", "stacks": 1 },
    { "abilityId": 200679, "kind": "vision", "name": "Scorching Strikes", "description": "The power of a forge waits at your fingertips!\n\nDamage dealt by Fire attacks increased by |cffffff20|r%.\n\n|cFFFFFFPART OF THE SCORCHING SET (|r|cffffff1|r|cFFFFFF/3 VISIONS)|r\nWhen you acquire |cFFFFFF3|r unique Scorching Visions you gain access to the Iron Atronach Utility Verse.", "stacks": 1 },
    { "abilityId": 201400, "kind": "vision", "name": "Archival Intelligence", "description": "Your magic recovery rate grows.\n\nMagicka Recovery increased by |cffffff31|r% per stack.\n\nCurrent Bonus: |cffffff31|r%", "stacks": 1 },
    { "abilityId": 201443, "kind": "vision", "name": "Extended Favor", "description": "Your major and minor effects last longer.\n\nMajor and Minor effect durations increased by |cffffff62|r% per stack.\n\nCurrent Bonus: |cffffff62|r%", "stacks": 1 },
    { "abilityId": 202743, "kind": "vision", "name": "Ferocious Support", "description": "Your enemies bleed with every attack!\n\nHeavy Attacks cause enemies to bleed for |cffffff63371|r Bleed Damage over |cffffff6|r seconds.\n\n|cFFFFFFPART OF THE FEROCIOUS SET (|r|cffffff2|r|cFFFFFF/3 VISIONS)|r\nWhen you acquire |cFFFFFF3|r unique Ferocious Visions you gain access to the Werewolf Behemoth Offensive Verse.", "stacks": 1 },
    { "abilityId": 220563, "kind": "vision", "name": "Necrotic Strikes", "description": "The creeping power of undeath is at your disposal!\n\nDamage dealt by Magic attacks increased by |cffffff20|r%.\n\n|cFFFFFFPART OF THE NECROTIC SET (|r|cffffff1|r|cFFFFFF/3 VISIONS)|r\nWhen you acquire |cFFFFFF3|r unique Necrotic Visions you gain access to the Undead Avatar Offensive Verse.", "stacks": 1 },
    { "abilityId": 220770, "kind": "vision", "name": "Prickly Retort", "description": "Redirect blows back at their attacker!\n\nEnemies within |cffffff15|r meters that deal direct damage to you are dealt |cffffff7045|r Physical Damage. \n\nDamage is increased by |cffffff30|r% per stack.\n\nCurrent Bonus: |cffffff30|r%", "stacks": 1 },
