{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@/components/*": [
        "./app/components/*"
      ],
      "@/hooks/*": [
        "./app/hooks/*"
      ],
      "@/lib/next-seam-adapters": [
        "./app/bridge/lib/next-seam-adapters.tsx"
      ],
      "@/lib/*": [
        "./app/lib/*"
      ],
      "@/app/characters/import-actions": [
        "./app/bridge/app/characters/import-actions.ts"
      ],
      "@/app/companions/import-actions": [
        "./app/bridge/app/companions/import-actions.ts"
      ],
      "@/app/*": [
        "./app/bridge/app/*"
      ],
      "@/*": [
        "./*"
      ],
      "~/*": [
        "./app/*"
      ]
    },
    "jsx": "react-jsx",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "types": [
      "@types/bun",
      "node",
      "vite/client"
    ],
    "rootDirs": [
      ".",
      "./.react-router/types"
    ],
    "composite": true,
    "emitDeclarationOnly": true
  },
  "references": [
    {
