{
  "extends": "../addons/tsconfig.base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "rootDir": "..",
    "target": "ESNext",
    "strict": true,
    "noEmit": true,
    "types": []
  },
  "tstl": {
    "luaTarget": "5.1",
    "luaLibImport": "require-minimal",
    "noImplicitSelf": true
  },
  "include": [
    "src/**/*.ts",
    "../shared-build-deploy-addons/types/eso/**/*.d.ts"
  ],
  "exclude": [
    "src/**/*.test.ts"
  ]
}
