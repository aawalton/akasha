<Bindings>
	<Layer name="SI_KEYBINDINGS_LAYER_GENERAL">
		<Category name="SI_KEYBINDINGS_CATEGORY_TEMPER">
			<Action name="TEMPER_COMBAT_REPORT_TOGGLE">
				<Up>TemperCombat_Report:Toggle()</Up>
			</Action>
			<Action name="TEMPER_COMBAT_POST_DPS">
				<Up>TemperCombat.PosttoChat(TEMPER_COMBAT_POSTTOCHAT_MODE_SINGLEANDMULTI)</Up>
			</Action>
			<Action name="TEMPER_COMBAT_POST_DPS_SMART">
				<Up>TemperCombat.PosttoChat(TEMPER_COMBAT_POSTTOCHAT_MODE_SMART)</Up>
			</Action>
			<Action name="TEMPER_COMBAT_POST_DPS_SINGLE">
				<Up>TemperCombat.PosttoChat(TEMPER_COMBAT_POSTTOCHAT_MODE_SINGLE)</Up>
			</Action>
			<Action name="TEMPER_COMBAT_POST_DPS_MULTI">
				<Up>TemperCombat.PosttoChat(TEMPER_COMBAT_POSTTOCHAT_MODE_MULTI)</Up>
			</Action>
			<Action name="TEMPER_COMBAT_POST_HPS">
				<Up>TemperCombat.PosttoChat(TEMPER_COMBAT_POSTTOCHAT_MODE_HEALING)</Up>
			</Action>
			<Action name="TEMPER_COMBAT_RESET_FIGHT">
				<Up>TemperCombat.ResetFight()</Up>
			</Action>
			<Action name="TEMPER_COMBAT_LIVEREPORT_TOGGLE">
				<Up>TemperCombat_LiveReport:Toggle()</Up>
			</Action>
		</Category>
	</Layer>
</Bindings>
