{
  "extends": "../addons/tsconfig.base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "rootDir": "../..",
    "outDir": "../addons/dist/LibMainMenu-2.0",
    "target": "ESNext",
    "strict": true,
    "types": []
  },
  "tstl": {
    "luaTarget": "5.1",
    "luaBundle": "LibMainMenu-2.0.lua",
    "luaBundleEntry": "./src/main.ts",
    "luaLibImport": "require-minimal",
    "noImplicitSelf": true
  },
  "include": ["src/**/*.ts", "../addons/types/eso/**/*.d.ts"],
  "exclude": ["src/**/*.test.ts"]
}
