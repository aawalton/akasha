<Bindings>
	<Layer name="SI_KEYBINDINGS_LAYER_GENERAL">
		<Category name="SI_KEYBINDINGS_CATEGORY_TEMPER_MINIMAP">
			<Action name="VOTANS_TOGGLE_MAP_SHOW">
				<Down>TemperWorldMiniMap:ToggleShowMap()</Down>
			</Action>
			<Action name="VOTANS_TOGGLE_MAP_SHOW_HUD">
				<Down>TemperWorldMiniMap:ToggleShowHUD()</Down>
			</Action>
			<Action name="VOTANS_TOGGLE_MAP_SHOW_COMBAT">
				<Down>TemperWorldMiniMap:ToggleShowCombat()</Down>
			</Action>
			<Action name="VOTANS_TOGGLE_MAP_ZOOM_OUT">
				<Down>TemperWorldMiniMap:ToogleZoom(true, TemperWorldMiniMap.account.zoomOut)</Down>
				<Up>TemperWorldMiniMap:ToogleZoom(false)</Up>
			</Action>
			<Action name="VOTANS_TOGGLE_MAP_ZOOM_IN">
				<Down>TemperWorldMiniMap:ToogleZoom(true, TemperWorldMiniMap.account.zoomIn)</Down>
				<Up>TemperWorldMiniMap:ToogleZoom(false)</Up>
			</Action>
			<Action name="VOTANS_TOGGLE_MAP_ZOOM_PLUS">
				<Down>TemperWorldMiniMap:StepZoom(true)</Down>
			</Action>
			<Action name="VOTANS_TOGGLE_MAP_ZOOM_MINUS">
				<Down>TemperWorldMiniMap:StepZoom(false)</Down>
			</Action>
			<Action name="VOTANS_TOGGLE_MAP_OFFSET_FIX">
				<Down>TemperWorldMiniMap:ToggleFixedOffset()</Down>
			</Action>
		</Category>
		<Category name="Temper Leads">
			<Action name="TOGGLE_TEMPER_LEADS">
				<Down>TemperWorld.toggleRDL()</Down>
			</Action>
		</Category>
		<Category name="|cFFD700More Markers|r">
			<Action name="M0RMARKERS_TOGGLE_QUICK_MENU">
				<Down>TemperWorld.Markers.toggleQuickMenu()</Down>
			</Action>
			<Action name="M0RMARKERS_PLACE_MARKER">
				<Down>TemperWorld.Markers.placeIcon()</Down>
			</Action>
			<Action name="M0RMARKERS_PLACE_QUICK_MARKER">
				<Down>TemperWorld.Markers.placeQuickMenuIcon()</Down>
			</Action>
			<Action name="M0RMARKERS_PLACE_QUICK_MARKER_CURSOR">
				<Down>TemperWorld.Markers.placeQuickMenuIconAtCursor()</Down>
			</Action>
			<Action name="M0RMARKERS_REMOVE_MARKER">
				<Down>TemperWorld.Markers.removeClosestIcon()</Down>
			</Action>
			<Action name="M0RMARKERS_REMOVE_MARKER_CURSOR">
				<Down>TemperWorld.Markers.removeIconAtCursor()</Down>
			</Action>
			<Action name="M0RMARKERS_PLACE_TEMP_MARKER">
				<Down>TemperWorld.Markers.sendTempMarker()</Down>
			</Action>
		</Category>
		<Category name="SI_KEYBINDINGS_CATEGORY_TEMPER_JOURNAL">
			<Action name="EXTENDED_JOURNAL">
				<Down>TemperWorld.ShowJournal()</Down>
			</Action>
			<Action name="ITEMBROWSER">
				<Down>TemperWorld.ShowItemBrowser()</Down>
			</Action>
		</Category>
	</Layer>
	<Layer name="SI_KEYBINDINGS_LAYER_SIEGE" allowFallthrough="false">
		<Category name="SI_KEYBINDINGS_CATEGORY_TEMPER_MINIMAP">
			<Action name="VOTANS_TOGGLE_MAP_SHOW_SIEGE_HUD">
				<Down>TemperWorldMiniMap:ToggleShowSiege()</Down>
			</Action>
			<Action name="VOTANS_TOGGLE_MAP_ZOOM_OUT_SIEGE" hideAction="true" inheritsBindFrom="VOTANS_TOGGLE_MAP_ZOOM_OUT">
				<Down>TemperWorldMiniMap:ToogleZoom(true, TemperWorldMiniMap.account.zoomOut)</Down>
				<Up>TemperWorldMiniMap:ToogleZoom(false)</Up>
			</Action>
			<Action name="VOTANS_TOGGLE_MAP_ZOOM_IN_SIEGE" hideAction="true" inheritsBindFrom="VOTANS_TOGGLE_MAP_ZOOM_IN">
				<Down>TemperWorldMiniMap:ToogleZoom(true, TemperWorldMiniMap.account.zoomIn)</Down>
				<Up>TemperWorldMiniMap:ToogleZoom(false)</Up>
			</Action>
			<Action name="VOTANS_TOGGLE_MAP_ZOOM_PLUS_SIEGE" hideAction="true" inheritsBindFrom="VOTANS_TOGGLE_MAP_ZOOM_PLUS">
				<Down>TemperWorldMiniMap:StepZoom(true)</Down>
			</Action>
			<Action name="VOTANS_TOGGLE_MAP_ZOOM_MINUS_SIEGE" hideAction="true" inheritsBindFrom="VOTANS_TOGGLE_MAP_ZOOM_MINUS">
				<Down>TemperWorldMiniMap:StepZoom(false)</Down>
			</Action>
		</Category>
	</Layer>
</Bindings>
