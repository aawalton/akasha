<GuiXml>
    <Controls>
        <TopLevelControl name="TemperLeadsMainWindow" hidden="true" mouseEnabled="true" movable="true" clampedToScreen="false">
            <Anchor point="BOTTOM" relativeTo="GuiRoot" relativePoint="BOTTOM" offsetX="0" offsetY="-128"/>
            <Dimensions x="1260" y="800" />

			<Controls>
                <Backdrop name="$(parent)BG" inherits="ZO_ThinBackdrop" edgeColor="88FFFFFF"/>
				<Control name="$(parent)Title">
					<Anchor point="TOPLEFT" />
                    <Anchor point="TOPRIGHT" />
					<Dimensions y="30" />
					<Controls>
						<Label name="$(parent)Alerts" font="ZoFontGameLarge" color="FA5252" wrapMode="ELLIPSIS"  mouseEnabled="true" text="Alerts">
							<Anchor point="TOPLEFT" relativeTo="$(parent)" relativePoint="TOPLEFT" offsetX="17" offsetY="7"/>
							<Dimensions x="220" y="28" />
							<OnMouseEnter>
								TemperWorldLeads.AlertsMouseEnter(self)
							</OnMouseEnter>
							<OnMouseExit>
								TemperWorldLeads.AlertsMouseExit(self)
							</OnMouseExit>
						</Label>
						<Control name="TemperLeads_DropdownMajor" inherits="ZO_ScrollableComboBox" mouseEnabled="true" >
							<Anchor point="TOPLEFT"   relativeTo="$(parent)Alerts" relativePoint="TOPRIGHT" offsetX="15" offsetY="-2"/>
							<Dimensions x="275" y="28" />
							<OnShow>    TemperWorldLeads.SetupDropdown(self)</OnShow>
							<OnMouseEnter>  TemperWorldLeads.DropdownShowTooltip(self, "major", true)</OnMouseEnter>
							<OnMouseExit>  TemperWorldLeads.DropdownHideTooltip(self)</OnMouseExit>
						</Control>
						<Control name="TemperLeads_DropdownZone" inherits="ZO_ScrollableComboBox" mouseEnabled="true" >
							<Anchor point="TOPLEFT"   relativeTo="TemperLeads_DropdownMajor" relativePoint="TOPRIGHT" offsetX="69"/>
							<Dimensions x="274" y="28" />
							<OnShow>    TemperWorldLeads.SetupDropdown(self)</OnShow>
							<OnMouseEnter>  TemperWorldLeads.DropdownShowTooltip(self, "zone", true)</OnMouseEnter>
							<OnMouseExit>  TemperWorldLeads.DropdownHideTooltip(self)</OnMouseExit>
						</Control>
						<Control name="TemperLeads_DropdownSetType" inherits="ZO_ScrollableComboBox" mouseEnabled="true">
							<Anchor point="TOPLEFT"   relativeTo="TemperLeads_DropdownZone" relativePoint="TOPRIGHT" offsetX="69"/>
							<Dimensions x="275" y="28" />
							<OnShow>    TemperWorldLeads.SetupDropdown(self)</OnShow>
							<OnMouseEnter>  TemperWorldLeads.DropdownShowTooltip(self, "settype", true)</OnMouseEnter>
							<OnMouseExit>  TemperWorldLeads.DropdownHideTooltip(self)</OnMouseExit>
						</Control>
						<Button name="$(parent)Close">
                            <Anchor point="TOPRIGHT"  offsetX="-5" offsetY="5"/>
                            <OnClicked>TemperWorldLeads.toggleRDL()</OnClicked>
                            <Dimensions x="25" y="25" />
                            <Textures normal="/esoui/art/buttons/decline_up.dds" pressed="/esoui/art/buttons/decline_down.dds" mouseOver="/esoui/art/buttons/decline_over.dds" />
                        </Button>
					</Controls>
                </Control>
				<Control name="$(parent)Location">
					<Anchor point="TOPLEFT"  relativeTo="$(parent)Title" relativePoint="BOTTOMLEFT" offsetX="10" offsetY="0"/>
					<Dimensions y="30" />
					<Controls>
						<Backdrop name="$(parent)LocationEditBackdrop" inherits="ZO_MultiLineEditBackdrop_Keyboard" alpha="1.0" centerColor="77777766" edgeColor="88FFFFFF">
							<Edge edgeSize="1"/>
							<Anchor point="TOPLEFT" relativeTo="$(parent)" relativePoint="TOPLEFT" offsetX="7" offsetY="7"/>
							<Dimensions x="960" y="28"/>
							<Controls>
								<EditBox name="TemperLeadsLocationBox"  inherits="ZO_DefaultEditForBackdrop" ZO_EditDefaultText="" maxInputCharacters="300">
									<OnMouseEnter>
										TemperWorldLeads.LocationBoxMouseEnter(self)
									</OnMouseEnter>
									<OnMouseExit>
										TemperWorldLeads.LocationBoxMouseExit(self)
									</OnMouseExit>
								</EditBox>
							</Controls>
						</Backdrop>
					</Controls>
                </Control>
                <Control name="$(parent)Headers">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Location" relativePoint="BOTTOMLEFT" offsetX="10" offsetY="2"/>
                    <Dimensions y="32" />
                    <Controls>

                        <Control name="$(parent)Lead" inherits="ZO_SortHeader">
                            <OnInitialized>
                                ZO_SortHeader_Initialize(self, TemperWorldLeads.SORTHEADER_NAMES[1], "Lead", ZO_SORT_ORDER_UP, TEXT_ALIGN_LEFT, "ZoFontGameLargeBold")
                           </OnInitialized>
							<OnMouseEnter>
								TemperWorldLeads.HeaderMouseEnter(self, 1)
							</OnMouseEnter>
							<OnMouseExit>
								TemperWorldLeads.HeaderMouseExit(self, 1)
							</OnMouseExit>
                            <Anchor point="TOPLEFT" />
                            <Dimensions x="300" y="32" />
                        </Control>
                        <Control name="$(parent)Zone" inherits="ZO_SortHeader">
                            <OnInitialized>
                                ZO_SortHeader_Initialize(self, TemperWorldLeads.SORTHEADER_NAMES[2], "Zone", ZO_SORT_ORDER_UP, TEXT_ALIGN_LEFT, "ZoFontGameLargeBold")
                           </OnInitialized>
							<OnMouseEnter>
								TemperWorldLeads.HeaderMouseEnter(self, 2)
							</OnMouseEnter>
							<OnMouseExit>
								TemperWorldLeads.HeaderMouseExit(self, 2)
							</OnMouseExit>
                            <Anchor point="TOPLEFT" relativeTo="$(parent)Lead" relativePoint="TOPRIGHT"/>
                            <Dimensions x="170" y="32" />
                        </Control>
                       <Control name="$(parent)Location" inherits="ZO_SortHeader">
                            <OnInitialized>
                                ZO_SortHeader_Initialize(self, TemperWorldLeads.SORTHEADER_NAMES[3], "Location", ZO_SORT_ORDER_UP, TEXT_ALIGN_LEFT, "ZoFontGameLargeBold")
                           </OnInitialized>
							<OnMouseEnter>
								TemperWorldLeads.HeaderMouseEnter(self, 3)
							</OnMouseEnter>
							<OnMouseExit>
								TemperWorldLeads.HeaderMouseExit(self, 3)
							</OnMouseExit>
                            <Anchor point="TOPLEFT" relativeTo="$(parent)Zone" relativePoint="TOPRIGHT"/>
                            <Dimensions x="220" y="32" />
                        </Control>
						<Control name="$(parent)Diff" inherits="ZO_SortHeader">
                            <OnInitialized>
                                ZO_SortHeader_Initialize(self, TemperWorldLeads.SORTHEADER_NAMES[4], "Diff", ZO_SORT_ORDER_UP, TEXT_ALIGN_LEFT, "ZoFontGameLargeBold")
                           </OnInitialized>
							<OnMouseEnter>
								TemperWorldLeads.HeaderMouseEnter(self, 4)
							</OnMouseEnter>
							<OnMouseExit>
								TemperWorldLeads.HeaderMouseExit(self, 4)
							</OnMouseExit>
                            <Anchor point="TOPLEFT" relativeTo="$(parent)Location" relativePoint="TOPRIGHT" />
                            <Dimensions x="64" y="32" />
                        </Control>
						<Control name="$(parent)Lore" inherits="ZO_SortHeader">
                            <OnInitialized>
                                ZO_SortHeader_Initialize(self, TemperWorldLeads.SORTHEADER_NAMES[5], "Lore", ZO_SORT_ORDER_UP, TEXT_ALIGN_LEFT, "ZoFontGameLargeBold")
                           </OnInitialized>
							<OnMouseEnter>
								TemperWorldLeads.HeaderMouseEnter(self, 5)
							</OnMouseEnter>
							<OnMouseExit>
								TemperWorldLeads.HeaderMouseExit(self, 5)
							</OnMouseExit>
                            <Anchor point="TOPLEFT" relativeTo="$(parent)Diff" relativePoint="TOPRIGHT" />
                            <Dimensions x="64" y="32" />
                        </Control>
						<Control name="$(parent)Dug" inherits="ZO_SortHeader">
                            <OnInitialized>
                                ZO_SortHeader_Initialize(self, TemperWorldLeads.SORTHEADER_NAMES[6], "Dug", ZO_SORT_ORDER_UP, TEXT_ALIGN_LEFT, "ZoFontGameLargeBold")
                           </OnInitialized>
							<OnMouseEnter>
								TemperWorldLeads.HeaderMouseEnter(self, 6)
							</OnMouseEnter>
							<OnMouseExit>
								TemperWorldLeads.HeaderMouseExit(self, 6)
							</OnMouseExit>
                            <Anchor point="TOPLEFT" relativeTo="$(parent)Lore" relativePoint="TOPRIGHT" />
                            <Dimensions x="64" y="32" />
                        </Control>
						<Control name="$(parent)Set" inherits="ZO_SortHeader">
                            <OnInitialized>
                                ZO_SortHeader_Initialize(self, TemperWorldLeads.SORTHEADER_NAMES[7], "Set", ZO_SORT_ORDER_UP, TEXT_ALIGN_LEFT, "ZoFontGameLargeBold")
                            </OnInitialized>
							<OnMouseEnter>
								TemperWorldLeads.HeaderMouseEnter(self, 7)
							</OnMouseEnter>
							<OnMouseExit>
								TemperWorldLeads.HeaderMouseExit(self, 7)
							</OnMouseExit>
                            <Anchor point="TOPLEFT" relativeTo="$(parent)Dug" relativePoint="TOPRIGHT" />
                            <Dimensions x="220" y="32" />
                        </Control>
                        <Control name="$(parent)Expiration" inherits="ZO_SortHeader">
                            <OnInitialized>
                                ZO_SortHeader_Initialize(self, TemperWorldLeads.SORTHEADER_NAMES[8], "Expiration", ZO_SORT_ORDER_UP, TEXT_ALIGN_LEFT, "ZoFontGameLargeBold")
                            </OnInitialized>
							<OnMouseEnter>
								TemperWorldLeads.HeaderMouseEnter(self, 8)
							</OnMouseEnter>
							<OnMouseExit>
								TemperWorldLeads.HeaderMouseExit(self, 8)
							</OnMouseExit>
                            <Anchor point="TOPLEFT" relativeTo="$(parent)Set" relativePoint="TOPRIGHT" />
                            <Dimensions x="110" y="32" />
                        </Control>
                    </Controls>
                </Control>
                <Control name="$(parent)List" inherits="ZO_ScrollList">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Headers" relativePoint="BOTTOMLEFT" />
                    <Anchor point="BOTTOMRIGHT" offsetX="-12" offsetY="-12" />
                </Control>
            </Controls>
        </TopLevelControl>
        <Button name="TemperLeadsUnitRow" virtual="true">
            <Dimensions y="30" />
            <Anchor point="RIGHT" relativeTo="$(parent)" />
            <OnMouseEnter>
                TemperWorldLeads.RowMouseEnter(self)
            </OnMouseEnter>
            <OnMouseExit>
                TemperWorldLeads.RowMouseExit(self)
            </OnMouseExit>
			<OnMouseUp>
				TemperWorldLeads.RowMouseUp(self)
			</OnMouseUp>
            <Controls>
                <Label name="$(parent)Lead" font="ZoFontWinH4" wrapMode="ELLIPSIS">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)" />
                    <Dimensions x="300" y="32" />
                </Label>
                <Label name="$(parent)Zone" font="ZoFontWinH4" wrapMode="ELLIPSIS">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Lead" relativePoint="TOPRIGHT" />
                    <Dimensions x="170" y="32" />
                </Label>
                <Label name="$(parent)Location" font="ZoFontWinH4" wrapMode="ELLIPSIS">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Zone" relativePoint="TOPRIGHT" />
                    <Dimensions x="220" y="32" />
                </Label>
				<Label name="$(parent)Diff" font="ZoFontWinH4" wrapMode="ELLIPSIS">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Location"  relativePoint="TOPRIGHT" />
                    <Dimensions x="64" y="32" />
                </Label>
                <Label name="$(parent)Lore" font="ZoFontWinH4" wrapMode="ELLIPSIS">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Diff" relativePoint="TOPRIGHT" />
                    <Dimensions x="64" y="32" />
                </Label>
				<Label name="$(parent)Dug" font="ZoFontWinH4" wrapMode="ELLIPSIS">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Lore" relativePoint="TOPRIGHT" />
                    <Dimensions x="64" y="32" />
                </Label>
                <Label name="$(parent)Set" font="ZoFontWinH4" wrapMode="ELLIPSIS">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Dug"  relativePoint="TOPRIGHT" />
                    <Dimensions x="220" y="32" />
                </Label>
				<Label name="$(parent)Expiration" font="ZoFontWinH4" wrapMode="ELLIPSIS">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Set" relativePoint="TOPRIGHT" />
                    <Dimensions x="110" y="32" />
                </Label>
            </Controls>
        </Button>
    </Controls>
</GuiXml>
