<?xml version="1.0" encoding="utf-8"?>
<GuiXml>
    <Animations>
        <AnimationTimeline name="TemperCharactersPithka_LabelPulseAnimation" playbackType="PING_PONG" loopCount="LOOP_INDEFINITELY">
            <Animations>
                <AlphaAnimation duration="500" startAlpha="1" endAlpha="0.5">
                    <EasingFunction>
                        return ZO_EaseOutQuadratic(progress)
                    </EasingFunction>
                </AlphaAnimation>
            </Animations>
        </AnimationTimeline>
    </Animations>
    <Controls>
        <TopLevelControl name="TemperCharactersPithka_GUI" mouseEnabled="true" movable="true" clampedToScreen="true" tier="LOW" hidden="true">
            <Dimensions x="550" y="665" />
            <Anchor point="CENTER" />
            <Controls>
                <Backdrop name="$(parent)FrameSurface" />

                <Control name="$(parent)NavPanel">
                    <Anchor point="TOPRIGHT" relativeTo="$(parent)" relativePoint="TOPLEFT" offsetX="-12" offsetY="0" />
                    <Dimensions x="50" y="180" />
                    <Controls>
                        <Backdrop name="$(parent)BG" mouseEnabled="false" tier="LOW">
                            <AnchorFill />
                        </Backdrop>
                    </Controls>
                </Control>

                <Control name="$(parent)QRContainer">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)" relativePoint="TOPRIGHT" offsetX="6" offsetY="-8" />
                    <Anchor point="BOTTOMLEFT" relativeTo="$(parent)" relativePoint="BOTTOMRIGHT" offsetX="6" offsetY="7" />
                    <Dimensions x="450" y="0" />
                    <Controls>
                        <Backdrop name="$(parent)BG" mouseEnabled="false" tier="LOW">
                            <Anchor point="TOPLEFT" />
                            <Anchor point="BOTTOMRIGHT" />
                        </Backdrop>
                    </Controls>
                </Control>
            </Controls>
        </TopLevelControl>
    </Controls>
</GuiXml>
