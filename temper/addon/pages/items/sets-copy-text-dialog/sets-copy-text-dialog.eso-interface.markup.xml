<GuiXml>
    <Controls>
        <TopLevelControl name="TemperItemsCraftingSetsCopyTextDialog" hidden="true" mouseEnabled="true" movable="true" clampedToScreen="true" tier="HIGH">
            <Dimensions x="800" y="560" />
            <Anchor point="CENTER" relativeTo="GuiRoot" relativePoint="CENTER" />
            <OnInitialized>
                TemperItemsCraftingSets_CopyDialog_OnInitialized(self)
            </OnInitialized>
            <OnHide>
                TemperItemsCraftingSets.CopyDialog:OnHide()
            </OnHide>
            <Controls>
                <Backdrop name="$(parent)Note">
                    <Controls>
                        <EditBox name="$(parent)Edit" maxInputCharacters="20000" inherits="ZO_DefaultEditMultiLineForBackdrop ZO_EditDefaultText">
                            <OnEffectivelyShown>
                                self:TakeFocus()
                            </OnEffectivelyShown>
                        </EditBox>
                    </Controls>
                </Backdrop>
                <Button name="$(parent)Next" inherits="ZO_DefaultButton" text="SI_LORE_READER_NEXT_PAGE">
                    <DimensionConstraints minX="200" minY="32" maxX="200" maxY="32" />
                    <OnClicked>
                        TemperItemsCraftingSets.CopyDialog:NextPage()
                    </OnClicked>
                </Button>
                <Button name="$(parent)Prev" inherits="ZO_DefaultButton" text="SI_LORE_READER_PREVIOUS_PAGE">
                    <DimensionConstraints minX="200" minY="32" maxX="200" maxY="32" />
                    <Anchor point="TOPRIGHT" relativePoint="TOPLEFT" relativeTo="$(parent)Next" offsetX="-12" offsetY="0"/>
                    <OnClicked>
                        TemperItemsCraftingSets.CopyDialog:PreviousPage()
                    </OnClicked>
                </Button>
            </Controls>
        </TopLevelControl>
    </Controls>
</GuiXml>
