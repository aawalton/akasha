<Bindings>
  <Layer name="SI_KEYBINDINGS_LAYER_GENERAL">
    <Category name="SI_KEYBINDINGS_CATEGORY_TEMPERITEMS">
      <Action name="TEMPERINVENTORY_TOGGLE_SELL">
        <Down>TemperItems.ToggleHoveredItemSell()</Down>
      </Action>
      <Action name="TEMPERINVENTORY_TOGGLE_LOCK">
        <Down>TemperItems.ToggleHoveredItemLock()</Down>
      </Action>
      <Action name="TEMPERINVENTORY_TOGGLE_BROWSER">
        <Down>TemperItems.ToggleInventoryBrowser()</Down>
      </Action>
    </Category>
  </Layer>
</Bindings>
