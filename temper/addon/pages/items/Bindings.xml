<Bindings>
  <Layer name="SI_KEYBINDINGS_LAYER_GENERAL">
    <Category name="SI_KEYBINDINGS_CATEGORY_TEMPERITEMS">
      <Action name="TEMPERINVENTORY_TOGGLE_SELL">
        <Down>TemperItems.ToggleHoveredItemSell()</Down>
      </Action>
      <Action name="TEMPERINVENTORY_TOGGLE_LOCK">
        <Down>TemperItems.ToggleHoveredItemLock()</Down>
      </Action>
      <Action name="TEMPERINVENTORY_TOGGLE_BROWSER">
        <Down>TemperItems.ToggleInventoryBrowser()</Down>
      </Action>
    </Category>
    <Category name="SI_KEYBINDINGS_CATEGORY_USER_INTERFACE">
      <Action name="POTIONMAKER">
        <Down>SLASH_COMMANDS["/temperpotions"]()</Down>
      </Action>
    </Category>
  </Layer>
  <Layer name="SI_KEYBINDINGS_CATEGORY_GENERAL">
    <Category name="SI_KEYBINDINGS_CATEGORY_TEMPER_CRAFTING">
      <Action name="CRAFTSTORE_WINDOW">
        <Down>TemperItemsCrafting.ShowMain()</Down>
      </Action>
      <Action name="CRAFTSTORE_STYLES">
        <Down>TemperItemsCrafting.SetAllStyles()</Down>
      </Action>
      <Action name="CRAFTSTORE_RUNES">
        <Down>TemperItemsCrafting.RuneView(1)</Down>
      </Action>
      <Action name="CRAFTSTORE_PROVISIONING">
        <Down>TemperItemsCrafting.ControlShow(TemperItemsCrafting_Recipe_Window);TemperItemsCrafting.RecipeShowCategory(TemperItemsCrafting.Character.recipe)</Down>
      </Action>
      <Action name="CRAFTSTORE_FURNISHINGS">
        <Down>TemperItemsCrafting.ControlShow(TemperItemsCrafting_Blueprint_Window);TemperItemsCrafting.BlueprintShowCategory(TemperItemsCrafting.Character.furniture)</Down>
      </Action>
    </Category>
  </Layer>
  <Layer name="SI_KEYBINDINGS_LAYER_POTIONMAKER">
    <Category name="SI_KEYBINDINGS_CATEGORY_USER_INTERFACE">
      <Action name="POTIONMAKER_SEARCH" rebindable="true">
        <Down>return ZO_KeybindStrip_HandleKeybindDown(keybind)</Down>
      </Action>
      <Action name="POTIONMAKER_SEARCH_WRITS" rebindable="true">
        <Down>return ZO_KeybindStrip_HandleKeybindDown(keybind)</Down>
      </Action>
      <Action name="POTIONMAKER_SEARCH_FAVORITS" rebindable="true">
        <Down>return ZO_KeybindStrip_HandleKeybindDown(keybind)</Down>
      </Action>
    </Category>
  </Layer>
</Bindings>
