<GuiXml>
    <Controls>
        <Texture name="TemperItemsSalesHistoryLinkedIconTemplate"
            textureFile="TemperItems/image/unlinked_down.dds" hidden="true" mouseEnabled="true"
            virtual="true">
            <Anchor point="BOTTOMRIGHT" offsetX="-40" offsetY="10" />
            <Dimensions x="32" y="32" />
        </Texture>

        <Button name="TemperItemsSalesHistoryStatusWindowToggleButtonTemplate"
            mouseOverBlendMode="ADD" inherits="ZO_ButtonBehaviorClickSound" virtual="true">
            <Dimensions x="32" y="32" />
            <Anchor point="BOTTOMLEFT" offsetX="5" offsetY="10" />
            <Textures normal="TemperItems/image/status_window_toggle_up.dds"
                pressed="TemperItems/image/status_window_toggle_down.dds"
                mouseOver="TemperItems/image/status_window_toggle_over.dds" />
        </Button>

        <Control name="TemperItemsSalesHistoryStatusGuildRowTemplate" mouseEnabled="true"
            tier="MEDIUM" layer="CONTROLS" virtual="true">
            <Dimensions y="52" />

            <Controls>
                <Backdrop name="$(parent)Highlight">
                    <AnchorFill />
                </Backdrop>

                <Label name="$(parent)Label" font="TemperFontBody" wrapMode="ELLIPSIS">
                    <Dimensions y="24" />
                    <Anchor point="LEFT" offsetX="12" offsetY="-12" />
                    <Anchor point="RIGHT" offsetY="-12" />
                </Label>

                <Control name="$(parent)StatusBar">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Label" relativePoint="BOTTOMLEFT" />
                    <Anchor point="TOPRIGHT" relativeTo="$(parent)Label" relativePoint="BOTTOMRIGHT" />
                    <Dimensions y="20" />
                    <Controls>
                        <Control name="$(parent)BG" inherits="ZO_ArrowStatusBarBG" />
                        <Control name="$(parent)Segments">
                            <AnchorFill />
                        </Control>
                        <Control name="$(parent)Overlay" inherits="ZO_ArrowStatusBarOverlay" />
                    </Controls>
                </Control>
            </Controls>
        </Control>

        <Control name="TemperItemsSalesHistoryStatusCategoryRowTemplate"
            inherits="TemperItemsSalesHistoryStatusGuildRowTemplate" virtual="true">
            <Controls>
                <Button name="$(parent)MenuButton" mouseOverBlendMode="ADD"
                    inherits="ZO_ButtonBehaviorClickSound">
                    <Dimensions x="32" y="32" />
                    <Anchor point="TOPRIGHT" offsetY="-5" />
                    <Textures normal="EsoUI/Art/ChatWindow/chat_options_up.dds"
                        pressed="EsoUI/Art/ChatWindow/chat_options_down.dds"
                        mouseOver="EsoUI/Art/ChatWindow/chat_options_over.dds" />
                </Button>
            </Controls>
        </Control>

        <TopLevelControl name="TemperItemsSalesHistoryStatusWindow" hidden="true"
            mouseEnabled="true" clampedToScreen="true">
            <Dimensions x="540" y="440" />
            <Controls>
                <Backdrop name="$(parent)FrameSurface" />

                <Button name="$(parent)Options" mouseOverBlendMode="ADD"
                    inherits="ZO_ButtonBehaviorClickSound">
                    <Dimensions x="32" y="32" />
                    <Anchor point="TOPRIGHT" offsetX="-12" offsetY="7" />
                    <Textures normal="EsoUI/Art/ChatWindow/chat_options_up.dds"
                        pressed="EsoUI/Art/ChatWindow/chat_options_down.dds"
                        mouseOver="EsoUI/Art/ChatWindow/chat_options_over.dds" />
                </Button>

                <Control name="$(parent)GuildList" inherits="ZO_ScrollList">
                    <Dimensions x="250" />
                    <Anchor point="TOPLEFT" />
                    <Anchor point="BOTTOMLEFT" constrains="Y" />
                </Control>

                <Control name="$(parent)CategoryList" inherits="ZO_ScrollList">
                    <Dimensions x="250" />
                    <Anchor point="TOPLEFT" relativeTo="$(parent)GuildList" relativePoint="TOPRIGHT"
                        offsetX="4" />
                    <Anchor point="BOTTOMLEFT" relativeTo="$(parent)GuildList"
                        relativePoint="BOTTOMRIGHT" constrains="Y" />
                </Control>

                <Control name="$(parent)Status" tier="MEDIUM">
                    <Dimensions y="100" />
                    <Anchor point="BOTTOMLEFT" />
                    <Anchor point="BOTTOMRIGHT" relativeTo="$(parent)GuildList" />
                    <Controls>
                        <Texture name="$(parent)Icon"
                            textureFile="TemperItems/image/unlinked_down.dds" mouseEnabled="true">
                            <Anchor point="CENTER" offsetY="-10" />
                            <Dimensions x="64" y="64" />
                        </Texture>
                    </Controls>
                </Control>

                <Control name="$(parent)SelectionWidget">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)GuildList" relativePoint="TOPRIGHT"
                        offsetX="-2" offsetY="12" />
                </Control>

            </Controls>
        </TopLevelControl>

        <Control name="TemperItemsSalesHistoryStatusBarTemplate" virtual="true">
            <Controls>
                <Texture name="$(parent)Bg"
                    textureFile="EsoUI/Art/Miscellaneous/listItem_backdrop.dds">
                    <AnchorFill />
                    <TextureCoords left="0" right="1" top="0" bottom=".8125" />
                </Texture>

                <Texture name="$(parent)Highlight"
                    textureFile="EsoUI/Art/Miscellaneous/listItem_highlight.dds" alpha="0">
                    <AnchorFill />
                    <TextureCoords left="0" right="1" top="0" bottom=".625" />
                </Texture>

                <Control name="$(parent)StatusBar">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Label" relativePoint="BOTTOMLEFT" />
                    <Anchor point="TOPRIGHT" relativeTo="$(parent)Label" relativePoint="BOTTOMRIGHT" />
                    <Dimensions y="20" />
                    <Controls>
                        <Control name="$(parent)BG" inherits="ZO_ArrowStatusBarBG" />
                        <Control name="$(parent)Segments">
                            <AnchorFill />
                        </Control>
                        <Control name="$(parent)Overlay" inherits="ZO_ArrowStatusBarOverlay" />
                    </Controls>
                </Control>
            </Controls>
        </Control>

        <Control name="TemperItemsSalesHistory_GapRow_Shared" virtual="true" mouseEnabled="true">
            <Controls>
                <Texture name="$(parent)Bg"
                    textureFile="EsoUI/Art/Miscellaneous/listItem_backdrop.dds">
                    <AnchorFill />
                    <TextureCoords left="0" right="1" top="0" bottom=".8125" />
                </Texture>

                <Label name="$(parent)Label" text="Missing data needs to be loaded"
                    font="ZoFontHeader">
                    <Anchor point="CENTER" />
                </Label>
            </Controls>
        </Control>

        <Control name="TemperItemsSalesHistory_DisabledGapRow_Shared"
            inherits="TemperItemsSalesHistory_GapRow_Shared" virtual="true">
            <Controls>
                <Label name="$(parent)Label" override="true"
                    text="Guild history was disabled by ZOS. Missing data is currently unavailable"
                    font="ZoFontHeader"
                    color="INTERFACE_COLOR_TYPE_GENERAL:INTERFACE_GENERAL_COLOR_ERROR" />
            </Controls>
        </Control>

        <Control name="TemperItemsSalesHistory_GapRow_Keyboard"
            inherits="TemperItemsSalesHistory_GapRow_Shared" virtual="true">
            <Dimensions y="ZO_GUILD_HISTORY_KEYBOARD_ROW_HEIGHT" />
        </Control>

        <Control name="TemperItemsSalesHistory_GapRow_Gamepad"
            inherits="TemperItemsSalesHistory_GapRow_Shared" virtual="true">
            <Dimensions y="ZO_GUILD_HISTORY_GAMEPAD_ROW_HEIGHT" />
            <Controls>
                <Label name="$(parent)Label" override="true" font="ZoFontGamepadCondensed34" />
            </Controls>
        </Control>

        <Control name="TemperItemsSalesHistory_DisabledGapRow_Keyboard"
            inherits="TemperItemsSalesHistory_DisabledGapRow_Shared" virtual="true">
            <Dimensions y="ZO_GUILD_HISTORY_KEYBOARD_ROW_HEIGHT" />
        </Control>

        <Control name="TemperItemsSalesHistory_DisabledGapRow_Gamepad"
            inherits="TemperItemsSalesHistory_DisabledGapRow_Shared" virtual="true">
            <Dimensions y="ZO_GUILD_HISTORY_GAMEPAD_ROW_HEIGHT" />
            <Controls>
                <Label name="$(parent)Label" override="true" font="ZoFontGamepadCondensed34" />
            </Controls>
        </Control>
    </Controls>
</GuiXml>