<GuiXml>
  <Controls>
    <TopLevelControl name="TemperItemsCrafting_Style_Window" clampedToScreen="true" mouseEnabled="true" movable="true" hidden="true">
      <OnMouseUp>TemperItemsCrafting.SaveCoords(self,"style")</OnMouseUp>
      <Dimensions x="770" y="661" />
      <Controls>
        <Backdrop name="$(parent)FrameSurface" />
        <Control name="TemperItemsCrafting_Style">
          <Dimensions x="750" y="641"/>
          <Controls>
            <Backdrop name="$(parent)TopSection" centerColor="101010" edgeColor="202020">
              <Anchor point="3" relativePoint="3" relativeTo="TemperItemsCrafting_Style"/>
              <Dimensions x="750" y="40"/>
              <Edge edgeSize="1"/>
            </Backdrop>
            <Button name="$(parent)HideButton" clickSound="Click" horizontalAlignment="0" verticalAlignment="1" font="TemperItemsCraftingFont">
              <FontColors normalColor="E8DFAF"/>
              <Anchor point="LEFT" relativePoint="LEFT" offsetY="-10" offsetX="10" relativeTo="$(parent)TopSection"/>
              <Dimensions y="22" x="200"/>
              <OnClicked>TemperItemsCrafting.HideStyles()</OnClicked>
            </Button>
            <Button name="$(parent)HideCrownButton" clickSound="Click" horizontalAlignment="0" verticalAlignment="1" font="TemperItemsCraftingFont">
              <FontColors normalColor="E8DFAF"/>
              <Anchor point="LEFT" relativePoint="LEFT" offsetY="-10" offsetX="220" relativeTo="$(parent)TopSection"/>
              <Dimensions y="22" x="200"/>
              <OnClicked>TemperItemsCrafting.HideCrownStyles()</OnClicked>
            </Button>
            <Button name="$(parent)HidePerfectedButton" clickSound="Click" horizontalAlignment="0" verticalAlignment="1" font="TemperItemsCraftingFont">
              <FontColors normalColor="E8DFAF"/>
              <Anchor point="LEFT" relativePoint="LEFT" offsetY="10" offsetX="10" relativeTo="$(parent)TopSection"/>
              <Dimensions y="22" x="200"/>
              <OnClicked>TemperItemsCrafting.HidePerfectedStyles()</OnClicked>
            </Button>
            <Button name="$(parent)HideUnknownButton" clickSound="Click" horizontalAlignment="0" verticalAlignment="1" font="TemperItemsCraftingFont">
              <FontColors normalColor="E8DFAF"/>
              <Anchor point="LEFT" relativePoint="LEFT" offsetY="10" offsetX="220" relativeTo="$(parent)TopSection"/>
              <Dimensions y="22" x="200"/>
              <OnClicked>TemperItemsCrafting.HideUnknownStyles()</OnClicked>
            </Button>
            <Control name="$(parent)PreviewType">
              <Dimensions x="150" y="20" />
              <Anchor point="RIGHT" relativePoint="RIGHT" offsetX="-10" relativeTo="$(parent)TopSection"/>
              <OnInitialized>
                self.name = self:GetNamedChild("Name")
                self.dropdown = ZO_ComboBox_ObjectFromContainer(self:GetNamedChild("Dropdown"))
              </OnInitialized>
              <Controls>
                <Control name="$(parent)Dropdown" inherits="ZO_ComboBox">
                  <Dimensions x="150"/>
                  <Anchor point="LEFT"/>
                </Control>
              </Controls>
            </Control>
            <Backdrop name="$(parent)Panel" tier="1" centerColor="101010" edgeColor="202020" inherits="ZO_ScrollContainerBase">
              <Anchor point="1" relativePoint="4" relativeTo="$(parent)TopSection" offsetY="1"/>
              <Dimensions x="750" y="600"/>
              <Edge edgeSize="1"/>
              <OnInitialized>ZO_Scroll_Initialize(self)</OnInitialized>
              <Controls>
                <Control name="$(parent)ScrollChild" resizeToFitDescendents="true">
                  <OnInitialized>self:SetParent(self:GetParent():GetNamedChild("Scroll"));self:SetAnchor(3,nil,3,0,0)</OnInitialized>
                  <Controls>
                    <Control name="$(parent)Styles" hidden="true">
                      <Anchor point="3" relativePoint="3" relativeTo="$(parent)"/>
                    </Control>
                    <Control name="$(parent)Sets" hidden="true">
                      <Anchor point="3" relativePoint="3" relativeTo="$(parent)"/>
                    </Control>
                  </Controls>
                </Control>
              </Controls>
            </Backdrop>
          </Controls>
        </Control>
      </Controls>
    </TopLevelControl>
  </Controls>
</GuiXml>
