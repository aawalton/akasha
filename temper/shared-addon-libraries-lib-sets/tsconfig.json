{
  "extends": "../addons/tsconfig.base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "rootDir": "../..",
    "outDir": "../addons/dist/LibSets",
    "target": "ESNext",
    "strict": true,
    "types": []
  },
  "tstl": {
    "luaTarget": "5.1",
    "luaBundle": "LibSets.lua",
    "luaBundleEntry": "./src/main.ts",
    "luaLibImport": "require-minimal",
    "noImplicitSelf": true
  },
  "include": [
    "src/**/*.ts",
    "../../akasha/temper/temper-eso-types/**/*.d.ts"
  ],
  "exclude": [
    "src/**/*.test.ts"
  ],
  "references": []
}
