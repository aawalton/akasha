{
  "extends": "../addons/tsconfig.base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "rootDir": "../..",
    "outDir": "../addons/dist/LibMapData",
    "target": "ESNext",
    "strict": true,
    "types": []
  },
  "tstl": {
    "luaTarget": "5.1",
    "luaBundle": "LibMapData.lua",
    "luaBundleEntry": "./src/main.ts",
    "luaLibImport": "require-minimal",
    "noImplicitSelf": true
  },
  "include": [
    "src/**/*.ts",
    "../addons/types/eso/**/*.d.ts",
    "../addons/types/libs/lib-gps.d.ts",
    "../addons/types/libs/lib-debug-logger.d.ts"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "scripts/**/*.ts"
  ],
  "references": [
    {
      "path": "../shared-foundation-misc-eso-paths-resolve"
    }
  ]
}
