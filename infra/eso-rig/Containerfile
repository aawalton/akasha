# Headless GPU "ESO rig" SUBSTRATE image — a real X server, a virtual input
# device, and Wine, so a Windows GUI client can run and be DRIVEN on a cluster
# GPU node with no display, no keyboard, and no human. Origin: #15808.
#
# WHY THIS BASE (a plain distro, NOT an nvidia/cuda image): the Talos
# nvidia-container-toolkit extension injects the ENTIRE NVIDIA driver userspace
# into the container at runtime, under /usr/local/glibc/usr/lib/ (verified on
# node-06). Driver userspace must match the running kernel driver exactly, so an
# image that ALSO shipped NVIDIA libs would put a second, mismatched copy on the
# loader path — the failure mode is a silent fall back to software rendering,
# which no screenshot can distinguish from the real thing. The only correct
# image is one that ships NONE of it. ubuntu:24.04 carries the whole Xorg + Wine
# stack in its own archive, so nothing else has to be fetched.
#
# WHY XORG AND NOT XVFB — this is the finding that reshaped the design. Xvfb has
# no evdev/libinput input backend: it accepts XTEST only, and can neither open
# nor consume a /dev/input/event* node. A uinput device — the one way to feed a
# Windows client synthetic input that is indistinguishable from hardware — can
# therefore NEVER reach an Xvfb server. Xorg with xserver-xorg-video-dummy for
# the framebuffer and xserver-xorg-input-evdev for input is the only combination
# in this family that consumes a uinput device. Do not "simplify" this to Xvfb.
#
# Build: via cluster BuildKit -> in-cluster registry (see
# bin/eso-rig-cluster-publish.sh).
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# Version discipline: THE BASE TAG IS THE PIN. Every package below comes from
# the `noble` release pocket that `ubuntu:24.04` fixes, so pinning each
# package's version separately would make the build LESS reproducible, not more
# — noble-updates supersedes a version and the archive drops the superseded one,
# so a pinned base-pocket build breaks on a security update. This follows the
# repo precedent (infra/k8s/src/postgres-cnpg/build-cnpg/Dockerfile pins its
# third-party-repo packages via an ARG and never its base-pocket ones): a pin
# is required where the version is a real choice — a pip wheel, a third-party
# repo — and not where the base tag already fixes it.
#
# What each package is here for — none is decoration:
#   xserver-xorg-core          the X server itself (also brings xkb-data, and
#                              gtf, which generates the dummy driver's modeline)
#   xserver-xorg-video-dummy   framebuffer with no hardware behind it
#   xserver-xorg-input-evdev   the input driver that opens a /dev/input/event*
#                              node — the whole reason this is Xorg, not Xvfb
#   x11-utils                  xdpyinfo (server-up probe) and xev, the input
#                              RECEIVER the self-test reads its assertions from
#   x11-xserver-utils          xsetroot — paints a known solid root so a blank
#                              frame is distinguishable from a rendered one
#   xdotool                    XTEST injection: the self-test's POSITIVE CONTROL
#   python3-evdev              creates the uinput device (the real input path)
#   wine                       the Windows PE runtime under test
#   vulkan-tools, mesa-utils   vulkaninfo / glxinfo — the GPU-vs-software
#                              discriminators. A frame rendered by llvmpipe is
#                              pixel-identical to one rendered by the GPU, so
#                              these strings are the ONLY way to tell them apart
#   x11-apps                   xwd — the only screenshot tool in this family
RUN apt-get update && apt-get install --no-install-recommends -y \
    xserver-xorg-core \
    xserver-xorg-video-dummy \
    xserver-xorg-input-evdev \
    x11-utils \
    x11-xserver-utils \
    xdotool \
    python3-evdev \
    wine \
    vulkan-tools \
    mesa-utils \
    x11-apps \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Upstream, the toolkit injects driver userspace per REQUESTED CAPABILITY, and
# the default compute,utility set carries libcuda and nvidia-smi but NOT the GLX,
# EGL, or Vulkan ICD pieces — so `graphics` would be what makes the render path
# reachable at all.
#
# MEASURED ON THIS CLUSTER, THIS VALUE CHANGES NOTHING: the Talos
# nvidia-container-toolkit extension mounts the whole userspace at
# /usr/local/glibc/usr/lib/ regardless. Probing node-06 with compute,utility and
# with all injected an IDENTICAL library set, GLX/EGL/Vulkan included. It is set
# explicitly anyway, because that permissiveness is an accident of how the
# extension mounts rather than a contract it publishes, and a future extension
# bump that starts honouring the variable must not silently take the render path
# away. Do not read this line as the thing that gates injection here.
# NVIDIA_VISIBLE_DEVICES is deliberately NOT set:
# device selection belongs to the k8s device plugin via the pod's GPU request,
# and an image-level `all` would hand every card to a legacy-mode runtime.
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility,graphics,display

# GLVND asks the X SERVER which GLX vendor to use, and a dummy server can only
# answer "Mesa" — so without this, every GL context in the rig, the game's
# included, lands on llvmpipe with a healthy card sitting idle beside it.
# Measured ON THE RIG NODE (node-06, RTX 3080 Ti): unset gives GL_RENDERER
# "llvmpipe", set gives "NVIDIA GeForce RTX 3080 Ti/PCIe/SSE2". First observed on
# a workstation RTX 5080 and re-measured here, because a driver-stack claim taken
# on a different card, driver and injection mechanism is not evidence about this
# node. This is for the WORKLOAD; the
# self-test sets it again on its own probe so its measurement does not depend on
# an env var it cannot see. Vulkan needs no equivalent — it finds the card
# through the ICD, which is why the GPU claim leads with vulkaninfo.
ENV __GLX_VENDOR_LIBRARY_NAME=nvidia

# A fresh WINEPREFIX otherwise opens a MODAL "install wine-mono / wine-gecko?"
# dialog on first run. In a headless container nothing can dismiss it, so the
# app under test never reaches the point of drawing a window and the rig hangs
# instead of failing. Empty overrides disable both components outright.
ENV WINEPREFIX=/root/.wine
ENV WINEDLLOVERRIDES="mscoree,mshtml="
ENV WINEDEBUG=-all

COPY src/entrypoint.sh /opt/eso-rig/entrypoint.sh
COPY src/rig-probe.py /opt/eso-rig/rig-probe.py

# Build-time smoke: prove the pieces the rig cannot start without are actually
# on disk under THIS package set. A dropped file or a renamed module surfaces
# here as a failed layer instead of as an opaque runtime failure on a GPU node.
# The GPU itself is unprovable at build time — the BuildKit builder has no card
# and no injected driver — so every GPU claim is deferred to `--self-test`.
RUN set -eu; \
    test -f /usr/lib/xorg/modules/drivers/dummy_drv.so; \
    test -f /usr/lib/xorg/modules/input/evdev_drv.so; \
    test -f /usr/lib/x86_64-linux-gnu/wine/x86_64-windows/notepad.exe; \
    python3 -c "from evdev import UInput, ecodes; print('evdev uinput ok')"; \
    for bin in Xorg gtf xev xdpyinfo xsetroot xwd xdotool vulkaninfo glxinfo wine; do \
        command -v "$bin" >/dev/null || { echo "missing binary: $bin" >&2; exit 1; }; \
    done

# Invoked through bash rather than relying on the copied file's mode, matching
# the house precedent (voice-infer's `CMD ["python", "/app/server.py"]`).
ENTRYPOINT ["/bin/bash", "/opt/eso-rig/entrypoint.sh"]
