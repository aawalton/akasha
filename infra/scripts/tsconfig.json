{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declarationDir": "dist",
    "types": [
      "@types/bun"
    ],
    "rootDir": "../..",
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/**/*.ts",
    "../../page/**/*.ts",
    "../../repo/**/*.ts",
    "../../tools/lib/code-import.ts",
    "../../tools/lib/code-root.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ],
  "references": [
    {
      "path": "../../shared/pages-query"
    },
    {
      "path": "../../shared/utils-narrow"
    },
    {
      "path": "../../shared/workspace-paths"
    },
    {
      "path": "../k8s"
    }
  ]
}
