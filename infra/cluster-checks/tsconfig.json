{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declarationDir": "dist",
    "rootDir": "../..",
    "types": [
      "@types/bun"
    ]
  },
  "references": [
    {
      "path": "../k8s"
    },
    {
      "path": "../k8s-types"
    },
    {
      "path": "../scripts"
    }
  ],
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "./**/*.test.ts"
  ]
}
