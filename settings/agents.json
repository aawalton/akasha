{
  "env": {
    "BASH_ENV": "$HOME/repos/akasha/tools/bash-env.sh",
    "CLAUDE_CODE_THRIFTY_SONIC": "0",
    "DISABLE_AUTOUPDATER": "1",
    "ENABLE_TOOL_SEARCH": "true"
  },
  "permissions": {
    "allow": [],
    "deny": [
      "Grep",
      "Glob",
      "Bash(gh:*)",
      "EnterPlanMode",
      "ExitPlanMode",
      "EnterWorktree",
      "ExitWorktree",
      "AskUserQuestion",
      "PushNotification",
      "Workflow",
      "Artifact",
      "ReportFindings",
      "Skill",
      "Agent(claude)",
      "Agent(Plan)",
      "Agent(statusline-setup)",
      "Agent(claude-code-guide)",
      "Agent(isolation:worktree)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.bun/bin/bun $HOME/repos/akasha/tools/hooks/agent-hook-block-addon-direct-install.agent-hook.code.attachment.ts",
            "timeout": 1
          },
          {
            "type": "command",
            "command": "$HOME/.bun/bin/bun $HOME/repos/akasha/tools/hooks/agent-hook-block-root-filesystem-scan.agent-hook.code.attachment.ts",
            "timeout": 1
          },
          {
            "type": "command",
            "command": "$HOME/.bun/bin/bun $HOME/repos/akasha/tools/hooks/block-whole-suite-run.ts",
            "timeout": 1
          },
          {
            "type": "command",
            "command": "$HOME/.bun/bin/bun $HOME/repos/akasha/tools/hooks/agent-hook-block-destructive-git.agent-hook.code.attachment.ts",
            "timeout": 1
          },
          {
            "type": "command",
            "command": "$HOME/.bun/bin/bun $HOME/repos/akasha/tools/hooks/agent-hook-block-substituting-backtick.agent-hook.code.attachment.ts",
            "timeout": 1
          },
          {
            "type": "command",
            "command": "$HOME/.bun/bin/bun $HOME/repos/akasha/tools/hooks/agent-hook-name-subagent.agent-hook.code.attachment.ts",
            "timeout": 1
          },
          {
            "type": "command",
            "command": "$HOME/.bun/bin/bun $HOME/repos/akasha/tools/hooks/agent-hook-require-ops-help.agent-hook.code.attachment.ts",
            "timeout": 1
          }
        ]
      },
      {
        "matcher": "mcp__playwright__.*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.bun/bin/bun $HOME/repos/akasha/tools/hooks/agent-hook-block-playwright-stray-filename.agent-hook.code.attachment.ts",
            "timeout": 1
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.bun/bin/bun $HOME/repos/akasha/tools/hooks/agent-hook-record-read.agent-hook.code.attachment.ts",
            "timeout": 1
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.bun/bin/bun $HOME/repos/akasha/tools/hooks/agent-hook-record-ops-help.agent-hook.code.attachment.ts",
            "timeout": 1
          }
        ]
      },
      {
        "matcher": "TaskStop",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.bun/bin/bun $HOME/repos/akasha/tools/hooks/agent-hook-state-subagent.agent-hook.code.attachment.ts",
            "timeout": 15
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf '\\a'",
            "timeout": 1
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PermissionRequest\",\"decision\":{\"behavior\":\"allow\"}}}'",
            "timeout": 1
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.bun/bin/bun $HOME/repos/akasha/tools/hooks/agent-hook-local-agent-session-start.agent-hook.code.attachment.ts",
            "timeout": 1
          },
          {
            "type": "command",
            "command": "$HOME/.bun/bin/bun $HOME/repos/akasha/tools/hooks/agent-hook-record-epoch.agent-hook.code.attachment.ts",
            "timeout": 1
          },
          {
            "type": "command",
            "command": "$HOME/.bun/bin/bun $HOME/repos/akasha/tools/hooks/agent-hook-idle-on-session-start.agent-hook.code.attachment.ts",
            "timeout": 1
          },
          {
            "type": "command",
            "command": "$HOME/.bun/bin/bun $HOME/repos/akasha/tools/hooks/agent-hook-state-subagent.agent-hook.code.attachment.ts",
            "timeout": 15
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.bun/bin/bun $HOME/repos/akasha/tools/hooks/agent-hook-mark-compacting.agent-hook.code.attachment.ts",
            "timeout": 1
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.bun/bin/bun $HOME/repos/akasha/tools/hooks/agent-hook-end-compacting.agent-hook.code.attachment.ts",
            "timeout": 1
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.bun/bin/bun $HOME/repos/akasha/tools/hooks/agent-hook-clear-working-on-session-end.agent-hook.code.attachment.ts",
            "timeout": 1
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.bun/bin/bun $HOME/repos/akasha/tools/hooks/agent-hook-idle-on-stop-failure.agent-hook.code.attachment.ts",
            "timeout": 1
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.bun/bin/bun $HOME/repos/akasha/tools/hooks/agent-hook-state-subagent.agent-hook.code.attachment.ts",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "$HOME/.bun/bin/bun $HOME/repos/akasha/tools/hooks/agent-hook-compose-subagent.agent-hook.code.attachment.ts",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.bun/bin/bun $HOME/repos/akasha/tools/hooks/agent-hook-state-subagent.agent-hook.code.attachment.ts",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.bun/bin/bun $HOME/repos/akasha/tools/hooks/agent-hook-stamp-turn-start.agent-hook.code.attachment.ts",
            "timeout": 1
          },
          {
            "type": "command",
            "command": "$HOME/.bun/bin/bun $HOME/repos/akasha/tools/hooks/state-errand.ts",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/.bun/bin/bun $HOME/repos/akasha/tools/hooks/agent-hook-persona-last-messaged-hook.agent-hook.code.attachment.ts",
            "timeout": 1
          },
          {
            "type": "command",
            "command": "$HOME/.bun/bin/bun $HOME/repos/akasha/tools/hooks/agent-hook-rc-session-title-hook.agent-hook.code.attachment.ts",
            "timeout": 1
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.bun/bin/bun $HOME/repos/akasha/tools/hooks/inference-hook-block-headless-halt.inference-hook.code.attachment.ts",
            "timeout": 25
          },
          {
            "type": "command",
            "command": "$HOME/.bun/bin/bun $HOME/repos/akasha/tools/hooks/inference-hook-block-interactive-stall.inference-hook.code.attachment.ts",
            "timeout": 25
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash $HOME/repos/akasha/tools/statusline.sh"
  },
  "fastMode": false,
  "skipDangerousModePermissionPrompt": true,
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": false,
  "promptSuggestionEnabled": false,
  "spinnerTipsEnabled": false
}
