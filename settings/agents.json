{
  "env": {
    "BASH_ENV": "$HOME/repos/akasha/tools/bash-env.sh",
    "CLAUDE_CODE_THRIFTY_SONIC": "0",
    "DISABLE_AUTOUPDATER": "1",
    "ENABLE_TOOL_SEARCH": "true"
  },
  "permissions": {
    "allow": [],
    "deny": [
      "Bash(gh:*)",
      "EnterPlanMode",
      "ExitPlanMode",
      "EnterWorktree",
      "ExitWorktree",
      "AskUserQuestion",
      "PushNotification",
      "Workflow",
      "Artifact",
      "ReportFindings",
      "Skill",
      "Agent(claude)",
      "Agent(Plan)",
      "Agent(statusline-setup)",
      "Agent(claude-code-guide)",
      "Agent(isolation:worktree)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.bun/bin/bun $HOME/repos/akasha/tools/hooks/block-ops-cli.ts",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash $HOME/repos/akasha/akasha/code-system/shell-script/shell-scripts/statusline.shell-script.shell.sh"
  },
  "fastMode": false,
  "skipDangerousModePermissionPrompt": true,
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": false,
  "promptSuggestionEnabled": false,
  "spinnerTipsEnabled": false
}
