  },
  "peerDependencies": {
    "vscode": "^1.85.0"
  },
  "peerDependenciesMeta": {
    "vscode": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.7",
    "@types/bun": "1.3.14",
    "@types/jsdom": "^28.0.0",
    "@types/pg": "^8.11.10",

    "fast-check": "^4.5.3",
    "typescript": "5.9.3",
    "typescript-7": "npm:typescript@7.1.0-dev.20260904.1",
    "@react-router/dev": "7.15.1",
    "@tailwindcss/vite": "^4.1.9",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19"
  },
  "scripts": {
    "typecheck": "./node_modules/typescript-7/bin/tsc -b",
    "clean:stale-folders": "bun alan/harness/workspace-paths/stale-folders/stale-folders.module.code.ts"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "esbuild",
    "protobufjs",
    "sharp"
  ],
  "overrides": {
    "tmp": "^0.2.5",
    "minimatch": "^9.0.9",
    "@types/react": "^19.2.14"
  }
}
