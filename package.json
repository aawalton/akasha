{
  "name": "akasha",
  "displayName": "Akasha",
  "description": "the panels and commands this repository gives the editor",
  "publisher": "vscode",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "vscode": "^1.85.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./code-system/editor/extension/ops-extension/extension-entry/extension-entry.module.code.ts",
  "workspaces": [
    "**"
  ],
  "exports": {
    "./*": "./*"
  },
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        { "id": "opsAgents", "title": "Agents", "icon": "$(organization)" },
        { "id": "opsDomains", "title": "Domains", "icon": "$(type-hierarchy)" },
        { "id": "opsWork", "title": "Work", "icon": "$(checklist)" },
        { "id": "opsPages", "title": "Page Types", "icon": "$(symbol-structure)" },
        { "id": "opsCommands", "title": "Commands", "icon": "$(terminal)" }
      ]
    },
    "views": {
      "opsAgents": [{ "id": "opsAgentTree", "name": "Agents" }],
      "opsDomains": [{ "id": "opsDomainTree", "name": "Domains" }],
      "opsWork": [{ "id": "opsWorkTree", "name": "Work" }],
      "opsPages": [{ "id": "opsPageTree", "name": "Page Types" }],
      "opsCommands": [{ "id": "opsCommandTree", "name": "Commands" }]
    },
    "commands": [
      { "command": "agentTerminalName.syncNow", "title": "Ops Terminal Rename: Sync Now" },
      { "command": "opsStatusBar.refreshNow", "title": "Ops Status Bar: Refresh Now" },
      { "command": "opsTranscript.open", "title": "Ops: Open Seat Transcript" },
      { "command": "opsAgentTree.refreshNow", "title": "Ops Agents: Refresh Now", "icon": "$(refresh)" },
      { "command": "opsDomainTree.refreshNow", "title": "Ops Domains: Refresh Now", "icon": "$(refresh)" },
      { "command": "opsWorkTree.refreshNow", "title": "Ops Work: Refresh Now", "icon": "$(refresh)" },
      { "command": "opsPageTree.refreshNow", "title": "Ops Page Types: Refresh Now", "icon": "$(refresh)" },
      { "command": "opsCommandTree.refreshNow", "title": "Ops Commands: Refresh Now", "icon": "$(refresh)" },
      { "command": "opsAgentTree.runStop", "category": "Ops Agents", "title": "Stop" },
      { "command": "opsAgentTree.runResume", "category": "Ops Agents", "title": "Resume" },
      { "command": "opsAgentTree.runReset", "category": "Ops Agents", "title": "Reset" },
      { "command": "opsAgentTree.copySeatName", "category": "Ops Agents", "title": "Copy Seat Name" },
      { "command": "opsAgentTree.openPage", "category": "Ops Agents", "title": "Open Page" },
      { "command": "opsAgentTree.enterInSeatTerminal", "category": "Ops Agents", "title": "Submit In Seat Terminal" },
      { "command": "opsWorkTree.deleteIntent", "category": "Ops Work", "title": "Delete" },
      { "command": "opsWorkTree.deleteInitiative", "category": "Ops Work", "title": "Delete" }
    ],
    "keybindings": [
      {
        "key": "enter",
        "command": "opsAgentTree.enterInSeatTerminal",
        "when": "terminalFocus && opsAgentTree.seatTerminalFocused"
      }
    ],
    "menus": {
      "view/title": [
        { "command": "opsAgentTree.refreshNow", "when": "view == opsAgentTree", "group": "navigation" },
        { "command": "opsDomainTree.refreshNow", "when": "view == opsDomainTree", "group": "navigation" },
        { "command": "opsWorkTree.refreshNow", "when": "view == opsWorkTree", "group": "navigation" },
        { "command": "opsPageTree.refreshNow", "when": "view == opsPageTree", "group": "navigation" },
        { "command": "opsCommandTree.refreshNow", "when": "view == opsCommandTree", "group": "navigation" }
      ],
      "view/item/context": [
        {
          "command": "opsAgentTree.runStop",
          "when": "view == opsAgentTree && viewItem =~ /^seat\\.running\\./",
          "group": "2_run@1"
        },
        {
          "command": "opsAgentTree.runResume",
          "when": "view == opsAgentTree && viewItem =~ /^seat\\.stopped\\./",
          "group": "2_run@1"
        },
        {
          "command": "opsAgentTree.runReset",
          "when": "view == opsAgentTree && viewItem =~ /^seat\\./",
          "group": "2_run@2"
        },
        {
          "command": "opsAgentTree.copySeatName",
          "when": "view == opsAgentTree && viewItem =~ /^seat\\./",
          "group": "6_copypath@1"
        },
        { "command": "opsAgentTree.openPage", "when": "view == opsAgentTree", "group": "0_open@1" },
        {
          "command": "opsWorkTree.deleteIntent",
          "when": "view == opsWorkTree && viewItem == intent",
          "group": "7_modification@1"
        },
        {
          "command": "opsWorkTree.deleteInitiative",
          "when": "view == opsWorkTree && viewItem == initiative",
          "group": "7_modification@1"
        }
      ],
      "editor/title/context/replace": [
        {
          "command": "opsAgentTree.runStop",
          "when": "resourceScheme == 'vscode-terminal' && resourceFilename in opsAgentTree.seatTabsRunning",
          "group": "2_run@1"
        },
        {
          "command": "opsAgentTree.runResume",
          "when": "resourceScheme == 'vscode-terminal' && resourceFilename in opsAgentTree.seatTabsStopped",
          "group": "2_run@1"
        },
        {
          "command": "opsAgentTree.runReset",
          "when": "resourceScheme == 'vscode-terminal' && resourceFilename in opsAgentTree.seatTabs",
          "group": "2_run@2"
        },
        {
          "command": "opsAgentTree.copySeatName",
          "when": "resourceScheme == 'vscode-terminal' && resourceFilename in opsAgentTree.seatTabs",
          "group": "6_copypath@1"
        }
      ]
    },
    "colors": [
      {
        "id": "ops.color.blue",
        "description": "The gemstone blue the design names, drawn on a row whose turn state names it.",
        "defaults": {
          "dark": "#2c5a9d",
          "light": "#2c5a9d",
          "highContrast": "#2c5a9d",
          "highContrastLight": "#2c5a9d"
        }
      },
      {
        "id": "ops.color.green",
        "description": "The gemstone green the design names, drawn on a row whose turn state names it.",
        "defaults": {
          "dark": "#2d8c57",
          "light": "#2d8c57",
          "highContrast": "#2d8c57",
          "highContrastLight": "#2d8c57"
        }
      },
      {
        "id": "ops.color.orange",
        "description": "The gemstone orange the design names, drawn on a row whose turn state names it.",
        "defaults": {
          "dark": "#be5a0a",
          "light": "#be5a0a",
          "highContrast": "#be5a0a",
          "highContrastLight": "#be5a0a"
        }
      },
      {
        "id": "ops.color.purple",
        "description": "The gemstone purple the design names, drawn on a row whose turn state names it.",
        "defaults": {
          "dark": "#7c4ca3",
          "light": "#7c4ca3",
          "highContrast": "#7c4ca3",
          "highContrastLight": "#7c4ca3"
        }
      },
      {
        "id": "ops.color.red",
        "description": "The gemstone red the design names, drawn on a row whose turn state names it.",
        "defaults": {
          "dark": "#a51c32",
          "light": "#a51c32",
          "highContrast": "#a51c32",
          "highContrastLight": "#a51c32"
        }
      },
      {
        "id": "ops.color.yellow",
        "description": "The gemstone yellow the design names, drawn on a row whose turn state names it.",
        "defaults": {
          "dark": "#b87b11",
          "light": "#b87b11",
          "highContrast": "#b87b11",
          "highContrastLight": "#b87b11"
        }
      }
    ]
  },
  "dependencies": {
    "akasha": "link:.",
    "@googleapis/calendar": "^15.0.0",
    "@googleapis/drive": "^20.2.0",
    "@googleapis/gmail": "^17.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@supabase/supabase-js": "^2.104.0",
    "@vscode/ripgrep": "^1.18.0",
    "cdk8s": "^2.70.60",
    "extract-zip": "^2.0.1",
    "fflate": "0.8.3",
    "jsdom": "^28.1.0",
    "onnxruntime-node": "1.29.0",
    "pg": "^8.13.0",
    "playwright-core": "1.61.1",
    "rrule": "^2.8.1",
    "yaml": "^2.8.1",
    "zod": "^4.3.6",
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^0.576.0",
    "react": "^18 || ^19",
    "@radix-ui/react-slot": "*",
    "react-dom": "^18 || ^19",
    "sonner": "^2.0.7",
    "@happy-dom/global-registrator": "^20.8.3",
    "@testing-library/react": "^16.3.2",
    "chess.js": "^1.4.0",
    "chessground": "^9.2.1",
    "chrono-node": "^2.9.0",
    "input-otp": "^1.5.0",
    "react-day-picker": "^9.13.0",
    "react-hook-form": "^7.71.0",
    "@tanstack/react-virtual": "^3.14.10",
    "@radix-ui/react-collapsible": "*",
    "ansi-to-html": "^0.7.2",
    "@dnd-kit/core": ">=6",
    "@dnd-kit/modifiers": ">=7",
    "@dnd-kit/sortable": ">=8",
    "@radix-ui/react-tabs": "*",
    "@supabase/ssr": "^0.10.2",
    "cookie": "^1.0.2",
    "react-router": ">=7",
    "enhanced-resolve": "5.8.2",
    "picomatch": "^2.3.1",
    "resolve": "^1.15.1",
    "source-map": "^0.7.3",
    "clsx": "^2.1.1",
    "cmdk": "1.0.4",
    "embla-carousel-react": "^8.6.0",
    "react-resizable-panels": "^4.4.0",
    "tailwind-merge": "^3.3.1",
    "vaul": "^1.1.2",
    "@radix-ui/react-accordion": "*",
    "@radix-ui/react-alert-dialog": "*",
    "@radix-ui/react-avatar": "*",
    "@radix-ui/react-checkbox": "*",
