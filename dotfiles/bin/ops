#!/usr/bin/env bash
#
# The `ops` name on PATH, resolving into the repository the dispatcher stands in.
#
# The dispatcher stands at `tools/ops/cli.ts`, so a change to what `ops` says or refuses is live
# on the commit that makes it, with no build and no deploy in between. This file is what makes
# that true for the name every agent types: it names that tree, rather than resolving into a
# checkout of the code repository the way a `node_modules/.bin` link did.

set -euo pipefail

dispatcher="${AKASHA_ROOT:-$HOME/repos/akasha}/tools/ops/cli.ts"

if [[ ! -f $dispatcher ]]; then
  echo "ops: no dispatcher at $dispatcher — set AKASHA_ROOT to an akasha checkout" >&2
  exit 70
fi

exec bun "$dispatcher" "$@"
