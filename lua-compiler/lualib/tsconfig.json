{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["esnext"],
    "types": [],
    "moduleResolution": "Node",
    "module": "esnext",
    "skipLibCheck": true,
    "rootDirs": ["src", "src/universal"],
    "strict": true
  },
  "tstl": {
    "luaLibImport": "none"
  },
  "include": ["src/*.ts", "src/*.d.ts", "src/universal/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
