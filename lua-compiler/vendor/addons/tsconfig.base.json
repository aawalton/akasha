{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "types": [],
    "jsx": "react",
    "noEmit": false,
    "isolatedModules": true
  },
  "tstl": {
    "luaTarget": "5.1",
    "luaLibImport": "require-minimal",
    "noResolvePaths": [],
    "noImplicitSelf": true,
    "luaPlugins": [
      {
        "name": "@temper/shared-build-deploy-tstl/src/plugins/tstl-no-truthy-numbers.js"
      },
      {
        "name": "@temper/shared-build-deploy-tstl/src/plugins/tstl-no-multi-store.js"
      }
    ]
  }
}
