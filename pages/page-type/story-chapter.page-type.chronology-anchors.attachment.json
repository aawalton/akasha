{
  "type": "array",
  "$defs": {
    "src": {
      "type": "object",
      "required": [
        "ch"
      ],
      "properties": {
        "ch": {
          "type": "string",
          "minLength": 1
        },
        "vol": {
          "type": "number"
        },
        "beat": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "anchor": {
      "if": {
        "required": [
          "epi"
        ],
        "properties": {
          "epi": {
            "const": "claimed"
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "by"
          ]
        }
      },
      "type": "object",
      "required": [
        "kind",
        "tier",
        "lexeme",
        "reference",
        "epi",
        "src"
      ],
      "properties": {
        "by": {
          "type": "string",
          "minLength": 1
        },
        "epi": {
          "enum": [
            "asserted",
            "claimed"
          ]
        },
        "src": {
          "$ref": "#/$defs/src"
        },
        "kind": {
          "enum": [
            "absolute",
            "relative-offset",
            "duration",
            "simultaneity",
            "season-marker",
            "time-of-day"
          ]
        },
        "tier": {
          "enum": [
            "exact-date",
            "sub-day",
            "day-offset",
            "coarse-offset",
            "season-festival",
            "unanchored"
          ]
        },
        "lexeme": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "enum": [
            "before",
            "after",
            "simultaneous"
          ]
        },
        "reference": {
          "type": "string",
          "pattern": "^(?:chapter-start|prior-scene|absolute|named-event:[a-z0-9]+(?:-[a-z0-9]+)*)$"
        }
      },
      "additionalProperties": false
    }
  },
  "items": {
    "$ref": "#/$defs/anchor"
  }
}
