{
  "messages": {
    "type": "stdio",
    "command": "bun",
    "args": ["run", "$INSTRUCTIONS/agent/message/modules/mcp/agent-message-mcp.module.code.ts"],
    "secretEnv": ["MCP_API_KEY"]
  },
  "playwright": {
    "type": "stdio",
    "command": "env",
    "forwardEnv": ["PATH", "HOME"],
    "args": [
      "node",
      "$INSTRUCTIONS/node_modules/@playwright/mcp/cli.js",
      "--headless",
      "--browser=chromium",
      "--isolated",
      "--output-dir",
      "$HOME/.playwright-mcp"
    ]
  }
}
