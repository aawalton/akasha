{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["dom", "dom.iterable", "esnext"],
    "types": ["@types/bun", "node", "vite/client"],
    "rootDirs": [".", "./.react-router/types"],
    "paths": {
      "@/*": ["./*"]
    },
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declarationDir": "dist",
    "rootDir": "../.."
  },
  "include": [
    "*.ts",
    "*.tsx",
    "routes/**/*.ts",
    "routes/**/*.tsx",
    "*/*.stylesheet.ts",
    ".react-router/types/**/*.ts",
    ".react-router/types/**/*.tsx",
    ".react-router/types/**/+types/*.ts",
    "vite.config.ts",
    "react-router.config.ts"
  ],
  "exclude": ["node_modules", "dist", "build"]
}
