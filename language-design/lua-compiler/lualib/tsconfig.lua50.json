{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["esnext"],
    "types": [],
    "moduleResolution": "Node",
    "module": "esnext",
    "skipLibCheck": true,
    "rootDirs": ["src", "src/5.0"],
    "strict": true
  },
  "tstl": {
    "luaLibImport": "none",
    "luaTarget": "5.0"
  },
  "include": ["src/*.ts", "src/*.d.ts", "src/5.0/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "src/eso-sandbox.manifest.ts"]
}
