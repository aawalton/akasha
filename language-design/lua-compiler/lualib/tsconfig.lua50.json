{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["esnext"],
    "types": [],
    "moduleResolution": "Node",
    "module": "esnext",
    "skipLibCheck": true,
    "rootDirs": ["src", "src/5.0"],
    "strict": true
  },
  "luaCompiler": {
    "luaLibImport": "none",
    "luaTarget": "5.0"
  },
  "include": [
    "src/*.ts",
    "src/5.0/**/*.ts",
    "../lualibs/**/*.lualib.code.ts",
    "../lualibs/**/*.lualib.lua50-code.ts",
    "../eso-sandbox/eso-sandbox.type-declaration.d.ts",
    "../language-extensions/language-extensions.type-declaration.d.ts",
    "../performance-global/performance-global.type-declaration.d.ts",
    "../sparse-array/sparse-array.type-declaration.d.ts"
  ],
  "exclude": ["src/**/*.test.ts", "src/eso-sandbox.manifest.ts"]
}
