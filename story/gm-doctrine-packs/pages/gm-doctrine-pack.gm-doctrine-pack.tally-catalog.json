        },
        {
          "category": "perception",
          "regex": "\\byou\\s+(?:see|saw|hear|heard|feel|felt|know|knew|notice|noticed|watch|watched|sense|sensed|realized?|realised?|decide|decided|understand|understood|remember|remembered|smell|smelled|taste|tasted|find|found)\\b",
