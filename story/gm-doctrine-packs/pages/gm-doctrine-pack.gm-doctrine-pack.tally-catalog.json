        },
        {
          "category": "in-motion",
          "regex": "^\\s*(?:and|but|so|then|still|now|again|by the time|before|after)\\b",
          "flags": "i",
          "provenance": "opens mid-stream on a continuation connective (coarse — the banked-tail head)"
        },
        {
          "category": "action",
          "regex": "\\byou\\s+(?:go|going|went|climb|climbed|take|took|turn|turned|step|stepped|raise|raised|set|crouch|crouched|kneel|knelt|stand|stood|strike|struck|swing|swung|lift|lifted|pull|pulled|push|pushed|drop|dropped|cut|break|broke|give|gave|travel|travelled|sit|sat|throw|threw|reach|reached|walk|walked|run|ran|move|moved|do|does|did|make|made|unlash|lash|spend|spent|work)\\b",
          "flags": "i",
          "provenance": "you + physical-action verb (coarse screen)"
        }
      ],
      "fallback": "unclassified"
    },
    "close": {
      "screens": [
        {
          "category": "dialogue",
          "regex": "(?:\\[[^\\]]*\\]|[\"'”’])",
          "provenance": "close is a spoken line — speaker tag or quotation present (coarse)"
        },
        {
          "category": "poised",
          "regex": "\\b(?:not yet|whenever you|waiting|about to|on the threshold|yet to|still (?:ahead|to (?:come|climb|cross|do))|take your time|not going anywhere|whatever you (?:decide|choose|want)|for the moment)\\b[^.]*[.!?]?[\"'”’]?\\s*$",
          "flags": "i",
          "provenance": "held/expectant wait-state close — the POISED tell (coarse)"
        },
        {
          "category": "noticed",
          "regex": "\\byou\\s+(?:know|knew|see|saw|feel|felt|notice|noticed|realize|realized|hear|heard|understand|understood)\\b[^.]*[.!?]?\\s*$",
          "flags": "i",
          "provenance": "closes on a noticed detail / perception (coarse)"
        },
        {
          "category": "mid-motion",
          "regex": ",\\s+(?:the\\s+)?[^,.]*\\b\\w+ing\\b[^.]*[.!?]?[\"'”’]?\\s*$",
          "flags": "i",
          "provenance": "ends on a trailing participial phrase set off by a comma (coarse — the mid-motion tell; the loosest screen, awen to tune)"
        }
      ],
      "fallback": "unclassified"
    },
    "youInitial": {
      "regex": "^\\s*You\\b",
      "provenance": "same-word second-person opening; base rate ~68% in persistent-second-person — read RUNS, never raw rate (run-signal only, #15717)"
