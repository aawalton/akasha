# Page data held outside git deliberately. The first rule needs a suffix after
# `uncommitted`, and the second catches a file or a folder carrying none, so every
# path spelling `uncommitted` is held out rather than swept in by a bare `git add`.
*.uncommitted.*
*.uncommitted
*.lock/

# Agent runtime state. `pages/repo/akasha-repo.repo.md` holds that nothing under
# `.claude` is tracked here.
.claude/

# Installed dependencies and compiled output.
node_modules/
dist/
*.tsbuildinfo

# Route types `react-router typegen` writes beside each web tree. Seven trees
# carry one, and an unlanded one refuses `akasha index refresh` by standing
# apart from HEAD.
.react-router/


# Declarations tsc emits beside the .ts they came from. Hand-written
# declarations live under types/, carry the page suffix of a page whose file
# property they are, or sit in the trees named below, and none of those hold an
# emitted one. A rule here matches a path from the repository root, so a rule
# anchored on a folder the flatten dissolved matches nothing and drops every
# file that rule kept.
*.d.ts
!**/types/**/*.d.ts
!checks-system/**/*.d.ts
!**/lua-compiler/**/*.d.ts
!patches/**/*.d.ts
!temper/*-addon/**/*.d.ts
!**/*.type-declaration.d.ts
!**/*.code-editor-data-interface.d.ts

# Scratch an agent writes to land a migration and then abandons. Two reached
# commits before this rule existed, both inside akasha/, so the leak is real
# rather than hypothetical.
*.tmp.ts

# The scratch a web build is written into, and the previous build held aside for
# the moment between the two renames that swap it. A build that fails leaves the
# scratch behind, and the next build sweeps it.
**/build.next/
**/build.old/

# The config Capacitor reads, written at the root of whatever tree a build runs in
# because the CLI reads its config out of the folder it runs in and runs where the
# one manifest is. The authored config sits beside the app's page under the naming
# grammar, and this is what a build makes from it.
/capacitor.config.json

# Kubernetes manifests synthesized from their TypeScript source, and the folder a
# manifest page writes them into. `page/core/generated` is source rather than a
# build's output, so it is kept.
*.generated.yaml
generated/
!page/core/generated/

# Python bytecode.
__pycache__/
*.pyc

# Private keys.
*.key
