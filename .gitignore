# Page data held outside git deliberately. The second rule needs a suffix after
# `uncommitted`, so a folder named `<something>.uncommitted` slips past it and a bare
# `git add` sweeps its contents into whatever commit is being made.
*.uncommitted.*
*.uncommitted/
*.lock/

# Agent runtime state. `pages/repo/akasha-repo.repo.md` holds that nothing under
# `.claude` is tracked here.
.supervisors/
.claude/

# Installed dependencies and compiled output.
node_modules/
dist/
*.tsbuildinfo

# Route types `react-router typegen` writes beside each web tree. Seven trees
# carry one, and an unlanded one refuses `akasha index refresh` by standing
# apart from HEAD.
.react-router/


# Declarations tsc emits beside the .ts they came from. Hand-written
# declarations live under types/ or in the trees named below, and none of those
# hold an emitted one.
*.d.ts
!**/types/**/*.d.ts
!checks-system/**/*.d.ts
!lua-compiler/**/*.d.ts
!patches/**/*.d.ts
!temper/*-addon/**/*.d.ts
!akasha/**/*.d.ts

# Scratch an agent writes to land a migration and then abandons. Two reached
# commits before this rule existed, both inside akasha/, so the leak is real
# rather than hypothetical.
*.tmp.ts

# What vite leaves under a web tree. Three of the four web trees carry a .gitignore
# of their own naming it; web-capacitor carries none, so its 18 woff2 font files were
# untracked and unignored at once — invisible to an audit that judges what the index
# names, and carrying a NUL byte each the moment a `git add -A` brought them in.
akasha/alan/web-capacitor/build/

# Kubernetes manifests synthesized from their TypeScript source.
*.generated.yaml

# Python bytecode.
__pycache__/
*.pyc

# Private keys.
*.key
