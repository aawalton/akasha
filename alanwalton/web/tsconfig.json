{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "types": [
      "@types/bun",
      "node",
      "vite/client"
    ],
    "rootDirs": [
      ".",
      "./.react-router/types"
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "~/*": [
        "./app/*"
      ]
    },
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declarationDir": "dist",
    "rootDir": "../.."
  },
  "references": [
    {
      "path": "../../shared/day"
    },
    {
      "path": "../../collections/litrpg"
    },
    {
      "path": "../../infra/k8s-types"
    },
    {
      "path": "../../shared/design-patterns"
    },
    {
      "path": "../../shared/design-system"
    },
    {
      "path": "../../shared/errors-client"
    },
    {
      "path": "../../shared/errors-core"
    },
    {
      "path": "../../shared/open-questions"
    },
    {
      "path": "../../shared/notifications"
    },
    {
      "path": "../../shared/pages-ui"
    },
    {
      "path": "../../shared/recurrence"
    },
    {
      "path": "../../shared/status-bar-access"
    },
    {
      "path": "../../shared/supabase-auth"
    },
    {
      "path": "../../shared/supabase-database"
    },
    {
      "path": "../../shared/supabase-rr"
    },
    {
      "path": "../../shared/supabase-server"
    },
    {
      "path": "../../shared/utils-narrow"
    },
    {
      "path": "../../shared/utils-sync"
    },
    {
      "path": "../../shared/utils-test"
    },
    {
      "path": "../../shared/object-store"
    }
  ],
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "app-capacitor/**/*.ts",
    "app-capacitor/**/*.tsx",
    ".react-router/types/**/*.ts",
    ".react-router/types/**/*.tsx",
    ".react-router/types/**/+types/*.ts",
    "server.ts",
    "vite.config.ts",
    "react-router.config.ts",
    "*.cluster-service.code.attachment.ts",
    "foundation.workflow.ts",
    "apps.workflow.ts",
    "tunnel-routes.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "app-capacitor/build",
    "app-capacitor/.react-router"
  ]
}
